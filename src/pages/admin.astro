  // ponytail: clean HTML escape, safe URL guard, Vietnamese NFD slugifier, and direct Store usage
  function esc(str: any): string {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
