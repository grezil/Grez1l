    const u = String(url || '').trim();
    if (!u) return '';
    if (u.startsWith('https://') || u.startsWith('http://') || u.startsWith('/')) return u;
    return '';
  }

  function slugifyText(str: any): string {
    return String(str || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[đĐ]/g, 'd')
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_-]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  function setSelectValue(selectEl: HTMLSelectElement | null, value: string, fallback = '') {
    if (!selectEl) return;
    const v = String(value || fallback || '').trim();
    if (!v) return;
    const exists = Array.from(selectEl.options).some(opt => opt.value === v);
    if (!exists) {
      const opt = document.createElement('option');
      opt.value = v;
      opt.textContent = v;
      selectEl.appendChild(opt);
    }
    selectEl.value = v;
  }

  function setupAdminPage() {
    const authScreen = document.getElementById('admin-auth-screen');
    const dashScreen = document.getElementById('admin-dashboard-screen');
    if (!authScreen || !dashScreen) return;
    if (dashScreen.dataset.bound === '1') return;
    dashScreen.dataset.bound = '1';

    let staticBlogSlugs = new Set<string>();
    try {
      const rawSlugs = dashScreen.getAttribute('data-static-slugs');
      if (rawSlugs) staticBlogSlugs = new Set(JSON.parse(rawSlugs));
    } catch {}

    function getBlogHref(slug: string): string {
      const s = String(slug || '').trim();
      if (!s) return '/blog';
      return staticBlogSlugs.has(s) ? `/blog/${encodeURIComponent(s)}` : `/blog?post=${encodeURIComponent(s)}`;
    }

