    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const enteredUser = userInput?.value?.trim() || '';
      const enteredPass = passInput?.value?.trim() || '';
      const store = await getStore();

      let authResult: any = { success: false };
      if (store && typeof store.loginAdmin === 'function') {
        authResult = store.loginAdmin(enteredUser, enteredPass);
      } else {
        authResult = { success: enteredUser === 'admin' && enteredPass === 'NhatNguyen141' };
        if (authResult.success) {
