    const courseCode = document.getElementById('dash-course-code') as HTMLInputElement;
    const courseTitle = document.getElementById('dash-course-title') as HTMLInputElement;
    const courseSemester = document.getElementById('dash-course-semester') as HTMLInputElement;
    const courseInstitution = document.getElementById('dash-course-institution') as HTMLInputElement;
    const courseEmail = document.getElementById('dash-course-email') as HTMLInputElement;
    const courseGithub = document.getElementById('dash-course-github') as HTMLInputElement;
