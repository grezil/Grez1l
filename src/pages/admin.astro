---
// src/pages/admin.astro - Dedicated Apple-grade Space Admin Mission Control Center
import Layout from '../layouts/Layout.astro';
import portfolioData from '../data/portfolio.json';
import { DEFAULT_BLOGS } from '../data/defaultBlogs.js';

// ponytail: compute statically built blog slugs so runtime-published posts route via /blog?post=<slug>
const jsonBlogs = (portfolioData as any).blogs as any[] | undefined;
const initialBlogs = (jsonBlogs && Array.isArray(jsonBlogs) && jsonBlogs.length > 0)
  ? jsonBlogs
  : DEFAULT_BLOGS;
const staticBlogSlugs = initialBlogs.map((b: any) => b.slug).filter(Boolean);
---

<Layout title="Mission Control Center | Space Engineer Admin CMS">
  <div class="admin-page-root">
    <!-- ============================================== -->
    <!-- VIEW 1: AUTHENTICATION LOCK SCREEN             -->
    <!-- ============================================== -->
    <section id="admin-auth-screen" class="auth-screen-container">
      <div class="auth-glass-panel">
        <div class="auth-header">
          <div class="auth-icon-halo">
            <div class="auth-icon-pulse"></div>
            <div class="auth-icon-core">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
          </div>
          <span class="auth-telemetry-tag">ORBITAL SECURITY PROTOCOL // LEVEL-4 CLEARANCE</span>
          <h1 class="auth-heading">Mission Control Authorization</h1>
          <p class="auth-desc">
            Enter administrative passkey to unlock My CV content studio, upload awards with timeline, and publish flight mission logs.
          </p>
        </div>

        <form id="admin-page-login-form" class="auth-form" autocomplete="off">
          <div class="form-field">
            <label for="page-username-input" class="field-label">Tài khoản / Username</label>
            <div class="auth-input-wrapper">
              <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input
                type="text"
                id="page-username-input"
                class="auth-input"
                placeholder="Nhập tài khoản (admin)..."
                required
                autocomplete="username"
              />
            </div>
          </div>

          <div class="form-field">
            <div class="field-label-row">
              <label for="page-passkey-input" class="field-label">Mật khẩu / Security Password</label>
            </div>
            <div class="auth-input-wrapper">
              <svg class="auth-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5-2 2L12 6l-2 2 1.5 1.5L10 11l-1.5-1.5-2 2L8 13l-1.5-1.5-2 2L6 15l-1.5-1.5L3 15v6h6l1.5-1.5L9 18l1.5-1.5 2-2L14 16l1.5-1.5 2 2 1.5-1.5 2-2 2-2z"></path>
              </svg>
              <input
                type="password"
                id="page-passkey-input"
                class="auth-input"
                placeholder="Nhập mật khẩu..."
                required
                autocomplete="current-password"
              />
              <button type="button" id="page-toggle-pass" class="auth-eye-btn" aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
          </div>

          <div id="page-auth-feedback" class="auth-feedback" role="alert" style="display: none;">
            <span class="feedback-dot"></span>
            <span id="page-feedback-msg">Invalid passkey.</span>
          </div>

          <div class="auth-submit-row">
            <a href="/" class="btn-return-home">
              ← Return to Portfolio
            </a>
            <button type="submit" id="page-auth-submit" class="btn-unlock-deck">
              <span>Authenticate & Access</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </form>

        <div class="auth-security-footer">
          <span class="security-dot"></span>
          <span>SYSTEM READY • LOCAL ENCRYPTION ACTIVE • DUAL-REDUNDANT STORAGE</span>
        </div>
      </div>
    </section>

    <!-- ============================================== -->
    <!-- VIEW 2: AUTHENTICATED MISSION CONTROL DASHBOARD-->
    <!-- ============================================== -->
    <section id="admin-dashboard-screen" class="dashboard-container" data-static-slugs={JSON.stringify(staticBlogSlugs)} style="display: none;">
      <div class="dashboard-inner container">
        
        <!-- Top Mission Navigation Bar -->
        <header class="dash-topbar">
          <div class="dash-topbar-left">
            <div class="dash-user-badge">
              <span class="dash-user-avatar">NN</span>
              <div class="dash-user-meta">
                <div class="dash-user-name">
                  <span id="dash-user-display-name">Võ Quang Nhật Nguyên</span>
                  <span class="dash-pill-active">ADMIN ACTIVE</span>
                </div>
                <div class="dash-user-role">Space Systems & Flight Software Architect • Callsign: NHAT-NGUYEN</div>
              </div>
            </div>
          </div>

          <div class="dash-topbar-right">
            <a href="/" class="dash-action-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              </svg>
              <span>Live Site</span>
            </a>
            <a href="/cv" class="dash-action-link" target="_blank">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>My CV ↗</span>
            </a>
            <a href="/blog" class="dash-action-link" target="_blank">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <span>Blog ↗</span>
            </a>
            <button type="button" id="dash-logout-btn" class="dash-logout-btn" title="End Admin Session">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Lock / Exit</span>
            </button>
          </div>
        </header>

        <!-- Metric KPI Cards -->
        <div class="dash-metrics-grid">
          <!-- KPI 1 -->
          <div class="metric-glass-card">
            <div class="metric-top">
              <span class="metric-label">TECHNICAL ACHIEVEMENTS</span>
              <div class="metric-icon-box amber-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="7"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              </div>
            </div>
            <div class="metric-val" id="metric-ach-count">--</div>
            <div class="metric-bottom">
              <span class="metric-sub">NASA, AIAA & flight honors</span>
              <button type="button" class="metric-action-btn" data-dash-nav="dash-tab-achievements">+ Add Award</button>
            </div>
          </div>

          <!-- KPI 2 -->
          <div class="metric-glass-card">
            <div class="metric-top">
              <span class="metric-label">MISSION ARTICLES</span>
              <div class="metric-icon-box blue-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
              </div>
            </div>
            <div class="metric-val" id="metric-blog-count">--</div>
            <div class="metric-bottom">
              <span class="metric-sub">Published technical articles</span>
              <button type="button" class="metric-action-btn" data-dash-nav="dash-tab-blog">+ Compose</button>
            </div>
          </div>

          <!-- KPI 3 -->
          <div class="metric-glass-card">
            <div class="metric-top">
              <span class="metric-label">SITE UPDATES / REVISIONS</span>
              <div class="metric-icon-box emerald-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </div>
            </div>
            <div class="metric-val" id="metric-updates-count">--</div>
            <div class="metric-bottom">
              <span class="metric-sub">Tracked live telemetry mutations</span>
              <button type="button" class="metric-action-btn" data-dash-nav="dash-tab-cv">Edit Studio</button>
            </div>
          </div>

          <!-- KPI 4 -->
          <div class="metric-glass-card">
            <div class="metric-top">
              <span class="metric-label">TELEMETRY STORE STATUS</span>
              <div class="metric-icon-box purple-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </div>
            </div>
            <div class="metric-val text-green" id="metric-sync-status">SYNCHRONIZED</div>
            <div class="metric-bottom">
              <span class="metric-sub">localStorage & reactive events</span>
              <button type="button" class="metric-action-btn" data-dash-nav="dash-tab-system">Backup Data</button>
            </div>
          </div>
        </div>

        <!-- Main Workspace Tabs -->
        <div class="dash-workspace">
          <!-- Segmented Navigation Header -->
          <div class="dash-tabs-bar" role="tablist">
            <button type="button" class="dash-tab is-active" data-dash-tab="dash-tab-achievements" role="tab">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>
              <span>Achievements & Timeline (Upload)</span>
            </button>
            <button type="button" class="dash-tab" data-dash-tab="dash-tab-blog" role="tab">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span>Blog CMS (Viết blog)</span>
            </button>
            <button type="button" class="dash-tab" data-dash-tab="dash-tab-cv" role="tab">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <span>My CV Studio (Chỉnh sửa CV)</span>
            </button>
            <button type="button" class="dash-tab" data-dash-tab="dash-tab-courses" role="tab">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="11" x2="12" y2="17"></line>
                <line x1="9" y1="14" x2="15" y2="14"></line>
              </svg>
              <span>Courses & Materials (Giáo án / Bài giảng)</span>
            </button>
            <button type="button" class="dash-tab" data-dash-tab="dash-tab-system" role="tab">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              <span>Security & Backup</span>
            </button>
          </div>

          <!-- TAB CONTENT PANELS -->
          <div class="dash-tab-content">
            <!-- PANEL 1: ACHIEVEMENTS & TIMELINE -->
            <div id="dash-tab-achievements" class="dash-panel is-active">
              <div class="panel-header-split">
                <div>
                  <h3 class="dash-panel-title">Technical Achievements & Mission Timeline</h3>
                  <p class="dash-panel-desc">Add verified NASA space flight awards, IEEE/AIAA technical distinctions, and orbital milestones with exact dates.</p>
                </div>
                <button type="button" id="dash-ach-reset-btn" class="dash-sub-btn">+ New Achievement Form</button>
              </div>

              <!-- Achievement Form -->
              <form id="dash-ach-form" class="dash-form-card">
                <input type="hidden" id="dash-ach-id" value="" />
                
                <div class="form-row form-row-2">
                  <div class="form-field">
                    <label for="dash-ach-title" class="field-label">Achievement / Award Title *</label>
                    <input type="text" id="dash-ach-title" class="editor-input" placeholder="e.g. NASA Space Flight Honor Award" required />
                  </div>
                  <div class="form-field">
                    <label for="dash-ach-timeline" class="field-label">Timeline / Date *</label>
                    <input type="text" id="dash-ach-timeline" class="editor-input" placeholder="e.g. 2024 — Present or October 2024" required />
                  </div>
                </div>

                <div class="form-row form-row-3">
                  <div class="form-field">
                    <label for="dash-ach-cat" class="field-label">Category</label>
                    <select id="dash-ach-cat" class="editor-select">
                      <option value="Flight Heritage">Flight Heritage</option>
                      <option value="Technical Award">Technical Award</option>
                      <option value="Mission Milestone">Mission Milestone</option>
                      <option value="Publications">Publications & Whitepapers</option>
                      <option value="Fellowship">Fellowship / Honor</option>
                      <option value="Patent">Patent / Intellectual Property</option>
                    </select>
                  </div>
                  <div class="form-field">
                    <label for="dash-ach-org" class="field-label">Organization / Sponsor</label>
                    <input type="text" id="dash-ach-org" class="editor-input" placeholder="e.g. NASA Jet Propulsion Laboratory" />
                  </div>
                  <div class="form-field">
                    <label for="dash-ach-metrics" class="field-label">Quantified Metric / Impact</label>
                    <input type="text" id="dash-ach-metrics" class="editor-input" placeholder="e.g. 0 safe-mode trips / Top 1% distinction" />
                  </div>
                </div>

                <div class="form-field">
                  <label for="dash-ach-desc" class="field-label">Description & Harvard Accomplishment Summary</label>
                  <textarea id="dash-ach-desc" rows="3" class="editor-textarea" placeholder="Detailed technical narrative describing the achievement and engineering leadership..."></textarea>
                </div>

                <div class="form-field">
                  <label for="dash-ach-tags" class="field-label">Tags (comma-separated)</label>
                  <input type="text" id="dash-ach-tags" class="editor-input" placeholder="e.g. Rust, CCSDS, ARM Cortex-M7, FDIR" />
                </div>

                <div class="form-action-bar">
                  <button type="submit" id="dash-ach-submit-btn" class="btn-primary-amber">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                      <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    </svg>
                    <span>Save to Timeline & Store</span>
                  </button>
                </div>
              </form>

              <!-- Achievements Inventory -->
              <div class="dash-inventory-wrapper">
                <div class="dash-inv-title-bar">
                  <h4>Live Achievements Directory</h4>
                  <span id="dash-ach-badge" class="count-pill">0 items</span>
                </div>
                <div id="dash-ach-list" class="dash-inventory-list">
                  <!-- Dynamically rendered -->
                </div>
              </div>
            </div>

            <!-- PANEL 2: MISSION BLOG CMS -->
            <div id="dash-tab-blog" class="dash-panel">
              <div class="panel-header-split">
                <div>
                  <h3 class="dash-panel-title">Technical Mission Articles Composer</h3>
                  <p class="dash-panel-desc">Draft and publish space systems engineering articles with rich Markdown, tags, and reading estimates.</p>
                </div>
                <button type="button" id="dash-blog-reset-btn" class="dash-sub-btn">+ New Article</button>
              </div>

              <!-- Blog Form -->
              <form id="dash-blog-form" class="dash-form-card">
                <input type="hidden" id="dash-blog-id" value="" />

                <div class="form-row form-row-2">
                  <div class="form-field">
                    <label for="dash-blog-title" class="field-label">Article Title *</label>
                    <input type="text" id="dash-blog-title" class="editor-input" placeholder="e.g. Deterministic Real-Time Flight Software with Rust" required />
                  </div>
                  <div class="form-field">
                    <label for="dash-blog-slug" class="field-label">URL Slug *</label>
                    <input type="text" id="dash-blog-slug" class="editor-input" placeholder="e.g. deterministic-rtos-flight-software" required />
                  </div>
                </div>

                <div class="form-row form-row-3">
                  <div class="form-field">
                    <label for="dash-blog-category" class="field-label">Category</label>
                    <select id="dash-blog-category" class="editor-select">
                      <option value="Flight Software">Flight Software</option>
                      <option value="Orbital Mechanics">Orbital Mechanics</option>
                      <option value="Avionics">Avionics</option>
                      <option value="Deep Space Comms">Deep Space Comms</option>
                    </select>
                  </div>
                  <div class="form-field">
                    <label for="dash-blog-date" class="field-label">Publication Date</label>
                    <input type="date" id="dash-blog-date" class="editor-input" />
                  </div>
                  <div class="form-field">
                    <label for="dash-blog-readtime" class="field-label">Read Time</label>
                    <input type="text" id="dash-blog-readtime" class="editor-input" placeholder="e.g. 5 min read" />
                  </div>
                </div>

                <div class="form-field">
                  <label for="dash-blog-tags" class="field-label">Category Tags (comma-separated)</label>
                  <input type="text" id="dash-blog-tags" class="editor-input" placeholder="e.g. Flight Software, Rust, RTOS" />
                </div>

                <div class="form-field">
                  <label for="dash-blog-excerpt" class="field-label">Abstract / Excerpt *</label>
                  <textarea id="dash-blog-excerpt" rows="2" class="editor-textarea" placeholder="Brief technical summary..." required></textarea>
                </div>

                <div class="form-field">
                  <label for="dash-blog-content" class="field-label">Article Markdown Content *</label>
                  <textarea id="dash-blog-content" rows="10" class="editor-textarea font-mono" placeholder="Write full markdown technical post here..." required></textarea>
                </div>

                <div class="form-action-bar">
                  <button type="submit" id="dash-blog-submit-btn" class="btn-primary-amber">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    </svg>
                    <span>Publish Article</span>
                  </button>
                </div>
              </form>

              <!-- Blog Inventory -->
              <div class="dash-inventory-wrapper">
                <div class="dash-inv-title-bar">
                  <h4>Published Articles</h4>
                  <span id="dash-blog-badge" class="count-pill">0 posts</span>
                </div>
                <div id="dash-blog-list" class="dash-inventory-list">
                  <!-- Dynamically rendered -->
                </div>
              </div>
            </div>

            <!-- PANEL 3: MY CV STUDIO -->
            <div id="dash-tab-cv" class="dash-panel">
              <div class="panel-header-split">
                <div>
                  <h3 class="dash-panel-title">My CV Content & Sections Studio</h3>
                  <p class="dash-panel-desc">Modify personal identity, avatar, academic appointments, degrees, thesis titles, or edit the full CV via the Word Document Canvas.</p>
                </div>
                <div style="display:flex; gap:0.5rem; align-items:center;">
                  <a href="/cv" target="_blank" class="dash-sub-btn">Preview My CV ↗</a>
                </div>
              </div>

              <!-- Mode Switcher: Form View vs Word Document Editor View -->
              <div class="cv-mode-selector">
                <button type="button" class="cv-mode-btn is-active" id="dash-cv-mode-form-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                  <span>Structured Form Mode</span>
                </button>
                <button type="button" class="cv-mode-btn" id="dash-cv-mode-doc-btn">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
