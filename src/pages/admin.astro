    function resetCourseForm() {
      if (!courseForm) return;
      courseId.value = '';
      courseCode.value = '';
      courseTitle.value = '';
      courseSemester.value = '';
      courseInstitution.value = '';
      courseEmail.value = '';
      courseGithub.value = '';
      courseDesc.value = '';
      courseTags.value = '';
      const sBtn = document.getElementById('dash-course-submit-btn');
      if (sBtn) sBtn.querySelector('span')!.textContent = 'Save & Publish Course';
    }

    courseResetBtn?.addEventListener('click', resetCourseForm);

    async function loadCourses() {
      if (!courseList) return;
      const store = await getStore();
      let list: any[] = [];
      if (store && typeof store.getCourses === 'function') {
        list = store.getCourses();
      } else {
        const fullData = store && typeof store.getData === 'function' ? store.getData() : {};
        list = fullData.courses || [];
      }

      if (courseBadge) courseBadge.textContent = `${list.length} courses`;

      if (list.length === 0) {
        courseList.innerHTML = `<div style="text-align:center; padding:2rem; color:#8E95A5;">No academic courses recorded yet. Add one above!</div>`;
        return;
      }

      courseList.innerHTML = list.map((item: any) => {
        const gh = safeUrl(item.githubUrl);
        return `
        <div class="dash-item-card" data-id="${esc(item.id)}">
          <div class="dash-card-left">
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
              <span style="background:rgba(229,169,106,0.15); color:#E5A96A; border:1px solid rgba(229,169,106,0.3); padding:0.1rem 0.45rem; border-radius:4px; font-size:0.75rem; font-weight:700;">${esc(item.code || 'COURSE')}</span>
              <h5 class="dash-card-title" style="margin:0;">${esc(item.title || 'Untitled')}</h5>
            </div>
            <div class="dash-card-meta">
              <span style="color:#E5A96A; font-weight:600;">${esc(item.semester || '')}</span>
              ${item.institution ? `<span>•</span><span>${esc(item.institution)}</span>` : ''}
              ${item.instructorEmail ? `<span>•</span><span>${esc(item.instructorEmail)}</span>` : ''}
              ${gh ? `<span>•</span><a href="${esc(gh)}" target="_blank" rel="noopener noreferrer" style="color:#60A5FA; text-decoration:underline;">GitHub ↗</a>` : ''}
            </div>
          </div>
          <div class="dash-card-actions">
            <button type="button" class="btn-inv-edit" data-edit-course="${esc(item.id)}">Edit</button>
            <button type="button" class="btn-inv-delete" data-delete-course="${esc(item.id)}">Delete</button>
          </div>
        </div>
      `;
      }).join('');

      // Wire edit
      courseList.querySelectorAll('[data-edit-course]').forEach(b => {
        b.addEventListener('click', () => {
          const id = b.getAttribute('data-edit-course');
          const target = list.find((c: any) => c.id === id);
          if (target) {
            courseId.value = target.id || '';
            courseCode.value = target.code || '';
            courseTitle.value = target.title || '';
            courseSemester.value = target.semester || '';
            courseInstitution.value = target.institution || '';
            courseEmail.value = target.instructorEmail || target.email || '';
            courseGithub.value = target.githubUrl || '';
            courseDesc.value = target.description || '';
            courseTags.value = Array.isArray(target.tags) ? target.tags.join(', ') : (target.tags || '');
            const sBtn = document.getElementById('dash-course-submit-btn');
            if (sBtn) sBtn.querySelector('span')!.textContent = 'Update Course Archive';
            courseForm.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // Wire delete
      courseList.querySelectorAll('[data-delete-course]').forEach(b => {
        b.addEventListener('click', async () => {
          const id = b.getAttribute('data-delete-course');
          if (!confirm('Are you sure you want to delete this course archive?')) return;
          const store = await getStore();
          if (store && typeof store.deleteCourse === 'function') {
            store.deleteCourse(id);
          }
          loadCourses();
          updateDashboardTelemetryStats();
        });
      });
    }

    courseForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = courseCode.value.trim();
      const title = courseTitle.value.trim();
      const id = courseId.value || `course-${slugifyText(code) || 'item'}-${Date.now()}`;
      const payload = {
        id,
        code,
        title,
        semester: courseSemester.value.trim(),
        institution: courseInstitution.value.trim(),
        instructorEmail: courseEmail.value.trim(),
        githubUrl: courseGithub.value.trim(),
        description: courseDesc.value.trim(),
        tags: courseTags.value.split(',').map(t => t.trim()).filter(Boolean),
        updatedAt: new Date().toISOString().split('T')[0]
      };

      const store = await getStore();
      if (courseId.value) {
        if (store && typeof store.updateCourse === 'function') {
          store.updateCourse(id, payload);
        }
      } else {
        if (store && typeof store.addCourse === 'function') {
          store.addCourse(payload);
        }
      }

      resetCourseForm();
      loadCourses();
      updateDashboardTelemetryStats();
      alert('Course archive successfully saved and published!');
    });

    // ----------------------------------------------------
    // TAB 5: SYSTEM SECURITY & BACKUP
    // ----------------------------------------------------
    const exportBtn = document.getElementById('dash-export-btn');
    const importInput = document.getElementById('dash-import-file') as HTMLInputElement;
    const resetBtn = document.getElementById('dash-reset-btn');

    exportBtn?.addEventListener('click', async () => {
      const store = await getStore();
      if (!store || typeof store.exportDataJSON !== 'function') return;
      const json = store.exportDataJSON();
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `space-portfolio-backup-${new Date().toISOString().split('T')[0]}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    importInput?.addEventListener('change', () => {
      const file = importInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (evt) => {
        try {
          const store = await getStore();
          const jsonStr = evt.target?.result as string;
          if (store && typeof store.importDataJSON === 'function') {
            const res = store.importDataJSON(jsonStr);
            if (res.success) {
              alert('Full portfolio dataset imported and updated!');
              loadDashboardData();
            } else {
              alert('Import failed: ' + res.error);
            }
          }
        } catch (err) {
          alert('Invalid JSON file format.');
        }
      };
      reader.readAsText(file);
    });

    resetBtn?.addEventListener('click', async () => {
      if (!confirm('Warning: Factory Reset will clear all your saved achievements, blog posts, and CV customizations and restore original data. Proceed?')) return;
      const store = await getStore();
      if (store && typeof store.resetToDefaults === 'function') {
        store.resetToDefaults();
      }
      alert('System reset to default flight telemetry data.');
      syncViews();
    });

    async function updateDashboardTelemetryStats() {
      try {
        const store = await getStore();
        const metricUpdatesCount = document.getElementById('metric-updates-count');
        const metricUserDisplayName = document.getElementById('dash-user-display-name');
        if (store && typeof store.getDashboardStats === 'function') {
          const stats = store.getDashboardStats();
          if (metricUpdatesCount && typeof stats.updatesCount !== 'undefined') {
            metricUpdatesCount.textContent = `${stats.updatesCount}`;
          }
          if (metricAchCount && typeof stats.achievementsCount !== 'undefined') {
            metricAchCount.textContent = `${stats.achievementsCount}`;
          }
          if (metricBlogCount && typeof stats.blogsCount !== 'undefined') {
            metricBlogCount.textContent = `${stats.blogsCount}`;
          }
        } else if (store && typeof store.getUpdateCount === 'function') {
          if (metricUpdatesCount) metricUpdatesCount.textContent = `${store.getUpdateCount()}`;
        }

        if (store && typeof store.getCVData === 'function') {
          const cv = store.getCVData();
          if (cv?.profile?.name && metricUserDisplayName) {
            metricUserDisplayName.textContent = cv.profile.name;
          }
        }
      } catch (err) {
        console.warn('Dashboard telemetry stats update failed:', err);
      }
    }

    function loadDashboardData() {
      loadAchievements();
      loadBlogs();
      loadCV();
      loadCourses();
      updateDashboardTelemetryStats();
    }

    function applyHashRoute() {
      const hash = window.location.hash || '';
      if (!hash) return;
      if (hash === '#compose') {
        switchDashTab('dash-tab-blog');
        resetBlogForm();
        blogForm?.scrollIntoView({ behavior: 'smooth' });
      } else if (hash.startsWith('#edit-blog-')) {
        const targetSlug = decodeURIComponent(hash.slice('#edit-blog-'.length));
        switchDashTab('dash-tab-blog');
        const list = typeof Store.getBlogs === 'function' ? Store.getBlogs() : [];
        const match = list.find((b: any) => b.slug === targetSlug || b.id === targetSlug);
        if (match) startEditingBlog(match);
      } else if (hash === '#courses') {
        switchDashTab('dash-tab-courses');
      } else if (hash === '#cv' || hash === '#profile') {
        switchDashTab('dash-tab-cv');
      } else if (hash === '#achievements' || hash === '#timeline') {
        switchDashTab('dash-tab-achievements');
      } else if (hash === '#system' || hash === '#backup') {
        switchDashTab('dash-tab-system');
      }
    }

    (window as any).__adminPageActive = {
      syncViews,
      loadDashboardData,
      applyHashRoute,
      isDashVisible: () => dashScreen.style.display !== 'none'
    };

    if (!(window as any).__adminWindowBound) {
      (window as any).__adminWindowBound = true;
      window.addEventListener('portfolio-data-updated', () => {
        const active = (window as any).__adminPageActive;
        if (active && active.isDashVisible()) active.loadDashboardData();
      });
      window.addEventListener('portfolio-admin-auth-changed', () => {
        const active = (window as any).__adminPageActive;
        if (active) active.syncViews();
      });
      window.addEventListener('hashchange', () => {
        const active = (window as any).__adminPageActive;
        if (active && active.isDashVisible()) active.applyHashRoute();
      });
      window.addEventListener('storage', (e) => {
        const active = (window as any).__adminPageActive;
        if (!active) return;
        if (e.key === 'space_portfolio_admin_session_v2') active.syncViews();
        else if (e.key === 'space_portfolio_data_v1' && active.isDashVisible()) active.loadDashboardData();
      });
    }

    // Initial load
    syncViews();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminPage);
  } else {
    setupAdminPage();
  }
  if (!(window as any).__adminAstroHooked) {
    (window as any).__adminAstroHooked = true;
    document.addEventListener('astro:page-load', setupAdminPage);
  }
</script>
