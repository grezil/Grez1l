        const summary = (item.querySelector('.summary-input') as HTMLTextAreaElement)?.value || '';
        const highlightsText = (item.querySelector('.highlights-input') as HTMLTextAreaElement)?.value || '';
        const highlights = highlightsText.split('\n').map(h => h.trim()).filter(Boolean);
        updatedExp.push({ ...base, role, organization, period, badge, summary, highlights });
      });

      const eduItems = cvEduContainer?.querySelectorAll('.repeater-item') || [];
      const updatedEdu: any[] = [];
      eduItems.forEach((item, idx) => {
        const base = currentEdu[idx] || {};
        const degree = (item.querySelector('.deg-input') as HTMLInputElement)?.value || '';
        const institution = (item.querySelector('.inst-input') as HTMLInputElement)?.value || '';
        const period = (item.querySelector('.yr-input') as HTMLInputElement)?.value || '';
        const honors = (item.querySelector('.honors-input') as HTMLInputElement)?.value || '';
        const thesis = (item.querySelector('.thesis-input') as HTMLInputElement)?.value || '';
        updatedEdu.push({ ...base, degree, institution, period, honors, thesis });
