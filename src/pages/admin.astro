      if (typeof Store.checkAdminAuth === 'function') {
        return Store.checkAdminAuth();
      }
      try {
        const raw = localStorage.getItem('space_portfolio_admin_session_v2');
        if (!raw) return false;
        const s = JSON.parse(raw);
        return s && s.user === 'admin' && s.authenticated === true;
      } catch {
        return false;
      }
    }

