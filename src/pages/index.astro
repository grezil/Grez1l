---
// Streamlined Apple-Grade Space Engineer Portfolio
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import HarvardCV from '../components/HarvardCV.astro';

import portfolioData from '../data/portfolio.json';

const { profile, timeline } = portfolioData;
---

<Layout 
  title={`${profile.name} | ${profile.title}`} 
  description={`${profile.title} - ${profile.tagline}`}
>
  <!-- Apple-Style Segmented View Switcher: Executive Overview vs Harvard Academic CV -->
  <div class="view-switcher-bar no-print" id="view-switcher-bar">
    <div class="container view-switcher-inner">
      <div class="apple-view-segmented" role="tablist" aria-label="Portfolio Presentation Mode">
        <button
          type="button"
          class="segmented-toggle-btn active"
          id="btn-telemetry-mode"
          role="tab"
          aria-selected="true"
          aria-controls="panel-telemetry-view"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="2"></circle>
            <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
          </svg>
          <span>Executive Profile</span>
        </button>

        <button
          type="button"
          class="segmented-toggle-btn"
          id="btn-harvard-mode"
          role="tab"
          aria-selected="false"
          aria-controls="panel-harvard-view"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Harvard Academic CV</span>
          <span class="view-tag-badge">FAS Standard</span>
        </button>
      </div>

      <div class="view-switcher-right">
        <a href="/cv" class="btn-dedicated-cv" title="Open full dedicated Harvard CV page with 1-click PDF print">
          <span>Dedicated CV Page</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Primary Presentation Panel 1: Executive Profile & Highlights -->
  <div id="panel-telemetry-view" class="presentation-panel active-panel" role="tabpanel" aria-labelledby="btn-telemetry-mode">
    <!-- Executive Hero: Highlights VO QUANG NHAT NGUYEN, Caltech/MIT credentials, flight record, verified contacts -->
    <Hero profile={profile} />

    <div class="section-divider" aria-hidden="true"></div>

    <!-- Career Trajectory & Flight Heritage Log -->
    <Timeline timeline={timeline} />
  </div>

  <!-- Primary Presentation Panel 2: Harvard Academic CV View -->
  <div id="panel-harvard-view" class="presentation-panel cv-panel" role="tabpanel" aria-labelledby="btn-harvard-mode" style="display: none;">
    <div class="container cv-view-container">
      <HarvardCV initialTheme="paper" hideControls={false} />
    </div>
  </div>
</Layout>

<script>
  function setupPortfolioViewSwitcher() {
    const btnTelemetry = document.getElementById('btn-telemetry-mode');
    const btnCV = document.getElementById('btn-harvard-mode');
    const panelTelemetry = document.getElementById('panel-telemetry-view');
    const panelCV = document.getElementById('panel-harvard-view');

    if (!btnTelemetry || !btnCV || !panelTelemetry || !panelCV) return;

    function activateMode(mode: 'telemetry' | 'cv') {
      if (mode === 'cv') {
        btnCV?.classList.add('active');
        btnCV?.setAttribute('aria-selected', 'true');
        btnTelemetry?.classList.remove('active');
        btnTelemetry?.setAttribute('aria-selected', 'false');

        panelTelemetry.style.display = 'none';
        panelCV.style.display = 'block';

        const switcherBar = document.getElementById('view-switcher-bar');
        if (switcherBar) {
          switcherBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } else {
        btnTelemetry?.classList.add('active');
        btnTelemetry?.setAttribute('aria-selected', 'true');
        btnCV?.classList.remove('active');
        btnCV?.setAttribute('aria-selected', 'false');

        panelCV.style.display = 'none';
        panelTelemetry.style.display = 'block';
      }
    }

    btnTelemetry.addEventListener('click', () => activateMode('telemetry'));
    btnCV.addEventListener('click', () => activateMode('cv'));

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('view') === 'cv' || window.location.hash === '#cv' || window.location.hash === '#harvard-cv') {
      activateMode('cv');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPortfolioViewSwitcher);
  } else {
    setupPortfolioViewSwitcher();
  }
</script>

<style>
  /* Clean Apple Presentation Styles */
  .view-switcher-bar {
    position: sticky;
    top: var(--header-height, 64px);
    z-index: 40;
    padding: 0.75rem 0;
    background: rgba(11, 13, 19, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .view-switcher-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .apple-view-segmented {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
  }

  .segmented-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    background: transparent;
    border: none;
    color: #9ca3af;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .segmented-toggle-btn:hover {
    color: #f3f4f6;
  }

  .segmented-toggle-btn.active {
    background: rgba(229, 169, 106, 0.15);
    color: #e5a96a;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .view-tag-badge {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    background: rgba(229, 169, 106, 0.2);
    color: #e5a96a;
    font-weight: 600;
  }

  .btn-dedicated-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #9ca3af;
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.2s ease;
  }

  .btn-dedicated-cv:hover {
    color: #e5a96a;
    border-color: rgba(229, 169, 106, 0.3);
  }

  .cv-view-container {
    padding: 2.5rem 0 5rem;
  }
</style>
