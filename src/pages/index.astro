---
// Streamlined Apple-Grade Space Engineer Portfolio
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContributionHeatmap from '../components/ContributionHeatmap.astro';

import portfolioData from '../data/portfolio.json';

const { profile } = portfolioData;
---

<Layout 
  title={`${profile.name} | ${profile.title}`} 
  description={`${profile.title} - ${profile.tagline}`}
>
  <!-- Executive Hero: Highlights VO QUANG NHAT NGUYEN, Caltech/MIT credentials, flight record, verified contacts -->
  <Hero profile={profile} />

  <div class="section-divider" aria-hidden="true"></div>

  <!-- Habit Tracker & Telemetry Contribution Graph -->
  <ContributionHeatmap />
</Layout>
