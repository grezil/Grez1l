---
// blog.astro - Space Engineer Aerospace Technical Journal & Blog
import Layout from '../layouts/Layout.astro';
import BlogCard, { type BlogPost } from '../components/BlogCard.astro';
import portfolioData from '../data/portfolio.json';
import { DEFAULT_BLOGS } from '../data/defaultBlogs.js';

// Merge portfolio.json blogs (if present) with DEFAULT_BLOGS
const jsonBlogs = (portfolioData as any).blogs as BlogPost[] | undefined;
const initialBlogs: BlogPost[] = (jsonBlogs && Array.isArray(jsonBlogs) && jsonBlogs.length > 0)
  ? jsonBlogs
  : DEFAULT_BLOGS;

const categories = [
  { id: 'all', label: 'All Dispatches' },
  { id: 'flight-software', label: 'Flight Software' },
  { id: 'orbital-mechanics', label: 'Orbital Mechanics' },
  { id: 'avionics', label: 'Avionics' },
  { id: 'deep-space-comms', label: 'Deep Space Comms' }
];

const totalArticles = initialBlogs.length;
const totalCourses = ((portfolioData as any).courses || []).length || 3;
const totalUpdates = (portfolioData as any).profile?.telemetryStats?.[0]?.value || '64';
const staticBlogSlugs = initialBlogs.map((b) => b.slug);
---

<Layout 
  title="Mission Technical Log & Engineering Blog | Võ Quang Nhật Nguyên"
  description="Technical aerospace journal, flight software architectures, orbital dynamics, and mission engineering dispatches by Võ Quang Nhật Nguyên."
>
  <div class="blog-page-container">
    <!-- Hero Header -->
    <header class="blog-hero">
      <div class="container">
        <div class="hero-top-nav">
          <a href="/" class="back-home-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Back to Mission Control</span>
          </a>
          <div class="live-telemetry-badge">
            <span class="beacon-dot"></span>
            <span>FSW LOG // CCSDS 133.0 STREAM</span>
          </div>
        </div>

        <div class="hero-content">
          <div class="section-tag">MISSION DISPATCHES & TECHNICAL JOURNAL</div>
          <h1 class="hero-title">
            Aerospace Flight Software & <span class="glow-warm">Orbital Systems Log</span>
          </h1>
          <p class="hero-description">
            In-depth mission architectures, deterministic flight software in Rust/C, real-time astrodynamics algorithms, fault-tolerant avionics buses, and deep space optical downlinks.
          </p>

          <!-- Telemetry Specs Bar -->
          <div class="telemetry-bar">
            <div class="telemetry-stat">
              <span class="stat-label">SITE UPDATES</span>
              <span class="stat-val text-amber" id="stat-updates-count">{totalUpdates} Updates</span>
            </div>
            <div class="telemetry-divider"></div>
            <div class="telemetry-stat">
              <span class="stat-label">BLOG ARTICLES</span>
              <span class="stat-val text-cyan" id="stat-total-count">{totalArticles} Articles</span>
            </div>
            <div class="telemetry-divider"></div>
            <div class="telemetry-stat">
              <span class="stat-label">FILE ARCHIVES</span>
              <span class="stat-val text-blue" id="stat-archives-count">GitHub Mirrored</span>
            </div>
            <div class="telemetry-divider"></div>
            <div class="telemetry-stat">
              <span class="stat-label">COURSES</span>
              <span class="stat-val text-green" id="stat-courses-count">{totalCourses} Courses</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Section -->
    <main class="blog-main-section">
      <div class="container">
        <!-- Controls & Filter Toolbar -->
        <div class="filter-toolbar">
          <!-- Category Segmented Control -->
          <div class="segmented-control" role="tablist" aria-label="Filter blog posts by category">
            {categories.map((cat, idx) => (
              <button 
                type="button"
                class={`segment-btn ${idx === 0 ? 'active' : ''}`}
                data-category={cat.id}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                {cat.label}
              </button>
            ))}
          </div>

          <!-- Search & Actions Bar -->
          <div class="search-actions-bar">
            <div class="search-box">
              <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input 
                type="text" 
                id="blog-search-input" 
                placeholder="Search algorithms, protocols, tags..." 
                aria-label="Search blog dispatches"
              />
              <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Clear search" style="display: none;">
                ×
              </button>
              <kbd class="search-shortcut" title="Press / to search">/</kbd>
            </div>

            <!-- Admin Compose Quick Action (Visible to logged in admins) -->
            <button type="button" id="admin-compose-btn" class="admin-compose-action" style="display: none;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Compose Dispatch</span>
            </button>
          </div>
        </div>

        <!-- Filter Results Telemetry Notice -->
        <div class="filter-status-row" id="filter-status-row" style="display: none;">
          <span class="status-count-text" id="filter-count-text">Showing all dispatches</span>
          <button type="button" id="reset-filter-btn" class="reset-link-btn">Reset Filters</button>
        </div>

        <!-- Blog Posts Grid -->
        <div class="blog-grid" id="blog-grid" data-static-slugs={JSON.stringify(staticBlogSlugs)}>
          {initialBlogs.map((post, idx) => (
            <BlogCard post={post} featured={post.featured || idx === 0} />
          ))}
        </div>

        <!-- Empty State -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <div class="empty-radar-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
              <line x1="12" y1="2" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="empty-title">No Orbital Dispatches Found</h3>
          <p class="empty-text">No technical articles match the specified telemetry filter or search query. Try relaxing your parameters.</p>
          <button type="button" class="btn btn-secondary btn-sm" id="empty-reset-btn">
            Clear Telemetry Filter
          </button>
        </div>
      </div>
    </main>

    <!-- Quick Article Interactive Reader Modal -->
    <div class="reader-modal-overlay" id="reader-modal" aria-hidden="true">
      <div class="reader-modal-backdrop" id="reader-backdrop"></div>
      <div class="reader-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-article-title">
        <header class="reader-modal-header">
          <div class="reader-header-left">
            <span class="reader-category-pill" id="modal-category-pill">Flight Software</span>
            <span class="reader-header-date" id="modal-date">Oct 18, 2024</span>
            <span class="meta-dot">•</span>
            <span class="reader-header-readtime" id="modal-readtime">8 min read</span>
          </div>

          <div class="reader-header-actions">
            <a href="#" id="modal-full-link" class="modal-action-btn" title="Open full dedicated page">
              <span>Full Page</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Close reader">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </header>

        <div class="reader-modal-body" id="reader-content-body">
          <h1 class="reader-article-title" id="modal-article-title">Loading mission dispatch...</h1>
          
          <div class="reader-author-bar">
            <div class="reader-avatar">NN</div>
            <div class="reader-author-details">
              <span class="reader-author-name" id="modal-author-name">Võ Quang Nhật Nguyên</span>
              <span class="reader-author-title" id="modal-author-title">Lead Flight Software Engineer • NHAT-NGUYEN</span>
            </div>
          </div>

          <div class="reader-markdown-content" id="modal-article-markdown">
            <!-- Article body rendered here dynamically -->
          </div>
        </div>

        <footer class="reader-modal-footer">
          <div class="reader-footer-tags" id="modal-footer-tags"></div>
          <button type="button" class="btn btn-secondary btn-sm" id="modal-footer-close">Back to Log</button>
        </footer>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { DEFAULT_BLOGS } from '../data/defaultBlogs.js';
  import { getBlogs, checkAdminAuth, getDashboardStats } from '../scripts/store.js';
  import { renderMarkdown } from '../scripts/markdown.js';

  // Client-side reactive blog store & filtering controller
  function initBlogController() {
    const grid = document.getElementById('blog-grid');
    if (!grid || grid.dataset.bound === '1') return;
    grid.dataset.bound = '1';

    (window as any).__blogControllerAbort?.abort();
    const ac = new AbortController();
    (window as any).__blogControllerAbort = ac;
    const { signal } = ac;
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true, signal });

    let currentCategory = 'all';
    let searchQuery = '';
    let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;
    let blogList: any[] = [];
    let staticSlugs = new Set<string>();
    try {
      staticSlugs = new Set(JSON.parse(grid.dataset.staticSlugs || '[]'));
    } catch (e) {}

    // Elements
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const segmentButtons = document.querySelectorAll('.segment-btn');
    const emptyState = document.getElementById('empty-state');
    const filterStatusRow = document.getElementById('filter-status-row');
    const filterCountText = document.getElementById('filter-count-text');
    const resetFilterBtn = document.getElementById('reset-filter-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const statTotalCount = document.getElementById('stat-total-count');
    const statUpdatesCount = document.getElementById('stat-updates-count');
    const statCoursesCount = document.getElementById('stat-courses-count');
    const adminComposeBtn = document.getElementById('admin-compose-btn');

    // Reader Modal Elements
    const readerModal = document.getElementById('reader-modal');
    const readerBackdrop = document.getElementById('reader-backdrop');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalFooterClose = document.getElementById('modal-footer-close');
    const modalFullLink = document.getElementById('modal-full-link') as HTMLAnchorElement | null;
    const modalCategoryPill = document.getElementById('modal-category-pill');
    const modalDate = document.getElementById('modal-date');
    const modalReadtime = document.getElementById('modal-readtime');
    const modalArticleTitle = document.getElementById('modal-article-title');
    const modalAuthorName = document.getElementById('modal-author-name');
    const modalAuthorTitle = document.getElementById('modal-author-title');
    const modalArticleMarkdown = document.getElementById('modal-article-markdown');
    const modalFooterTags = document.getElementById('modal-footer-tags');

    function esc(str: any): string {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // 1. Fetch live blogs from store or localStorage (ponytail: respect [] when user deleted all)
    function loadBlogs(): any[] {
      try {
        if (typeof getBlogs === 'function') {
          const storeBlogs = getBlogs();
          if (Array.isArray(storeBlogs)) {
            return storeBlogs;
          }
        }

        const store = (window as any).PortfolioStore;
        if (store && typeof store.getBlogs === 'function') {
          const storeBlogs = store.getBlogs();
          if (Array.isArray(storeBlogs)) {
            return storeBlogs;
          }
        }

        const rawData = localStorage.getItem('space_portfolio_data_v1') || localStorage.getItem('space_portfolio_data');
        if (rawData) {
          const parsedData = JSON.parse(rawData);
          if (parsedData && Array.isArray(parsedData.blogs)) {
            return parsedData.blogs;
          }
        }
      } catch (err) {
        console.warn('Error reading store blogs, falling back to defaults:', err);
      }

      return DEFAULT_BLOGS;
    }

    function getPostHref(post: any): string {
      if (staticSlugs.has(post.slug)) {
        return `/blog/${encodeURIComponent(post.slug)}`;
      }
      return `/blog?post=${encodeURIComponent(post.slug)}`;
    }

    // 2. Open Quick View / Runtime Article Reader Modal
    function openReader(post: any, updateUrl = true) {
      if (!readerModal || !post) return;

      if (modalCategoryPill) {
        modalCategoryPill.textContent = post.category || 'Flight Software';
      }
      if (modalDate) modalDate.textContent = post.date || 'Mission Epoch';
      if (modalReadtime) modalReadtime.textContent = post.readTime || '5 min read';
      if (modalArticleTitle) modalArticleTitle.textContent = post.title || 'Untitled Dispatch';

      const author = typeof post.author === 'object' && post.author !== null ? post.author : { name: post.author || 'Võ Quang Nhật Nguyên', title: 'Flight Software Lead' };
      if (modalAuthorName) modalAuthorName.textContent = author.name || 'Võ Quang Nhật Nguyên';
      if (modalAuthorTitle) modalAuthorTitle.textContent = author.role || author.title || 'Lead Flight Software Engineer';

      if (modalFullLink) {
        const isStatic = staticSlugs.has(post.slug);
        if (isStatic) {
          modalFullLink.href = `/blog/${encodeURIComponent(post.slug)}`;
          modalFullLink.dataset.mode = 'navigate';
          const span = modalFullLink.querySelector('span');
          if (span) span.textContent = 'Full Page';
        } else {
          // ponytail: runtime-created post uses ?post=slug to prevent 404 on static hosts
          modalFullLink.href = `/blog?post=${encodeURIComponent(post.slug)}`;
          modalFullLink.dataset.mode = 'copy';
          const span = modalFullLink.querySelector('span');
          if (span) span.textContent = 'Copy Link';
        }
      }

      if (modalArticleMarkdown) {
        modalArticleMarkdown.innerHTML = renderMarkdown(post.content || post.summary || 'No dispatch content available.');
      }

      if (modalFooterTags) {
        const tags = Array.isArray(post.tags) ? post.tags : [];
        modalFooterTags.innerHTML = tags.map((t: string) => `<span class="reader-footer-tag">#${esc(t)}</span>`).join('');
      }

      if (updateUrl && post.slug) {
        try {
          const nextUrl = `/blog?post=${encodeURIComponent(post.slug)}`;
          if (window.location.pathname + window.location.search !== nextUrl) {
            window.history.pushState({ postSlug: post.slug }, '', nextUrl);
          }
        } catch (e) {}
      }

      readerModal.classList.add('is-open');
      readerModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeReader(updateUrl = true) {
      if (!readerModal) return;
      readerModal.classList.remove('is-open');
      readerModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (updateUrl && new URLSearchParams(window.location.search).has('post')) {
        try {
          window.history.replaceState(null, '', '/blog');
        } catch (e) {}
      }
    }

    // 3. Render client cards dynamically (for additions/edits)
    function renderCards() {
      blogList = loadBlogs();
      if (statTotalCount) {
        statTotalCount.textContent = `${blogList.length} Articles`;
      }

      try {
        if (typeof getDashboardStats === 'function') {
          const stats = getDashboardStats();
          if (stats) {
            if (statUpdatesCount && typeof stats.updatesCount === 'number') {
              statUpdatesCount.textContent = `${stats.updatesCount} Updates`;
            }
            if (statCoursesCount && typeof stats.coursesCount === 'number') {
              statCoursesCount.textContent = `${stats.coursesCount} Courses`;
            }
          }
        }
      } catch (e) {
        // quiet
      }

      const normalizedSearch = searchQuery.toLowerCase().trim();

      const filtered = blogList.filter(post => {
        if (currentCategory !== 'all') {
          const cat = (post.category || '').toLowerCase();
          const postTags = (Array.isArray(post.tags) ? post.tags : []).map((t: string) => String(t).toLowerCase());

          let matches = false;
          if (currentCategory === 'flight-software') {
            matches = cat.includes('flight') || cat.includes('software') || cat.includes('rust') || postTags.some(t => t.includes('flight') || t.includes('software') || t.includes('rust') || t.includes('rtos'));
          } else if (currentCategory === 'orbital-mechanics') {
            matches = cat.includes('orbit') || cat.includes('astrodynamics') || cat.includes('gnc') || cat.includes('dynamics') || postTags.some(t => t.includes('orbit') || t.includes('astrodynamics') || t.includes('propagator') || t.includes('gnc'));
          } else if (currentCategory === 'avionics') {
            matches = cat.includes('avionics') || cat.includes('fdir') || cat.includes('hardware') || postTags.some(t => t.includes('avionics') || t.includes('fdir') || t.includes('spacewire') || t.includes('canopen'));
          } else if (currentCategory === 'deep-space-comms') {
            matches = cat.includes('comms') || cat.includes('ground') || cat.includes('packet') || cat.includes('optical') || postTags.some(t => t.includes('comms') || t.includes('ground') || t.includes('packet') || t.includes('s-band') || t.includes('ccsds'));
          } else {
            matches = cat.includes(currentCategory);
          }
          if (!matches) return false;
        }

        if (normalizedSearch) {
          const matchTitle = (post.title || '').toLowerCase().includes(normalizedSearch);
          const matchSummary = (post.summary || '').toLowerCase().includes(normalizedSearch);
          const matchTags = (Array.isArray(post.tags) ? post.tags : []).some((t: string) => String(t).toLowerCase().includes(normalizedSearch));
          const matchContent = (post.content || '').toLowerCase().includes(normalizedSearch);
          if (!matchTitle && !matchSummary && !matchTags && !matchContent) return false;
        }

        return true;
      });

      if (filterStatusRow && filterCountText) {
        if (currentCategory !== 'all' || normalizedSearch) {
          filterStatusRow.style.display = 'flex';
          filterCountText.textContent = `Showing ${filtered.length} of ${blogList.length} dispatches`;
        } else {
          filterStatusRow.style.display = 'none';
        }
      }

      if (grid) {
        if (filtered.length === 0) {
          grid.style.display = 'none';
          if (emptyState) {
            emptyState.style.display = 'flex';
            const emptyTitle = emptyState.querySelector('.empty-title');
            const emptyText = emptyState.querySelector('.empty-text');
            if (blogList.length === 0) {
              if (emptyTitle) emptyTitle.textContent = 'No Orbital Dispatches Published';
              if (emptyText) emptyText.textContent = 'All blog articles have been removed. Log in as Admin to compose and publish a new technical dispatch.';
              if (emptyResetBtn) emptyResetBtn.style.display = 'none';
            } else {
              if (emptyTitle) emptyTitle.textContent = 'No Orbital Dispatches Found';
              if (emptyText) emptyText.textContent = 'No technical articles match the specified telemetry filter or search query. Try relaxing your parameters.';
              if (emptyResetBtn) emptyResetBtn.style.display = 'inline-flex';
            }
          }
        } else {
          grid.style.display = 'grid';
          if (emptyState) emptyState.style.display = 'none';

          grid.innerHTML = filtered.map((post, idx) => {
            const primaryCat = post.category || (post.tags && post.tags[0]) || 'Flight Software';
            let catClass = 'badge-cat-fsw';
            const lowCat = primaryCat.toLowerCase();
            if (lowCat.includes('orbit') || lowCat.includes('astrodynamics')) catClass = 'badge-cat-orbit';
            else if (lowCat.includes('avionics')) catClass = 'badge-cat-avionics';
            else if (lowCat.includes('comms') || lowCat.includes('ground')) catClass = 'badge-cat-comms';

            const author = typeof post.author === 'object' && post.author !== null ? post.author : { name: post.author || 'Võ Quang Nhật Nguyên', role: 'Flight Software Architect' };
            const tags = Array.isArray(post.tags) ? post.tags : [];
            const tagsHtml = tags.map((t: string) => `<span class="mini-tag">#${esc(t)}</span>`).join('');
            const featuredClass = (post.featured || idx === 0) ? 'featured-card' : '';
            const isStatic = staticSlugs.has(post.slug);
            const postHref = getPostHref(post);
            const runtimeAttr = isStatic ? '' : `data-action="quick-read" data-post-slug="${esc(post.slug)}"`;

            return `
              <article 
                class="blog-card card ${featuredClass}" 
                data-slug="${esc(post.slug)}"
                data-id="${esc(post.id)}"
              >
                <div class="card-meta-top">
                  <div class="category-wrapper">
                    <span class="cat-pill ${catClass}">
                      <span class="pill-dot"></span>
                      ${esc(primaryCat)}
                    </span>
                    ${(post.featured || idx === 0) ? '<span class="featured-badge">Featured Dispatch</span>' : ''}
                  </div>
                  <div class="time-meta">
                    <span class="meta-date">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                      ${esc(post.date || 'Mission Epoch')}
                    </span>
                    <span class="meta-divider">•</span>
                    <span class="meta-readtime">${esc(post.readTime || '5 min read')}</span>
                  </div>
                </div>

                <h3 class="blog-title">
                  <a href="${esc(postHref)}" class="title-link" ${runtimeAttr}>${esc(post.title)}</a>
                </h3>

                <p class="blog-summary">${esc(post.summary || '')}</p>

                <div class="blog-tags">${tagsHtml}</div>

                <div class="card-footer">
                  <div class="author-meta">
                    <div class="author-avatar">
                      <span class="avatar-beacon"></span>
                      <span class="avatar-letter">NN</span>
                    </div>
                    <div class="author-info">
                      <span class="author-name">${esc(author.name || 'Võ Quang Nhật Nguyên')}</span>
                      <span class="author-role">${esc(author.role || author.title || 'Lead Flight Software Engineer')}</span>
                    </div>
                  </div>

                  <div class="action-buttons">
                    <button type="button" class="quick-read-btn btn-sm" data-action="quick-read" data-post-slug="${esc(post.slug)}">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                      Quick View
                    </button>
                    <a href="${esc(postHref)}" class="read-article-link" ${runtimeAttr}>
                      <span>${isStatic ? 'Full Article' : 'Read Article'}</span>
                      <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            `;
          }).join('');
        }
      }
    }

    // 4. Check Admin Auth to show quick compose button
    function checkAdminState() {
      try {
        let isAdmin = false;
        if (typeof checkAdminAuth === 'function') {
          isAdmin = checkAdminAuth();
        } else {
          const raw = localStorage.getItem('space_portfolio_admin_session_v2');
          if (raw) {
            const s = JSON.parse(raw);
            isAdmin = Boolean(s && s.user === 'admin' && s.authenticated === true);
          }
        }

        if (adminComposeBtn) {
          adminComposeBtn.style.display = isAdmin ? 'inline-flex' : 'none';
        }
      } catch (e) {
        // quiet
      }
    }

    // 6. Setup Event Listeners
    segmentButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        segmentButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        currentCategory = btn.getAttribute('data-category') || 'all';
        renderCards();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value;
        if (clearSearchBtn) {
          clearSearchBtn.style.display = searchQuery ? 'inline-flex' : 'none';
        }
        if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
        searchDebounceTimer = setTimeout(() => {
          searchDebounceTimer = null;
          renderCards();
        }, 120);
      });
    }

    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener('click', () => {
        if (searchDebounceTimer) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = null;
        }
        searchInput.value = '';
        searchQuery = '';
        clearSearchBtn.style.display = 'none';
        searchInput.focus();
        renderCards();
      });
    }

    function resetAllFilters() {
      if (searchDebounceTimer) {
        clearTimeout(searchDebounceTimer);
        searchDebounceTimer = null;
      }
      currentCategory = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      if (clearSearchBtn) clearSearchBtn.style.display = 'none';
      segmentButtons.forEach((b, i) => {
        b.classList.toggle('active', i === 0);
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
      });
      renderCards();
    }

    if (resetFilterBtn) resetFilterBtn.addEventListener('click', resetAllFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAllFilters);

    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLTextAreaElement)) {
        e.preventDefault();
        searchInput?.focus();
      } else if (e.key === 'Escape') {
        closeReader();
      }
    }, { signal });

    document.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest('[data-action="quick-read"]');
      if (target) {
        e.preventDefault();
        const slug = target.getAttribute('data-post-slug');
        if (slug) {
          const currentList = loadBlogs();
          const post = currentList.find(p => p.slug === slug);
          if (post) openReader(post);
        }
        return;
      }

      const copyBtn = (e.target as HTMLElement).closest('.copy-code-btn');
      if (copyBtn) {
        const rawCode = decodeURIComponent(copyBtn.getAttribute('data-code') || '');
        if (rawCode && navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(rawCode);
            const label = copyBtn.querySelector('span');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'Copied!';
              copyBtn.classList.add('copied');
              setTimeout(() => {
                label.textContent = orig;
                copyBtn.classList.remove('copied');
              }, 2000);
            }
          } catch (err) {
            console.error('Failed to copy code:', err);
          }
        }
      }
    }, { signal });

    if (modalFullLink) {
      modalFullLink.addEventListener('click', async (e) => {
        if (modalFullLink.dataset.mode === 'copy') {
          e.preventDefault();
          const url = modalFullLink.href;
          try {
            if (navigator.clipboard) await navigator.clipboard.writeText(url);
            const span = modalFullLink.querySelector('span');
            if (span) {
              span.textContent = 'Copied!';
              setTimeout(() => { span.textContent = 'Copy Link'; }, 1800);
            }
          } catch (err) {}
        }
      });
    }

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', () => closeReader());
    if (modalFooterClose) modalFooterClose.addEventListener('click', () => closeReader());
    if (readerBackdrop) readerBackdrop.addEventListener('click', () => closeReader());

    if (adminComposeBtn) {
      adminComposeBtn.addEventListener('click', () => {
        const editorModal = document.getElementById('admin-editor-modal');
        if (editorModal) {
          window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'blog' } }));
        } else {
          window.location.href = '/admin#compose';
        }
      });
    }

    window.addEventListener('portfolio-data-updated', () => {
      renderCards();
      checkAdminState();
    }, { signal });
    window.addEventListener('portfolio-admin-auth-changed', checkAdminState, { signal });
    window.addEventListener('storage', () => {
      renderCards();
      checkAdminState();
    }, { signal });

    window.addEventListener('popstate', () => {
      const slug = new URLSearchParams(window.location.search).get('post');
      if (slug) {
        const target = loadBlogs().find(p => p.slug === slug);
        if (target) openReader(target, false);
      } else {
        closeReader(false);
      }
    }, { signal });

    // Check URL parameters for direct article reader view: /blog?post=slug
    const postParam = new URLSearchParams(window.location.search).get('post');
    if (postParam) {
      const target = loadBlogs().find(p => p.slug === postParam);
      if (target) {
        openReader(target, false);
      }
    }

    // Initial render & admin check
    renderCards();
    checkAdminState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogController);
  } else {
    initBlogController();
  }
  if (!(window as any).__blogAstroHooked) {
    (window as any).__blogAstroHooked = true;
    document.addEventListener('astro:page-load', initBlogController);
  }
</script>

