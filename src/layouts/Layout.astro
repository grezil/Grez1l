---
// Space Systems Engineer - Apple Frosted Cosmic Layout
import CosmicBackground from '../components/CosmicBackground.astro';
import CosmicLoader from '../components/CosmicLoader.astro';
import AdminLoginModal from '../components/AdminLoginModal.astro';
import AdminDock from '../components/AdminDock.astro';
import AdminEditorModal from '../components/AdminEditorModal.astro';
import '../styles/space-apple.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Võ Quang Nhật Nguyên (Nhat Nguyen Vo) | Space Systems & Flight Software Engineer | My CV",
  description = "Aerospace portfolio and Harvard-style Curriculum Vitae of a Flight Software & Space Systems Engineer specializing in CubeSats, avionics, real-time telemetry, and orbital mechanics."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCV = pathname.startsWith('/cv');
const isBlog = pathname.startsWith('/blog');
const isCourse = pathname.startsWith('/course') || pathname.startsWith('/courses');
const isTimeline = pathname.startsWith('/timeline');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Monospace Typography (JetBrains Mono & SF Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Lightweight Satellite SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛰️</text></svg>" />

    <title>{title}</title>
  </head>
  <body>
    <!-- Apple-Grade Cosmic Space Loading Screen -->
    <CosmicLoader />

    <!-- 60FPS Ambient Starfield & Orbiting Satellite -->
    <CosmicBackground />

    <!-- Sleek Apple Minimalist Header -->
    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <!-- Callsign Telemetry Indicator -->
        <a href="/" class="header-callsign" title="Mission Home">
          <span class="callsign-beacon"></span>
          <span class="callsign-name">NHAT-NGUYEN</span>
          <span class="callsign-sep">//</span>
          <span class="callsign-telemetry">LEO 550KM • SYS NOMINAL</span>
        </a>

        <!-- Top Right Actions -->
        <div class="header-actions">
          <a href="mailto:nhatnguyen@orbital-flight.dev" class="btn btn-outline-cyan btn-sm header-comms-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>Uplink</span>
          </a>

          <!-- Admin Key Button -->
          <button
            id="admin-header-trigger"
            class="admin-access-btn"
            type="button"
            title="Admin Control Center"
            aria-label="Admin Control Center"
          >
            <span class="admin-key-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            <span class="admin-btn-label">Admin</span>
            <span class="admin-status-indicator" id="admin-status-indicator"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container Slot -->
    <main class="main-content" id="main-content">
      <slot />
    </main>

    <!-- Apple Floating Bottom Navigation Dock -->
    <nav class="floating-bottom-dock" id="floating-bottom-dock" aria-label="Floating Navigation Dock">
      <div class="floating-dock-pill">
        <a href="/" class={`dock-nav-item ${isHome ? 'active' : ''}`} data-tooltip="Overview & Profile" aria-current={isHome ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span class="dock-nav-label">Home</span>
        </a>

        <a href="/cv" class={`dock-nav-item ${isCV ? 'active' : ''}`} data-tooltip="My CV (PDF)" aria-current={isCV ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span class="dock-nav-label">My CV</span>
          <span class="dock-mini-badge">PDF</span>
        </a>

        <a href="/blog" class={`dock-nav-item ${isBlog ? 'active' : ''}`} data-tooltip="Flight Software & Astrodynamics Dispatches" aria-current={isBlog ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span class="dock-nav-label">Blog</span>
        </a>

        <a href="/course" class={`dock-nav-item ${isCourse ? 'active' : ''}`} data-tooltip="Academic & Teaching Dossier" aria-current={isCourse ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span class="dock-nav-label">Course</span>
        </a>

        <a href="/timeline" class={`dock-nav-item ${isTimeline ? 'active' : ''}`} data-tooltip="Orbital Heritage Timeline" aria-current={isTimeline ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span class="dock-nav-label">Timeline</span>
        </a>

        <div class="dock-nav-separator" aria-hidden="true"></div>

        <a href="mailto:nhatnguyen@orbital-flight.dev" class="dock-nav-item" data-tooltip="Transmit Direct Comms">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span class="dock-nav-label">Contact</span>
        </a>

        <button type="button" class="dock-nav-item" id="dock-admin-trigger" title="Admin Control Center" aria-label="Admin Control Center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="dock-nav-label">Admin</span>
          <span class="dock-status-dot" id="dock-admin-status-dot"></span>
        </button>
      </div>
    </nav>

    <!-- Space Systems Refined Engineering Footer -->
    <footer class="site-footer">
      <div class="container">
        <!-- Telemetry Data Strip -->
        <div class="footer-telemetry">
          <div class="telemetry-item">
            <span class="telemetry-label">ORBITAL REGIME</span>
            <span class="telemetry-val">LEO 550KM // 51.6° INCLINATION</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">COMMUNICATION STANDARD</span>
            <span class="telemetry-val">CCSDS 2.2 GHz S-BAND // QPSK</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">ACADEMIC & INDUSTRY</span>
            <span class="telemetry-val">HARVARD // MIT // NASA HERITAGE</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">SYSTEMS STATUS</span>
            <span class="telemetry-val text-amber">FLIGHT NOMINAL // ALL SUB-SYSTEMS GO</span>
          </div>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-bottom">
          <div class="footer-links">
            <a href="/">Home</a>
            <a href="/cv">My CV</a>
            <a href="/blog">Blog</a>
            <a href="/course">Course</a>
            <a href="/timeline">Timeline</a>
            <a href="/admin" class="footer-admin-link">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Admin Portal</span>
            </a>
            <a href="#" class="back-to-top">Top ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Toast Container -->
    <div id="space-toast-container" class="space-toast-container" aria-live="polite"></div>

    <!-- Admin Dock Mount Point for @admin_cms -->
    <div id="admin-dock-mount">
      <AdminLoginModal />
      <AdminDock />
      <AdminEditorModal />
    </div>

    <!-- Mobile Navigation Drawer Overlay Script & Global Toast System -->
    <script>
      // Admin Trigger Logic (Header trigger & Floating Dock trigger)
      function setupAdminTriggers() {
        const triggers = [
          document.getElementById('admin-header-trigger'),
          document.getElementById('dock-admin-trigger')
        ];

        triggers.forEach(btn => {
          if (!btn) return;
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            
            const modal = document.getElementById('admin-login-modal');
            const editorModal = document.getElementById('admin-editor-modal');
            const dock = document.getElementById('admin-floating-dock');
            
            // Dispatch custom event for reactive admin components
            window.dispatchEvent(new CustomEvent('open-admin-login'));

            try {
              // ponytail: strict session check for admin
              let auth = false;
              const sessionRaw = localStorage.getItem('space_portfolio_admin_session_v2');
              if (sessionRaw) {
                const s = JSON.parse(sessionRaw);
                auth = Boolean(s && s.user === 'admin' && s.authenticated === true);
              }

              if (auth && editorModal) {
                editorModal.classList.add('is-open');
              } else if (modal) {
                modal.classList.add('is-open');
                const userInput = modal.querySelector('input[type="text"]') as HTMLInputElement;
                const passInput = modal.querySelector('input[type="password"]') as HTMLInputElement;
                if (userInput) setTimeout(() => userInput.focus(), 150);
                else if (passInput) setTimeout(() => passInput.focus(), 150);
              } else if (window.location.pathname !== '/admin') {
                window.location.href = '/admin';
              }
            } catch (err) {
              if (modal) modal.classList.add('is-open');
            }
          });
        });
      }

      setupAdminTriggers();

      // Reactive Admin Status Indicator (from localStorage)
      function updateAdminStatusBadge() {
        const headerIndicator = document.getElementById('admin-status-indicator');
        const headerTrigger = document.getElementById('admin-header-trigger');
        const dockDot = document.getElementById('dock-admin-status-dot');
        const dockBtn = document.getElementById('dock-admin-trigger');

        try {
          // ponytail: strict session check for admin
          let auth = false;
          const sessionRaw = localStorage.getItem('space_portfolio_admin_session_v2');
          if (sessionRaw) {
            const s = JSON.parse(sessionRaw);
            auth = Boolean(s && s.user === 'admin' && s.authenticated === true);
          }

          if (auth) {
            if (headerIndicator) headerIndicator.classList.add('is-authenticated');
            if (headerTrigger) {
              headerTrigger.classList.add('is-auth-active');
              headerTrigger.title = "Admin Active (Click for Control Center)";
            }
            if (dockDot) dockDot.classList.add('is-authenticated');
            if (dockBtn) dockBtn.title = "Admin Active (Click to open studio)";
          } else {
            if (headerIndicator) headerIndicator.classList.remove('is-authenticated');
            if (headerTrigger) {
              headerTrigger.classList.remove('is-auth-active');
              headerTrigger.title = "Admin Control Center";
            }
            if (dockDot) dockDot.classList.remove('is-authenticated');
            if (dockBtn) dockBtn.title = "Admin Control Center";
          }
        } catch (e) {
          // ignore localStorage access issues
        }
      }

      updateAdminStatusBadge();
      window.addEventListener('admin-auth-changed', updateAdminStatusBadge);
      window.addEventListener('portfolio-admin-auth-changed', updateAdminStatusBadge);
      window.addEventListener('storage', updateAdminStatusBadge);

      // Global Space Toast Utility
      (window as any).showSpaceToast = function(title: string, desc: string, type: 'info' | 'success' | 'error' = 'info') {
        const container = document.getElementById('space-toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `space-toast ${type === 'success' ? 'toast-success' : type === 'error' ? 'toast-error' : ''}`;
        
        let iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
        if (type === 'success') {
          iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
        } else if (type === 'error') {
          iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
        }

        toast.innerHTML = `
          <div class="toast-icon">${iconSvg}</div>
          <div class="toast-content">
            <div class="toast-title">${title}</div>
            <div class="toast-desc">${desc}</div>
          </div>
        `;

        container.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('is-hiding');
          setTimeout(() => toast.remove(), 260);
        }, 3600);
      };
    </script>
  </body>
</html>

<style>
  /* ============================================================
     LAYOUT SPECIFIC STYLES & APPLE TOP HEADER / MAIN PADDING
     ============================================================ */

  .main-content {
    flex: 1;
    position: relative;
    z-index: 1;
    padding-bottom: 7rem; /* Clearance for floating bottom dock */
  }

  /* Frosted Apple Minimal Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    background-color: rgba(11, 13, 19, 0.78);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--transition-smooth), border-color var(--transition-smooth);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
    gap: 1.5rem;
  }

  /* Callsign Indicator */
  .header-callsign {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    user-select: none;
  }

  .callsign-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    animation: beaconPulse 2s ease-in-out infinite;
  }

  @keyframes beaconPulse {
    0%, 100% { transform: scale(0.9); opacity: 0.75; }
    50% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 10px #10B981; }
  }

  .callsign-name {
    color: #F3F4F6;
    font-weight: 700;
  }

  .callsign-sep {
    color: #8E95A5;
    opacity: 0.5;
  }

  .callsign-telemetry {
    color: #8E95A5;
    font-size: 0.6875rem;
  }

  @media (max-width: 640px) {
    .callsign-telemetry {
      display: none;
    }
  }

  .header-comms-btn {
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.95rem;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Admin Access Key Button */
  .admin-access-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    color: var(--titanium-light);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    position: relative;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .admin-access-btn:hover {
    background: var(--amber-dim);
    border-color: var(--amber-border);
    color: var(--amber-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(229, 169, 106, 0.18);
  }

  .admin-access-btn.is-auth-active {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
    color: var(--telemetry-green);
  }

  .admin-key-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .admin-btn-label {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .admin-status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--titanium);
    transition: background 0.2s ease;
  }

  .admin-status-indicator.is-authenticated {
    background: var(--telemetry-green);
    box-shadow: 0 0 6px var(--telemetry-green);
  }

  /* Engineering Footer */
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background-color: rgba(11, 13, 19, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 3.5rem 0 3.5rem;
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
  }

  .footer-telemetry {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--font-mono);
  }

  .telemetry-label {
    font-size: 0.6875rem;
    color: var(--titanium);
    letter-spacing: 0.08em;
  }

  .telemetry-val {
    font-size: 0.8125rem;
    color: var(--text-ivory);
    font-weight: 500;
  }

  .footer-divider {
    height: 1px;
    background: var(--border-subtle);
    margin-bottom: 2rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .footer-links a {
    color: var(--titanium-light);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--amber);
  }

  .footer-admin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--amber) !important;
  }

  .back-to-top {
    font-family: var(--font-mono);
    color: var(--amber) !important;
  }
</style>
