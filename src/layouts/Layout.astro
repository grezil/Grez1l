---
// Space Systems Engineer - Apple Frosted Cosmic Layout
import CosmicBackground from '../components/CosmicBackground.astro';
import CosmicLoader from '../components/CosmicLoader.astro';
import AdminLoginModal from '../components/AdminLoginModal.astro';
import AdminDock from '../components/AdminDock.astro';
import AdminEditorModal from '../components/AdminEditorModal.astro';
import '../styles/space-apple.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Võ Quang Nhật Nguyên (Nhat Nguyen Vo) | Space Systems & Flight Software Engineer | My CV",
  description = "Aerospace portfolio and Harvard-style Curriculum Vitae of a Flight Software & Space Systems Engineer specializing in CubeSats, avionics, real-time telemetry, and orbital mechanics."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCV = pathname.startsWith('/cv');
const isBlog = pathname.startsWith('/blog');
const isCourse = pathname.startsWith('/course') || pathname.startsWith('/courses');
const isTimeline = pathname.startsWith('/timeline');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Monospace Typography (JetBrains Mono & SF Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Lightweight Satellite SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛰️</text></svg>" />

    <script is:inline>
      if (typeof window !== 'undefined') {
        window.requestIdleCallback = window.requestIdleCallback || function(cb) { return setTimeout(cb, 1); };
        window.cancelIdleCallback = window.cancelIdleCallback || function(id) { clearTimeout(id); };
      }
    </script>

    <title>{title}</title>
  </head>
  <body>
    <!-- Apple-Grade Cosmic Space Loading Screen -->
    <CosmicLoader />

    <!-- 60FPS Ambient Starfield & Orbiting Satellite -->
    <CosmicBackground />

    <!-- Sleek Apple Minimalist Header (ponytail: simplified single brand header) -->
    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <a href="/" class="header-callsign" title="Website Portfolio Home">
          <span class="callsign-beacon"></span>
          <span class="callsign-name">WEBSITE PORTFOLIO</span>
        </a>
      </div>
    </header>

    <!-- Main Content Container Slot -->
    <main class="main-content" id="main-content">
      <slot />
    </main>

    <!-- Apple Floating Bottom Navigation Dock -->
    <nav class="floating-bottom-dock" id="floating-bottom-dock" aria-label="Floating Navigation Dock">
      <div class="floating-dock-pill">
        <a href="/" class={`dock-nav-item ${isHome ? 'active' : ''}`} data-tooltip="Overview & Profile" aria-current={isHome ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span class="dock-nav-label">Home</span>
        </a>

        <a href="/cv" class={`dock-nav-item ${isCV ? 'active' : ''}`} data-tooltip="My CV (PDF)" aria-current={isCV ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span class="dock-nav-label">My CV</span>
          <span class="dock-mini-badge">PDF</span>
        </a>

        <a href="/blog" class={`dock-nav-item ${isBlog ? 'active' : ''}`} data-tooltip="Flight Software & Astrodynamics Dispatches" aria-current={isBlog ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span class="dock-nav-label">Blog</span>
        </a>

        <a href="/course" class={`dock-nav-item ${isCourse ? 'active' : ''}`} data-tooltip="Academic & Teaching Dossier" aria-current={isCourse ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span class="dock-nav-label">Course</span>
        </a>

        <a href="/timeline" class={`dock-nav-item ${isTimeline ? 'active' : ''}`} data-tooltip="Orbital Heritage Timeline" aria-current={isTimeline ? 'page' : undefined}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span class="dock-nav-label">Timeline</span>
        </a>

        <div class="dock-nav-separator" aria-hidden="true"></div>

        <a href="mailto:grezil92@gmail.com" class="dock-nav-item" data-tooltip="Transmit Direct Comms">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span class="dock-nav-label">Contact</span>
        </a>

        <button type="button" class="dock-nav-item" id="dock-admin-trigger" title="Admin Control Center" aria-label="Admin Control Center">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="dock-nav-label">Admin</span>
          <span class="dock-status-dot" id="dock-admin-status-dot"></span>
        </button>
      </div>
    </nav>

    <!-- Space Systems Refined Engineering Footer -->
    <footer class="site-footer">
      <div class="container">
        <!-- ponytail: removed redundant telemetry block per request -->
        <div class="footer-bottom">
          <div class="footer-links">
            <a href="/">Home</a>
            <a href="/cv">My CV</a>
            <a href="/blog">Blog</a>
            <a href="/course">Course</a>
            <a href="/timeline">Timeline</a>
            <a href="#" class="back-to-top">Top ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Toast Container -->
    <div id="space-toast-container" class="space-toast-container" aria-live="polite"></div>

    <!-- Admin Dock Mount Point for @admin_cms -->
    <div id="admin-dock-mount">
      <AdminLoginModal />
      <AdminDock />
      <AdminEditorModal />
    </div>

    <!-- Mobile Navigation Drawer Overlay Script & Global Toast System -->
    <script>
      // ponytail: shared strict admin session check
      function isAdminAuthenticated(): boolean {
        try {
          const sessionRaw = localStorage.getItem('space_portfolio_admin_session_v2');
          if (!sessionRaw) return false;
          const s = JSON.parse(sessionRaw);
          return Boolean(s && s.user === 'admin' && s.authenticated === true);
        } catch (err) {
          return false;
        }
      }

      // ponytail: single Admin trigger inside #floating-bottom-dock
      function setupAdminTriggers() {
        const dockBtn = document.getElementById('dock-admin-trigger');
        if (!dockBtn) return;

        dockBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const auth = isAdminAuthenticated();
          const modal = document.getElementById('admin-login-modal');
          const editorModal = document.getElementById('admin-editor-modal');

          if (auth) {
            if (editorModal) {
              window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'cv' } }));
            } else if (window.location.pathname !== '/admin') {
              window.location.href = '/admin';
            }
            return;
          }

          window.dispatchEvent(new CustomEvent('open-admin-login'));
          if (modal) {
            modal.classList.add('is-open', 'is-active');
            modal.setAttribute('aria-hidden', 'false');
            const userInput = modal.querySelector('input[type="text"]') as HTMLInputElement | null;
            const passInput = modal.querySelector('input[type="password"]') as HTMLInputElement | null;
            if (userInput) setTimeout(() => userInput.focus(), 150);
            else if (passInput) setTimeout(() => passInput.focus(), 150);
          } else if (window.location.pathname !== '/admin') {
            window.location.href = '/admin';
          }
        });
      }

      setupAdminTriggers();

      // Reactive Admin Status Indicator (from localStorage)
      function updateAdminStatusBadge() {
        const dockDot = document.getElementById('dock-admin-status-dot');
        const dockBtn = document.getElementById('dock-admin-trigger');
        const auth = isAdminAuthenticated();

        if (dockDot) dockDot.classList.toggle('is-authenticated', auth);
        if (dockBtn) {
          dockBtn.title = auth
            ? 'Admin Active (Click to open studio)'
            : 'Admin Control Center';
        }
      }

      updateAdminStatusBadge();
      window.addEventListener('admin-auth-changed', updateAdminStatusBadge);
      window.addEventListener('portfolio-admin-auth-changed', updateAdminStatusBadge);
      window.addEventListener('storage', updateAdminStatusBadge);

      // Global Space Toast Utility
      (window as any).showSpaceToast = function(title: string, desc: string, type: 'info' | 'success' | 'error' = 'info') {
        const container = document.getElementById('space-toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `space-toast ${type === 'success' ? 'toast-success' : type === 'error' ? 'toast-error' : ''}`;
        
        let iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
        if (type === 'success') {
          iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
        } else if (type === 'error') {
          iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
        }

        toast.innerHTML = `
          <div class="toast-icon">${iconSvg}</div>
          <div class="toast-content">
            <div class="toast-title">${title}</div>
            <div class="toast-desc">${desc}</div>
          </div>
        `;

        container.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('is-hiding');
          setTimeout(() => toast.remove(), 260);
        }, 3600);
      };

      // ponytail: conflict-free weighted Apple smooth scroll (no blur filter, no CSS scroll-behavior fighting RAF)
      (function setupAppleScrollExperience() {
        if (typeof window === 'undefined') return;

        const root = document.documentElement;
        const header = document.querySelector('.site-header');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let headerScrolled = false;
        function syncHeaderScrollState() {
          if (!header) return;
          const nextScrolled = window.scrollY > 10;
          if (nextScrolled !== headerScrolled) {
            headerScrolled = nextScrolled;
            header.classList.toggle('is-scrolled', headerScrolled);
          }
        }
        syncHeaderScrollState();

        let rafId = 0;
        let isWheelSmooth = false;
        let targetScrollY = window.scrollY;
        let currentScrollY = window.scrollY;
        let lastFrameTime = 0;
        let lastContinuousWheelAt = 0;

        function stopSmoothScroll(syncPosition = true) {
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
          if (isWheelSmooth) {
            isWheelSmooth = false;
            root.style.scrollBehavior = '';
          }
          if (syncPosition) {
            targetScrollY = window.scrollY;
            currentScrollY = window.scrollY;
          }
        }

        function smoothScrollStep(now: number) {
          const dt = lastFrameTime ? Math.min(now - lastFrameTime, 32) : 16.667;
          lastFrameTime = now;

          const diff = targetScrollY - currentScrollY;
          if (Math.abs(diff) < 0.35) {
            window.scrollTo(0, Math.round(targetScrollY));
            stopSmoothScroll(true);
            syncHeaderScrollState();
            return;
          }

          // Frame-rate independent weighted ease (~0.10 per 60Hz frame)
          const factor = 1 - Math.pow(1 - 0.10, dt / 16.667);
          currentScrollY += diff * factor;
          window.scrollTo(0, currentScrollY);
          syncHeaderScrollState();
          rafId = requestAnimationFrame(smoothScrollStep);
        }

        function animateTo(nextTargetY: number) {
          const maxScroll = Math.max(0, root.scrollHeight - window.innerHeight);
          targetScrollY = Math.max(0, Math.min(maxScroll, nextTargetY));
          if (!isWheelSmooth) {
            isWheelSmooth = true;
            currentScrollY = window.scrollY;
            lastFrameTime = 0;
            root.style.scrollBehavior = 'auto';
            rafId = requestAnimationFrame(smoothScrollStep);
          }
        }

        function isTrackpadOrContinuous(e: WheelEvent): boolean {
          if (e.ctrlKey || Math.abs(e.deltaX) > 0) return true;
          if (e.deltaMode === 0) {
            const absY = Math.abs(e.deltaY);
            if (absY < 40 || !Number.isInteger(e.deltaY)) {
              lastContinuousWheelAt = performance.now();
              return true;
            }
            if (performance.now() - lastContinuousWheelAt < 280) {
              lastContinuousWheelAt = performance.now();
              return true;
            }
          }
          return false;
        }

        function hasScrollableContainerOrOpenModal(target: EventTarget | null, deltaY: number): boolean {
          if (window.getComputedStyle(document.body).overflowY === 'hidden') return true;
          if (
            document.querySelector(
              '.space-modal-backdrop.is-open, .admin-modal-backdrop.is-active, .admin-modal-backdrop.is-open, .editor-modal-backdrop.is-active, .reader-modal-overlay.is-open, .reader-modal-overlay.is-active, [role="dialog"][aria-hidden="false"]'
            )
          ) {
            return true;
          }

          let el = target instanceof Element ? target : null;
          while (el && el !== root && el !== document.body) {
            const overflowY = window.getComputedStyle(el).overflowY;
            if ((overflowY === 'auto' || overflowY === 'scroll' || overflowY === 'overlay') && el.scrollHeight > el.clientHeight + 1) {
              const atTop = el.scrollTop <= 0;
              const atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 1;
              if ((deltaY < 0 && !atTop) || (deltaY > 0 && !atBottom)) {
                return true;
              }
            }
            el = el.parentElement;
          }
          return false;
        }

        window.addEventListener('scroll', () => {
          syncHeaderScrollState();
          if (!isWheelSmooth) {
            targetScrollY = window.scrollY;
            currentScrollY = window.scrollY;
          }
        }, { passive: true });

        if (prefersReducedMotion) return;

        window.addEventListener('wheel', (e: WheelEvent) => {
          if (isTrackpadOrContinuous(e)) {
            stopSmoothScroll(true);
            return;
          }

          const delta = e.deltaMode === 1
            ? e.deltaY * 36
            : e.deltaMode === 2
              ? e.deltaY * window.innerHeight * 0.85
              : e.deltaY;

          if (!delta || hasScrollableContainerOrOpenModal(e.target, delta)) {
            return;
          }

          e.preventDefault();
          const baseY = isWheelSmooth ? targetScrollY : window.scrollY;
          animateTo(baseY + delta);
        }, { passive: false });

        // Cancel immediately on direct pointer, touch, scroll-key, or resize so there is zero stuck feeling
        window.addEventListener('pointerdown', () => stopSmoothScroll(true), { passive: true });
        window.addEventListener('touchstart', () => stopSmoothScroll(true), { passive: true });
        window.addEventListener('resize', () => stopSmoothScroll(true), { passive: true });
        window.addEventListener('keydown', (e: KeyboardEvent) => {
          if (
            e.key === 'ArrowUp' || e.key === 'ArrowDown' ||
            e.key === 'PageUp' || e.key === 'PageDown' ||
            e.key === 'Home' || e.key === 'End' ||
            e.key === ' '
          ) {
            stopSmoothScroll(true);
          }
        }, { passive: true });

        // Smooth scroll for Top ↑ and valid in-page anchor links
        document.addEventListener('click', (e: MouseEvent) => {
          if (e.defaultPrevented) return;
          const anchor = (e.target as Element | null)?.closest('a');
          if (!anchor) return;
          const href = anchor.getAttribute('href');
          if (!href) return;

          if (anchor.classList.contains('back-to-top') || href === '#top') {
            e.preventDefault();
            animateTo(0);
            return;
          }

          if (href.startsWith('#') && href.length > 1 && href !== '#admin-login') {
            const targetEl = document.getElementById(href.slice(1));
            if (targetEl) {
              e.preventDefault();
              const headerOffset = 72;
              const y = targetEl.getBoundingClientRect().top + window.scrollY - headerOffset;
              animateTo(y);
            }
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  /* ============================================================
     LAYOUT SPECIFIC STYLES & APPLE TOP HEADER / MAIN PADDING
     ============================================================ */

  .main-content {
    flex: 1;
    position: relative;
    z-index: 1;
    padding-bottom: 7rem; /* Clearance for floating bottom dock */
  }

  /* Frosted Apple Minimal Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background-color: rgba(11, 13, 19, 0.8);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color 0.2s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header.is-scrolled {
    background-color: rgba(11, 13, 19, 0.9);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.45);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
    gap: 1.5rem;
  }

  /* Callsign Indicator */
  .header-callsign {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    user-select: none;
  }

  .callsign-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 8px #10B981;
    animation: beaconPulse 2s ease-in-out infinite;
  }

  @keyframes beaconPulse {
    0%, 100% { transform: scale(0.9); opacity: 0.75; }
    50% { transform: scale(1.25); opacity: 1; }
  }

  .callsign-name {
    color: #F3F4F6;
    font-weight: 700;
  }

  /* Engineering Footer */
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background-color: rgba(11, 13, 19, 0.94);
    padding: 2.25rem 0;
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .footer-links a {
    color: var(--titanium-light);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--amber);
  }

  .back-to-top {
    font-family: var(--font-mono);
    color: var(--amber) !important;
  }
</style>
