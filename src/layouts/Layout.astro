---
// Space Systems Engineer - Apple Frosted Cosmic Layout
import CosmicBackground from '../components/CosmicBackground.astro';
import AdminLoginModal from '../components/AdminLoginModal.astro';
import AdminDock from '../components/AdminDock.astro';
import AdminEditorModal from '../components/AdminEditorModal.astro';
import '../styles/space-apple.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "VO QUANG NHAT NGUYEN (Nhat Nguyen Vo) | Space Systems & Flight Software Engineer | Harvard CV",
  description = "Aerospace portfolio and Harvard-style Curriculum Vitae of a Flight Software & Space Systems Engineer specializing in CubeSats, avionics, real-time telemetry, and orbital mechanics."
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCV = pathname.startsWith('/cv');
const isBlog = pathname.startsWith('/blog');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Monospace Typography (JetBrains Mono & SF Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Lightweight Satellite SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛰️</text></svg>" />

    <title>{title}</title>
  </head>
  <body>
    <!-- 60FPS Ambient Starfield & Orbiting Satellite -->
    <CosmicBackground />

    <!-- Sleek Apple Frosted Glass Header -->
    <header class="site-header" id="site-header">
      <div class="container header-inner">
        <!-- Desktop Segmented Apple Navigation -->
        <nav class="nav-menu" id="nav-menu" aria-label="Main Navigation">
          <div class="segmented-control">
            <a href="/" class={`segmented-item ${isHome ? 'active' : ''}`} aria-current={isHome ? 'page' : undefined}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Home</span>
            </a>

            <a href="/cv" class={`segmented-item ${isCV ? 'active-amber' : ''}`} aria-current={isCV ? 'page' : undefined}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              <span>Harvard CV</span>
              <span class="nav-mini-pill">PDF</span>
            </a>

            <a href="/blog" class={`segmented-item ${isBlog ? 'active' : ''}`} aria-current={isBlog ? 'page' : undefined}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <span>Mission Blog</span>
            </a>

            {isHome && (
              <a href="#achievements" class="segmented-item nav-anchor">
                <span>Distinctions</span>
              </a>
            )}

            {isHome && (
              <a href="#timeline" class="segmented-item nav-anchor">
                <span>Timeline</span>
              </a>
            )}
          </div>

          <!-- Direct Professional Contact Button -->
          <a href="mailto:nhatnguyen@orbital-flight.dev" class="btn btn-apple-primary btn-sm header-comms-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>Contact</span>
          </a>
        </nav>

        <!-- Header Actions: Admin Key Button & Mobile Hamburger -->
        <div class="header-actions">
          <!-- Admin Access Key Button -->
          <button
            id="admin-header-trigger"
            class="admin-access-btn"
            type="button"
            title="Admin Control Center (Passkey: apollo11)"
            aria-label="Admin Control Center"
          >
            <span class="admin-key-icon">
              <!-- Elegant Security Lock/Key SVG -->
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            <span class="admin-btn-label">Admin</span>
            <span class="admin-status-indicator" id="admin-status-indicator"></span>
          </button>

          <!-- Mobile Hamburger Toggle -->
          <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container Slot -->
    <main class="main-content" id="main-content">
      <slot />
    </main>

    <!-- Space Systems Refined Engineering Footer -->
    <footer class="site-footer">
      <div class="container">
        <!-- Telemetry Data Strip -->
        <div class="footer-telemetry">
          <div class="telemetry-item">
            <span class="telemetry-label">ORBITAL REGIME</span>
            <span class="telemetry-val">LEO 550KM // 51.6° INCLINATION</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">COMMUNICATION STANDARD</span>
            <span class="telemetry-val">CCSDS 2.2 GHz S-BAND // QPSK</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">ACADEMIC & INDUSTRY</span>
            <span class="telemetry-val">HARVARD // MIT // NASA HERITAGE</span>
          </div>
          <div class="telemetry-item">
            <span class="telemetry-label">SYSTEMS STATUS</span>
            <span class="telemetry-val text-amber">FLIGHT NOMINAL // ALL SUB-SYSTEMS GO</span>
          </div>
        </div>

        <div class="footer-divider"></div>

        <div class="footer-bottom">
          <div class="footer-brand-info">
            <p class="footer-copy">
              © {new Date().getFullYear()} Flight Software & Space Systems Engineer. Designed with Apple precision.
            </p>
            <p class="footer-note">
              Mission-critical embedded software • Real-time telemetry • Astrodynamics
            </p>
          </div>

          <div class="footer-links">
            <a href="/">Home</a>
            <a href="/cv">Harvard CV</a>
            <a href="/blog">Technical Blog</a>
            {isHome && <a href="#achievements">Distinctions</a>}
            {isHome && <a href="#timeline">Timeline</a>}
            <a href="/admin" class="footer-admin-link">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Admin Portal</span>
            </a>
            <a href="#" class="back-to-top">Top ↑</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Toast Container -->
    <div id="space-toast-container" class="space-toast-container" aria-live="polite"></div>

    <!-- Admin Dock Mount Point for @admin_cms -->
    <div id="admin-dock-mount">
      <AdminLoginModal />
      <AdminDock />
      <AdminEditorModal />
    </div>

    <!-- Mobile Navigation Drawer Overlay Script & Global Toast System -->
    <script>
      // Mobile Toggle Handling
      const toggle = document.getElementById('mobile-toggle');
      const menu = document.getElementById('nav-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          const isOpen = menu.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(isOpen));
          toggle.classList.toggle('active', isOpen);
        });

        // Close menu on link click
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.remove('is-open');
            toggle.classList.remove('active');
            toggle.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // Admin Access Button Handler
      const adminTrigger = document.getElementById('admin-header-trigger');
      if (adminTrigger) {
        adminTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          
          // Check if admin modal or dock is present in the DOM
          const modal = document.getElementById('admin-login-modal');
          const dock = document.getElementById('admin-dock');
          
          // Dispatch custom event for reactive admin components
          window.dispatchEvent(new CustomEvent('open-admin-login'));

          if (modal) {
            modal.classList.add('is-open');
            const passInput = modal.querySelector('input[type="password"]') as HTMLInputElement;
            if (passInput) setTimeout(() => passInput.focus(), 150);
          } else if (!dock && window.location.pathname !== '/admin') {
            // Smoothly navigate to dedicated /admin page if modal not in DOM
            window.location.href = '/admin';
          }
        });
      }

      // Reactive Admin Status Indicator (from localStorage)
      function updateAdminStatusBadge() {
        const indicator = document.getElementById('admin-status-indicator');
        const trigger = document.getElementById('admin-header-trigger');
        if (!indicator || !trigger) return;

        try {
          const auth = localStorage.getItem('astro_admin_auth') === 'true' || 
                       sessionStorage.getItem('astro_admin_auth') === 'true';
          if (auth) {
            indicator.classList.add('is-authenticated');
            trigger.classList.add('is-auth-active');
            trigger.title = "Admin Active (Click for Control Center)";
          } else {
            indicator.classList.remove('is-authenticated');
            trigger.classList.remove('is-auth-active');
            trigger.title = "Admin Control Center (Passkey: apollo11)";
          }
        } catch (e) {
          // ignore localStorage access issues
        }
      }

      updateAdminStatusBadge();
      window.addEventListener('admin-auth-changed', updateAdminStatusBadge);
      window.addEventListener('portfolio-admin-auth-changed', updateAdminStatusBadge);
      window.addEventListener('storage', updateAdminStatusBadge);

      // Global Space Toast Utility
      (window as any).showSpaceToast = function(title: string, desc: string, type: 'info' | 'success' | 'error' = 'info') {
        const container = document.getElementById('space-toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `space-toast ${type === 'success' ? 'toast-success' : type === 'error' ? 'toast-error' : ''}`;
        
        let iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
        if (type === 'success') {
          iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
        } else if (type === 'error') {
          iconSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`;
        }

        toast.innerHTML = `
          <div class="toast-icon">${iconSvg}</div>
          <div class="toast-content">
            <div class="toast-title">${title}</div>
            <div class="toast-desc">${desc}</div>
          </div>
        `;

        container.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('is-hiding');
          setTimeout(() => toast.remove(), 260);
        }, 3600);
      };
    </script>
  </body>
</html>

<style>
  /* ============================================================
     LAYOUT SPECIFIC STYLES & APPLE HEADER/FOOTER
     ============================================================ */

  .main-content {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  /* Frosted Apple Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    background-color: rgba(11, 13, 19, 0.76);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--transition-smooth), border-color var(--transition-smooth);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    height: var(--header-height);
  }

  /* Navigation Menu - Clean Centered Apple Bar */
  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 auto;
  }

  .nav-mini-pill {
    font-size: 0.625rem;
    padding: 1px 5px;
    border-radius: 9999px;
    background: rgba(229, 169, 106, 0.2);
    border: 1px solid rgba(229, 169, 106, 0.35);
    color: var(--amber-light);
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .header-comms-btn {
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.95rem;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: absolute;
    right: 1.5rem;
  }

  /* Admin Access Key Button */
  .admin-access-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    color: var(--titanium-light);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    position: relative;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .admin-access-btn:hover {
    background: var(--amber-dim);
    border-color: var(--amber-border);
    color: var(--amber-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(229, 169, 106, 0.18);
  }

  .admin-access-btn.is-auth-active {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
    color: var(--telemetry-green);
  }

  .admin-key-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .admin-btn-label {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .admin-status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--titanium);
    transition: background 0.2s ease;
  }

  .admin-status-indicator.is-authenticated {
    background: var(--telemetry-green);
    box-shadow: 0 0 6px var(--telemetry-green);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 6px;
    transition: background var(--transition-fast);
  }

  .hamburger-bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-ivory);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  @media (max-width: 920px) {
    .header-inner {
      justify-content: flex-end;
    }

    .header-actions {
      position: static;
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-menu {
      display: none;
      position: absolute;
      top: var(--header-height);
      left: 0;
      right: 0;
      background-color: rgba(11, 13, 19, 0.96);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid var(--border-subtle);
      flex-direction: column;
      padding: 1.5rem;
      gap: 1rem;
      align-items: stretch;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    .nav-menu.is-open {
      display: flex;
    }

    .nav-menu .segmented-control {
      flex-direction: column;
      width: 100%;
      border-radius: var(--radius-md);
    }

    .nav-menu .segmented-item {
      width: 100%;
      justify-content: flex-start;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
    }

    .mobile-toggle.active .hamburger-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .mobile-toggle.active .hamburger-bar:nth-child(2) {
      opacity: 0;
    }
    .mobile-toggle.active .hamburger-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  /* Engineering Footer */
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background-color: rgba(11, 13, 19, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 3.5rem 0 2.25rem;
    position: relative;
    z-index: 1;
  }

  .footer-telemetry {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .telemetry-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--font-mono);
  }

  .telemetry-label {
    font-size: 0.6875rem;
    color: var(--titanium);
    letter-spacing: 0.08em;
  }

  .telemetry-val {
    font-size: 0.8125rem;
    color: var(--text-ivory);
    font-weight: 500;
  }

  .footer-divider {
    height: 1px;
    background: var(--border-subtle);
    margin-bottom: 2rem;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-brand-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-copy {
    color: var(--titanium-light);
    font-size: 0.8125rem;
  }

  .footer-note {
    color: var(--titanium);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--titanium-light);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--amber);
  }

  .footer-admin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--amber) !important;
  }

  .back-to-top {
    font-family: var(--font-mono);
    color: var(--amber) !important;
  }
</style>
