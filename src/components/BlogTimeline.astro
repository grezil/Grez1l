  }

  .dispatch-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .author-micro {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-badge-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #1a2234;
    border: 1px solid rgba(239, 68, 68, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: #F87171;
  }

  .author-label {
    font-size: 0.75rem;
    color: #CBD5E1;
  }

  .dispatch-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: #FFFFFF;
    text-decoration: none;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    background: rgba(239, 68, 68, 0.18);
    border: 1px solid rgba(239, 68, 68, 0.48);
    transition: all 0.2s ease;
  }

  .dispatch-link-btn:hover {
    background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
    border-color: #F87171;
    color: #FFFFFF;
    transform: translateX(2px);
  }

