    flex-direction: column;
    gap: 0.75rem;
  }
</style>

<script>
  function setupAdminEditorModal() {
    const modal = document.getElementById('admin-editor-modal');
    if (!modal) return;

    const closeBtn = document.getElementById('editor-modal-close');
    const tabs = document.querySelectorAll('.segment-tab');
    const panels = document.querySelectorAll('.editor-tab-panel');

    // Helper to get store
    async function getStore() {
      try {
        const storeModule = await import('../scripts/store.js');
        return storeModule;
      } catch (e) {
        console.warn('Could not import store.js directly:', e);
        return null;
      }
    }

    function switchTab(tabId: string) {
      tabs.forEach(t => {
        const matches = t.getAttribute('data-tab') === tabId;
        t.classList.toggle('is-active', matches);
        t.setAttribute('aria-selected', matches ? 'true' : 'false');
      });

      panels.forEach(p => {
        p.classList.toggle('is-active', p.id === tabId);
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        if (target) switchTab(target);
      });
    });

    function openModal(defaultTab?: string) {
      // ponytail: guard editor modal behind verified admin session
      let isAuthed = false;
      try {
        const raw = localStorage.getItem('space_portfolio_admin_session_v2');
        if (raw) {
          const s = JSON.parse(raw);
          isAuthed = Boolean(s && s.user === 'admin' && s.authenticated === true);
        }
      } catch (e) {}

      if (!isAuthed) {
        const loginModal = document.getElementById('admin-login-modal');
        if (loginModal) {
          loginModal.classList.add('is-open', 'is-active');
          loginModal.setAttribute('aria-hidden', 'false');
          const userInput = loginModal.querySelector('input[type="text"]') as HTMLInputElement;
          if (userInput) setTimeout(() => userInput.focus(), 150);
        } else if (window.location.pathname !== '/admin') {
          window.location.href = '/admin';
        }
        return;
      }

      modal?.classList.add('is-active');
      modal?.setAttribute('aria-hidden', 'false');
      if (defaultTab) {
        switchTab(`tab-${defaultTab}`);
      }
      refreshAllData();
    }

    function closeModal() {
      modal?.classList.remove('is-active');
      modal?.setAttribute('aria-hidden', 'true');
    }

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal();
      }
    });

    // Listen for custom open event
    window.addEventListener('open-admin-editor', (e: any) => {
      const tab = e.detail?.tab || 'achievement';
      openModal(tab);
    });

    // ----------------------------------------------------
    // TAB 1: ACHIEVEMENTS LOGIC
    // ----------------------------------------------------
    const achForm = document.getElementById('achievement-form') as HTMLFormElement;
    const achIdInput = document.getElementById('achievement-id-input') as HTMLInputElement;
    const achTitleInput = document.getElementById('achievement-title-input') as HTMLInputElement;
    const achDateInput = document.getElementById('achievement-date-input') as HTMLInputElement;
    const achCatSelect = document.getElementById('achievement-category-select') as HTMLSelectElement;
    const achOrgInput = document.getElementById('achievement-org-input') as HTMLInputElement;
    const achMetricsInput = document.getElementById('achievement-metrics-input') as HTMLInputElement;
    const achDescInput = document.getElementById('achievement-desc-input') as HTMLTextAreaElement;
    const achTagsInput = document.getElementById('achievement-tags-input') as HTMLInputElement;
    const achListContainer = document.getElementById('achievement-list-container');
    const achCountBadge = document.getElementById('achievement-count-badge');
    const achNewBtn = document.getElementById('achievement-new-btn');

    function resetAchForm() {
      achIdInput.value = '';
      achTitleInput.value = '';
      achDateInput.value = '';
      achCatSelect.value = 'Flight Heritage';
      achOrgInput.value = '';
      achMetricsInput.value = '';
      achDescInput.value = '';
      achTagsInput.value = '';
      const submitBtn = document.getElementById('achievement-save-btn');
      if (submitBtn) submitBtn.querySelector('span')!.textContent = 'Save Achievement';
    }

    achNewBtn?.addEventListener('click', resetAchForm);

    async function loadAchievements() {
      if (!achListContainer) return;
      const store = await getStore();
      let list: any[] = [];
      if (store && typeof store.getAchievements === 'function') {
        list = store.getAchievements();
      } else {
        const raw = localStorage.getItem('portfolio_achievements');
        list = raw ? JSON.parse(raw) : [];
      }

      if (achCountBadge) achCountBadge.textContent = `${list.length} entries`;

      if (list.length === 0) {
        achListContainer.innerHTML = `<div style="text-align:center; padding:1.5rem; color:#8E95A5; font-size:0.84rem;">No achievements recorded yet. Add your first above!</div>`;
        return;
      }

      achListContainer.innerHTML = list.map((item: any, idx: number) => {
        const id = item.id || `ach-${idx}`;
        return `
          <div class="inventory-card" data-id="${id}">
            <div class="inv-card-left">
              <h5 class="inv-card-title">${item.title || 'Untitled Achievement'}</h5>
              <div class="inv-card-meta">
                <span style="color:#E5A96A;">${item.date || item.timeline || 'Date N/A'}</span>
                <span>•</span>
                <span>${item.category || 'General'}</span>
                ${item.organization ? `<span>•</span><span>${item.organization}</span>` : ''}
              </div>
            </div>
            <div class="inv-card-actions">
              <button type="button" class="btn-inv-edit" data-edit-ach="${id}">Edit</button>
              <button type="button" class="btn-inv-delete" data-delete-ach="${id}">Delete</button>
            </div>
          </div>
        `;
      }).join('');

      // Wire edit buttons
      achListContainer.querySelectorAll('[data-edit-ach]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-edit-ach');
          const target = list.find((it: any) => (it.id || '') === id || `ach-${list.indexOf(it)}` === id);
          if (target) {
            achIdInput.value = target.id || id || '';
            achTitleInput.value = target.title || '';
            achDateInput.value = target.date || target.timeline || '';
            achCatSelect.value = target.category || 'Flight Heritage';
            achOrgInput.value = target.organization || '';
            achMetricsInput.value = target.metrics || target.metric || '';
            achDescInput.value = target.description || target.summary || '';
            achTagsInput.value = Array.isArray(target.tags) ? target.tags.join(', ') : (target.tags || '');
            const submitBtn = document.getElementById('achievement-save-btn');
            if (submitBtn) submitBtn.querySelector('span')!.textContent = 'Update Achievement';
            achForm.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // Wire delete buttons
      achListContainer.querySelectorAll('[data-delete-ach]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-delete-ach');
          if (!confirm('Are you sure you want to delete this achievement?')) return;
          const store = await getStore();
          if (store && typeof store.deleteAchievement === 'function') {
            store.deleteAchievement(id);
          } else {
            const filtered = list.filter((it: any, i: number) => (it.id || `ach-${i}`) !== id);
            localStorage.setItem('portfolio_achievements', JSON.stringify(filtered));
            window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
          }
          window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Achievement deleted' } }));
          loadAchievements();
        });
      });
    }

    achForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = achIdInput.value || `ach-${Date.now()}`;
      const payload = {
        id,
        title: achTitleInput.value.trim(),
        date: achDateInput.value.trim(),
        timeline: achDateInput.value.trim(),
        category: achCatSelect.value,
        organization: achOrgInput.value.trim(),
        metrics: achMetricsInput.value.trim(),
        description: achDescInput.value.trim(),
        tags: achTagsInput.value.split(',').map(t => t.trim()).filter(Boolean),
      };

      const store = await getStore();
      if (achIdInput.value) {
        // Update
        if (store && typeof store.updateAchievement === 'function') {
          store.updateAchievement(id, payload);
        } else {
          // fallback
          let rawList = JSON.parse(localStorage.getItem('portfolio_achievements') || '[]');
          const idx = rawList.findIndex((item: any) => item.id === id);
          if (idx >= 0) rawList[idx] = payload; else rawList.push(payload);
          localStorage.setItem('portfolio_achievements', JSON.stringify(rawList));
          window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
        }
        window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Achievement updated successfully' } }));
      } else {
        // Add new
        if (store && typeof store.addAchievement === 'function') {
          store.addAchievement(payload);
        } else {
          let rawList = JSON.parse(localStorage.getItem('portfolio_achievements') || '[]');
          rawList.unshift(payload);
          localStorage.setItem('portfolio_achievements', JSON.stringify(rawList));
          window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
        }
        window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'New achievement added to timeline!' } }));
      }

      resetAchForm();
      loadAchievements();
    });

    // ----------------------------------------------------
    // TAB 2: BLOG COMPOSER LOGIC
    // ----------------------------------------------------
    const blogForm = document.getElementById('blog-form') as HTMLFormElement;
    const blogIdInput = document.getElementById('blog-id-input') as HTMLInputElement;
    const blogTitleInput = document.getElementById('blog-title-input') as HTMLInputElement;
    const blogSlugInput = document.getElementById('blog-slug-input') as HTMLInputElement;
    const blogDateInput = document.getElementById('blog-date-input') as HTMLInputElement;
    const blogReadtimeInput = document.getElementById('blog-readtime-input') as HTMLInputElement;
    const blogTagsInput = document.getElementById('blog-tags-input') as HTMLInputElement;
    const blogExcerptInput = document.getElementById('blog-excerpt-input') as HTMLTextAreaElement;
    const blogContentInput = document.getElementById('blog-content-input') as HTMLTextAreaElement;
    const blogListContainer = document.getElementById('blog-list-container');
    const blogCountBadge = document.getElementById('blog-count-badge');
    const blogNewBtn = document.getElementById('blog-new-btn');

    // Auto-generate slug from title
    blogTitleInput?.addEventListener('input', () => {
      if (!blogIdInput.value) {
        blogSlugInput.value = blogTitleInput.value
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }
    });

    // Markdown quick toolbar helpers
    document.querySelectorAll('.tool-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tool = btn.getAttribute('data-tool');
        if (!blogContentInput) return;
        const start = blogContentInput.selectionStart;
        const end = blogContentInput.selectionEnd;
        const sel = blogContentInput.value.substring(start, end);
        let replacement = '';

        if (tool === 'h2') replacement = `\n## ${sel || 'Section Heading'}\n`;
        else if (tool === 'bold') replacement = `**${sel || 'bold text'}**`;
        else if (tool === 'italic') replacement = `*${sel || 'italic text'}*`;
        else if (tool === 'code') replacement = `\`${sel || 'code'}\``;
        else if (tool === 'bullet') replacement = `\n- ${sel || 'List item'}\n`;

        blogContentInput.setRangeText(replacement, start, end, 'end');
        blogContentInput.focus();
      });
    });

    function resetBlogForm() {
      blogIdInput.value = '';
      blogTitleInput.value = '';
      blogSlugInput.value = '';
      blogDateInput.value = new Date().toISOString().split('T')[0];
      blogReadtimeInput.value = '5 min read';
      blogTagsInput.value = '';
      blogExcerptInput.value = '';
      blogContentInput.value = '';
      const submitBtn = document.getElementById('blog-save-btn');
      if (submitBtn) submitBtn.querySelector('span')!.textContent = 'Publish / Update Article';
    }

    blogNewBtn?.addEventListener('click', resetBlogForm);

    async function loadBlogs() {
      if (!blogListContainer) return;
      const store = await getStore();
      let list: any[] = [];
      if (store && typeof store.getBlogs === 'function') {
        list = store.getBlogs();
      } else {
        const raw = localStorage.getItem('portfolio_blogs');
        list = raw ? JSON.parse(raw) : [];
      }

      if (blogCountBadge) blogCountBadge.textContent = `${list.length} articles`;

      if (list.length === 0) {
        blogListContainer.innerHTML = `<div style="text-align:center; padding:1.5rem; color:#8E95A5; font-size:0.84rem;">No articles published yet. Compose your first flight post!</div>`;
        return;
      }

      blogListContainer.innerHTML = list.map((b: any, idx: number) => {
        const id = b.id || b.slug || `blog-${idx}`;
        return `
          <div class="inventory-card" data-id="${id}">
            <div class="inv-card-left">
              <h5 class="inv-card-title">${b.title || 'Untitled Article'}</h5>
              <div class="inv-card-meta">
                <span style="color:#E5A96A;">${b.date || 'Recent'}</span>
                <span>•</span>
                <span>${b.readTime || '5 min read'}</span>
                <span>•</span>
                <span>/${b.slug || ''}</span>
              </div>
            </div>
            <div class="inv-card-actions">
              <button type="button" class="btn-inv-edit" data-edit-blog="${id}">Edit</button>
              <button type="button" class="btn-inv-delete" data-delete-blog="${id}">Delete</button>
            </div>
          </div>
        `;
      }).join('');

      // Wire edit
      blogListContainer.querySelectorAll('[data-edit-blog]').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-edit-blog');
          const target = list.find((item: any) => (item.id || item.slug) === id || `blog-${list.indexOf(item)}` === id);
          if (target) {
            blogIdInput.value = target.id || target.slug || id || '';
            blogTitleInput.value = target.title || '';
            blogSlugInput.value = target.slug || '';
            blogDateInput.value = target.date || '';
            blogReadtimeInput.value = target.readTime || '5 min read';
            blogTagsInput.value = Array.isArray(target.tags) ? target.tags.join(', ') : (target.tags || '');
            blogExcerptInput.value = target.excerpt || target.summary || '';
            blogContentInput.value = target.content || '';
            const submitBtn = document.getElementById('blog-save-btn');
            if (submitBtn) submitBtn.querySelector('span')!.textContent = 'Update Article';
            blogForm.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // Wire delete
      blogListContainer.querySelectorAll('[data-delete-blog]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-delete-blog');
          if (!confirm('Are you sure you want to delete this blog post?')) return;
          const store = await getStore();
          if (store && typeof store.deleteBlog === 'function') {
            store.deleteBlog(id);
          } else {
            const filtered = list.filter((item: any, i: number) => (item.id || item.slug || `blog-${i}`) !== id);
            localStorage.setItem('portfolio_blogs', JSON.stringify(filtered));
            window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
          }
          window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Blog article removed' } }));
          loadBlogs();
        });
      });
    }

    blogForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = blogIdInput.value || blogSlugInput.value || `blog-${Date.now()}`;
      const payload = {
        id,
        title: blogTitleInput.value.trim(),
        slug: blogSlugInput.value.trim(),
        date: blogDateInput.value || new Date().toISOString().split('T')[0],
        readTime: blogReadtimeInput.value.trim() || '5 min read',
        tags: blogTagsInput.value.split(',').map(t => t.trim()).filter(Boolean),
        summary: blogExcerptInput.value.trim(),
        excerpt: blogExcerptInput.value.trim(),
        content: blogContentInput.value.trim(),
      };

      const store = await getStore();
      if (blogIdInput.value) {
        if (store && typeof store.updateBlog === 'function') {
          store.updateBlog(id, payload);
        } else {
          let rawList = JSON.parse(localStorage.getItem('portfolio_blogs') || '[]');
          const idx = rawList.findIndex((item: any) => item.id === id || item.slug === id);
          if (idx >= 0) rawList[idx] = payload; else rawList.push(payload);
          localStorage.setItem('portfolio_blogs', JSON.stringify(rawList));
          window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
        }
        window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Blog article updated successfully' } }));
      } else {
        if (store && typeof store.addBlog === 'function') {
          store.addBlog(payload);
        } else {
          let rawList = JSON.parse(localStorage.getItem('portfolio_blogs') || '[]');
          rawList.unshift(payload);
          localStorage.setItem('portfolio_blogs', JSON.stringify(rawList));
          window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
        }
        window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'New article published to Mission Log!' } }));
      }

      resetBlogForm();
      loadBlogs();
    });

    // ----------------------------------------------------
    // TAB 3: HARVARD CV STUDIO LOGIC & WORD DOCUMENT EDITOR
    // ----------------------------------------------------
    const cvForm = document.getElementById('cv-editor-form') as HTMLFormElement;
    const cvNameInput = document.getElementById('cv-name-input') as HTMLInputElement;
    const cvCallsignInput = document.getElementById('cv-callsign-input') as HTMLInputElement;
    const cvLocationInput = document.getElementById('cv-location-input') as HTMLInputElement;
    const cvTitleInput = document.getElementById('cv-title-input') as HTMLInputElement;
    const cvClearanceInput = document.getElementById('cv-clearance-input') as HTMLInputElement;
    const cvTaglineInput = document.getElementById('cv-tagline-input') as HTMLInputElement;
    const cvBioInput = document.getElementById('cv-bio-input') as HTMLTextAreaElement;

    const cvExpContainer = document.getElementById('cv-experience-list');
    const cvEduContainer = document.getElementById('cv-education-list');

    // Dual Mode Switcher
    const cvModeFormBtn = document.getElementById('cv-mode-form-btn');
    const cvModeDocBtn = document.getElementById('cv-mode-doc-btn');
    const cvWordEditorPanel = document.getElementById('cv-word-editor-panel');

    // Avatar Controls
    const cvAvatarPreviewImg = document.getElementById('cv-avatar-preview-img') as HTMLImageElement;
    const cvAvatarFallback = document.getElementById('cv-avatar-fallback');
    const cvAvatarFileInput = document.getElementById('cv-avatar-file-input') as HTMLInputElement;
    const cvAvatarUrlInput = document.getElementById('cv-avatar-url-input') as HTMLInputElement;
    const cvAvatarLoadUrlBtn = document.getElementById('cv-avatar-load-url-btn');
    const cvAvatarResetBtn = document.getElementById('cv-avatar-reset-btn');

    // Word Document Canvas & Toolbar
    const cvWordDocCanvas = document.getElementById('cv-word-document-canvas');
    const cvDocWordCount = document.getElementById('cv-doc-word-count');
    const cvWordSaveBtn = document.getElementById('cv-word-save-btn');
    const wordBlockSelect = document.getElementById('word-block-select') as HTMLSelectElement;

    let currentExpList: any[] = [];
    let currentEduList: any[] = [];

    // Switch between Structured Form and Word Editor
    function setCVMode(mode: 'form' | 'word') {
      if (mode === 'form') {
        cvModeFormBtn?.classList.add('is-active');
        cvModeDocBtn?.classList.remove('is-active');
        if (cvForm) cvForm.style.display = 'flex';
        if (cvWordEditorPanel) cvWordEditorPanel.style.display = 'none';
      } else {
        cvModeDocBtn?.classList.add('is-active');
        cvModeFormBtn?.classList.remove('is-active');
        if (cvForm) cvForm.style.display = 'none';
        if (cvWordEditorPanel) cvWordEditorPanel.style.display = 'block';
        loadWordDocument();
      }
    }

    cvModeFormBtn?.addEventListener('click', () => setCVMode('form'));
    cvModeDocBtn?.addEventListener('click', () => setCVMode('word'));

    // Update Avatar Preview
    function setAvatarPreview(url: string | null) {
      if (url && url.trim()) {
        if (cvAvatarPreviewImg) {
          cvAvatarPreviewImg.src = url;
          cvAvatarPreviewImg.style.display = 'block';
        }
        if (cvAvatarFallback) cvAvatarFallback.style.display = 'none';
        if (cvAvatarUrlInput) cvAvatarUrlInput.value = url.startsWith('data:') ? '' : url;
      } else {
        if (cvAvatarPreviewImg) {
          cvAvatarPreviewImg.src = '';
          cvAvatarPreviewImg.style.display = 'none';
        }
        if (cvAvatarFallback) cvAvatarFallback.style.display = 'block';
        if (cvAvatarUrlInput) cvAvatarUrlInput.value = '';
      }
    }

    async function saveAvatar(avatarUrlOrData: string) {
      const store = await getStore();
      if (store && typeof store.updateProfileAvatar === 'function') {
        store.updateProfileAvatar(avatarUrlOrData);
      } else if (store && typeof store.updateCVData === 'function') {
        const current = store.getCVData();
        const p = current.profile || {};
        p.avatar = avatarUrlOrData;
        store.updateCVData('profile', p);
      } else {
        localStorage.setItem('portfolio_profile_avatar', avatarUrlOrData);
        window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
      }
      setAvatarPreview(avatarUrlOrData);
      window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Profile photo updated successfully!' } }));
    }

    // Avatar File Upload
    cvAvatarFileInput?.addEventListener('change', () => {
      const file = cvAvatarFileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (e) => {
        const base64 = e.target?.result as string;
        if (base64) {
          await saveAvatar(base64);
        }
      };
      reader.readAsDataURL(file);
    });

    // Avatar URL Input
    cvAvatarLoadUrlBtn?.addEventListener('click', async () => {
      const url = cvAvatarUrlInput?.value?.trim() || '';
      if (!url) {
        alert('Please enter a valid image URL');
        return;
      }
      await saveAvatar(url);
    });

    // Avatar Presets
    document.querySelectorAll('.preset-pill').forEach(pill => {
      pill.addEventListener('click', async () => {
        const preset = pill.getAttribute('data-preset');
        let presetUrl = '';
        if (preset === 'astronaut') {
          presetUrl = 'https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?w=300&auto=format&fit=crop&q=80';
        } else if (preset === 'spacecraft') {
          presetUrl = 'https://images.unsplash.com/photo-1506703719100-a0f3a48c0f86?w=300&auto=format&fit=crop&q=80';
        } else {
          presetUrl = 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=300&auto=format&fit=crop&q=80';
        }
        await saveAvatar(presetUrl);
      });
    });

    // Avatar Reset
    cvAvatarResetBtn?.addEventListener('click', async () => {
      await saveAvatar('');
    });

    // Word Document Toolbar Execution
    document.querySelectorAll('[data-doc-cmd]').forEach(btn => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-doc-cmd');
        const val = btn.getAttribute('data-val') || '';
        if (!cmd) return;
        document.execCommand(cmd, false, val);
        cvWordDocCanvas?.focus();
        updateWordCount();
      });
    });

    wordBlockSelect?.addEventListener('change', () => {
      const val = wordBlockSelect.value;
      if (val) {
        document.execCommand('formatBlock', false, val);
        cvWordDocCanvas?.focus();
        updateWordCount();
      }
    });

    function updateWordCount() {
      if (!cvWordDocCanvas || !cvDocWordCount) return;
      const text = cvWordDocCanvas.innerText || '';
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      cvDocWordCount.textContent = `${words} words`;
    }

    cvWordDocCanvas?.addEventListener('input', updateWordCount);

    // Load Word Document Canvas content
    async function loadWordDocument() {
      if (!cvWordDocCanvas) return;
      const store = await getStore();
      let html = '';
      if (store && typeof store.getCVDocumentHtml === 'function') {
        html = store.getCVDocumentHtml();
      }

      if (!html) {
        // Generate formatted Harvard CV HTML
        const cv = store && typeof store.getCVData === 'function' ? store.getCVData() : {};
        const p = cv.profile || {};
        const expList = cv.experience || cv.timeline || [];
        const eduList = cv.education || [];

        html = `
          <div style="text-align:center; border-bottom:1px solid #E5A96A; padding-bottom:1rem; margin-bottom:1.5rem;">
            <h1 style="color:#FFFFFF; font-size:1.6rem; margin-bottom:0.25rem;">${p.name || 'Võ Quang Nhật Nguyên'}</h1>
            <p style="color:#E5A96A; font-weight:600; margin:0;">${p.title || 'Space Systems & Flight Software Architect'} [${p.callsign || 'NHAT-NGUYEN'}]</p>
            <p style="color:#8E95A5; font-size:0.85rem; margin-top:0.35rem;">${p.location || 'Pasadena, CA'} • Clearance: ${p.clearance || 'Public Trust / NASA Heritage'}</p>
          </div>

          <h2>EXECUTIVE BIO & HARVARD SUMMARY</h2>
          <hr/>
          <p>${p.bio || 'Dual-specialist in aerospace engineering and deterministic real-time flight software.'}</p>

          <h2>PROFESSIONAL APPOINTMENTS & EXPERIENCE</h2>
          <hr/>
          ${expList.map((e: any) => `
            <div style="margin-bottom:1rem;">
              <h3 style="color:#FFFFFF; margin-bottom:0.2rem;">${e.role || 'Flight Engineer'} • <span style="color:#E5A96A;">${e.organization || ''}</span></h3>
              <p style="color:#8E95A5; font-size:0.82rem; margin:0;">${e.period || ''} | ${e.location || 'LEO Operations'} | <i>${e.badge || ''}</i></p>
              <p style="margin-top:0.35rem;">${e.summary || ''}</p>
              <ul>
                ${(Array.isArray(e.highlights) ? e.highlights : [e.highlights || '']).map((h: string) => `<li>${h}</li>`).join('')}
              </ul>
            </div>
          `).join('')}

          <h2>ACADEMIC BACKGROUND & DEGREES</h2>
          <hr/>
          ${eduList.map((ed: any) => `
            <div style="margin-bottom:0.85rem;">
              <h3 style="color:#FFFFFF; margin-bottom:0.15rem;">${ed.degree || ''} — <span style="color:#E5A96A;">${ed.institution || ''}</span></h3>
              <p style="color:#8E95A5; font-size:0.82rem; margin:0;">${ed.period || ''} | Honors: ${ed.honors || 'High Honors'}</p>
              ${ed.thesis ? `<p style="margin-top:0.25rem; font-style:italic;">Thesis: "${ed.thesis}"</p>` : ''}
            </div>
          `).join('')}
        `;
      }

      cvWordDocCanvas.innerHTML = html;
      updateWordCount();
    }

    // Save Word Document Canvas
    cvWordSaveBtn?.addEventListener('click', async () => {
      if (!cvWordDocCanvas) return;
      const html = cvWordDocCanvas.innerHTML;
      const store = await getStore();

      if (store && typeof store.updateCVDocumentHtml === 'function') {
        store.updateCVDocumentHtml(html);
      } else if (store && typeof store.updateCVData === 'function') {
        store.updateCVData('cvDocumentHtml', html);
      } else {
        localStorage.setItem('portfolio_cv_doc_html', html);
        window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
      }

      window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Word Document CV updated & synced successfully!' } }));
    });

    async function loadCVData() {
      const store = await getStore();
      let cvData: any = null;
      if (store && typeof store.getCVData === 'function') {
        cvData = store.getCVData();
      } else {
        const raw = localStorage.getItem('portfolio_cv');
        cvData = raw ? JSON.parse(raw) : null;
      }

      if (!cvData) return;

      const prof = cvData.profile || {};
      if (cvNameInput) cvNameInput.value = prof.name || '';
      if (cvCallsignInput) cvCallsignInput.value = prof.callsign || '';
      if (cvLocationInput) cvLocationInput.value = prof.location || '';
      if (cvTitleInput) cvTitleInput.value = prof.title || '';
      if (cvClearanceInput) cvClearanceInput.value = prof.clearance || '';
      if (cvTaglineInput) cvTaglineInput.value = prof.tagline || '';
      if (cvBioInput) cvBioInput.value = prof.bio || '';

      // Load avatar
      let avatar = prof.avatar;
      if (!avatar && store && typeof store.getProfileAvatar === 'function') {
        avatar = store.getProfileAvatar();
      }
      setAvatarPreview(avatar);

      currentExpList = cvData.experience || cvData.timeline || [];
      currentEduList = cvData.education || [];

      renderExperienceRepeater();
      renderEducationRepeater();
    }

    function renderExperienceRepeater() {
      if (!cvExpContainer) return;
      cvExpContainer.innerHTML = currentExpList.map((exp, idx) => `
        <div class="repeater-item" data-idx="${idx}">
          <button type="button" class="repeater-remove-btn" data-remove-exp="${idx}">Remove</button>
          <div class="form-row form-row-2">
            <div class="form-field">
              <label class="field-label">Role Title</label>
              <input type="text" class="editor-input exp-role font-mono" value="${exp.role || ''}" placeholder="e.g. Lead Flight Software Engineer" />
            </div>
            <div class="form-field">
              <label class="field-label">Organization</label>
              <input type="text" class="editor-input exp-org font-mono" value="${exp.organization || ''}" placeholder="e.g. Astraea Space Labs" />
            </div>
          </div>
          <div class="form-row form-row-2" style="margin-top:0.5rem;">
            <div class="form-field">
              <label class="field-label">Period / Dates</label>
              <input type="text" class="editor-input exp-period font-mono" value="${exp.period || ''}" placeholder="e.g. 2023 — Present" />
            </div>
            <div class="form-field">
              <label class="field-label">Location / Badge</label>
              <input type="text" class="editor-input exp-badge font-mono" value="${exp.badge || exp.location || ''}" placeholder="e.g. Mission Flight Heritage" />
            </div>
          </div>
          <div class="form-field" style="margin-top:0.5rem;">
            <label class="field-label">Summary</label>
            <textarea rows="2" class="editor-textarea exp-summary font-mono">${exp.summary || ''}</textarea>
          </div>
          <div class="form-field" style="margin-top:0.5rem;">
            <label class="field-label">Harvard Action Highlights (one bullet per line)</label>
            <textarea rows="3" class="editor-textarea exp-highlights font-mono">${Array.isArray(exp.highlights) ? exp.highlights.join('\n') : (exp.highlights || '')}</textarea>
          </div>
        </div>
      `).join('');

      cvExpContainer.querySelectorAll('[data-remove-exp]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-remove-exp') || '0', 10);
          currentExpList.splice(idx, 1);
          renderExperienceRepeater();
        });
      });
    }

    function renderEducationRepeater() {
      if (!cvEduContainer) return;
      cvEduContainer.innerHTML = currentEduList.map((edu, idx) => `
        <div class="repeater-item" data-idx="${idx}">
          <button type="button" class="repeater-remove-btn" data-remove-edu="${idx}">Remove</button>
          <div class="form-row form-row-2">
            <div class="form-field">
              <label class="field-label">Degree Title</label>
              <input type="text" class="editor-input edu-degree font-mono" value="${edu.degree || edu.role || ''}" placeholder="e.g. Ph.D. in Aerospace Engineering" />
            </div>
            <div class="form-field">
              <label class="field-label">Institution</label>
              <input type="text" class="editor-input edu-inst font-mono" value="${edu.institution || edu.organization || ''}" placeholder="e.g. Caltech" />
            </div>
          </div>
          <div class="form-row form-row-2" style="margin-top:0.5rem;">
            <div class="form-field">
              <label class="field-label">Period / Year</label>
              <input type="text" class="editor-input edu-period font-mono" value="${edu.period || ''}" placeholder="e.g. 2019 — 2023" />
            </div>
            <div class="form-field">
              <label class="field-label">Honors / Distinction</label>
              <input type="text" class="editor-input edu-honors font-mono" value="${edu.honors || edu.badge || ''}" placeholder="e.g. Summa Cum Laude" />
            </div>
          </div>
          <div class="form-field" style="margin-top:0.5rem;">
            <label class="field-label">Thesis / Dissertation Title</label>
            <input type="text" class="editor-input edu-thesis font-mono" value="${edu.thesis || ''}" placeholder="e.g. Autonomous Guidance for Low-Thrust SmallSats" />
          </div>
        </div>
      `).join('');

      cvEduContainer.querySelectorAll('[data-remove-edu]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-remove-edu') || '0', 10);
          currentEduList.splice(idx, 1);
          renderEducationRepeater();
        });
      });
    }

    document.getElementById('cv-add-experience-btn')?.addEventListener('click', () => {
      currentExpList.unshift({
        role: 'New Engineering Role',
        organization: 'Space Agency / Lab',
        period: '2024 — Present',
        location: 'Pasadena, CA',
        badge: 'Flight Software',
        summary: 'Brief role overview...',
        highlights: ['Architected key avionics subsystem...', 'Reduced telemetry latency by 45%...']
      });
      renderExperienceRepeater();
    });

    document.getElementById('cv-add-education-btn')?.addEventListener('click', () => {
      currentEduList.unshift({
        degree: 'M.S. in Aerospace Engineering',
        institution: 'University / Institute',
        period: '2020 — 2022',
        location: 'Cambridge, MA',
        honors: 'Honors Fellowship',
        thesis: 'Research in Astrodynamics'
      });
      renderEducationRepeater();
    });

    cvForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Collect updated experiences
      const expItems = cvExpContainer?.querySelectorAll('.repeater-item') || [];
      const updatedExp: any[] = [];
      expItems.forEach(item => {
        const role = (item.querySelector('.exp-role') as HTMLInputElement)?.value || '';
        const organization = (item.querySelector('.exp-org') as HTMLInputElement)?.value || '';
        const period = (item.querySelector('.exp-period') as HTMLInputElement)?.value || '';
        const badge = (item.querySelector('.exp-badge') as HTMLInputElement)?.value || '';
        const summary = (item.querySelector('.exp-summary') as HTMLTextAreaElement)?.value || '';
        const highlightsText = (item.querySelector('.exp-highlights') as HTMLTextAreaElement)?.value || '';
        const highlights = highlightsText.split('\n').map(h => h.trim()).filter(Boolean);

        updatedExp.push({ role, organization, period, badge, summary, highlights });
      });

      // Collect updated education
      const eduItems = cvEduContainer?.querySelectorAll('.repeater-item') || [];
      const updatedEdu: any[] = [];
      eduItems.forEach(item => {
        const degree = (item.querySelector('.edu-degree') as HTMLInputElement)?.value || '';
        const institution = (item.querySelector('.edu-inst') as HTMLInputElement)?.value || '';
        const period = (item.querySelector('.edu-period') as HTMLInputElement)?.value || '';
        const honors = (item.querySelector('.edu-honors') as HTMLInputElement)?.value || '';
        const thesis = (item.querySelector('.edu-thesis') as HTMLInputElement)?.value || '';

        updatedEdu.push({ degree, institution, period, honors, thesis });
      });

      const store = await getStore();
      const currentAvatar = store && typeof store.getProfileAvatar === 'function' ? store.getProfileAvatar() : '';

      const updatedCV = {
        profile: {
          name: cvNameInput?.value || '',
          callsign: cvCallsignInput?.value || '',
          location: cvLocationInput?.value || '',
          title: cvTitleInput?.value || '',
          clearance: cvClearanceInput?.value || '',
          tagline: cvTaglineInput?.value || '',
          bio: cvBioInput?.value || '',
          avatar: currentAvatar
        },
        experience: updatedExp,
        timeline: updatedExp,
        education: updatedEdu
      };

      if (store && typeof store.updateCVData === 'function') {
        store.updateCVData(updatedCV);
      } else {
        localStorage.setItem('portfolio_cv', JSON.stringify(updatedCV));
        window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
      }

      window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'My CV content updated successfully!' } }));
    });

    // Global listener to trigger avatar editing directly
    window.addEventListener('open-avatar-editor', () => {
      openModal('cv');
      setCVMode('form');
      setTimeout(() => {
        const el = document.getElementById('cv-avatar-studio');
        el?.scrollIntoView({ behavior: 'smooth' });
      }, 200);
    });

    document.querySelectorAll('[data-avatar-edit-trigger]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-avatar-editor'));
      });
    });

    // ----------------------------------------------------
    // TAB 4: BACKUP & DATA LOGIC
    // ----------------------------------------------------
    const exportBtn = document.getElementById('backup-export-btn');
    const importFileInput = document.getElementById('backup-import-file') as HTMLInputElement;
    const resetBtn = document.getElementById('backup-reset-btn');
    const rawJsonTextarea = document.getElementById('raw-json-textarea') as HTMLTextAreaElement;
    const applyRawJsonBtn = document.getElementById('apply-raw-json-btn');

    async function loadRawJson() {
      if (!rawJsonTextarea) return;
      const store = await getStore();
      let data: any = {};
      if (store && typeof store.exportDataJSON === 'function') {
        try {
          data = JSON.parse(store.exportDataJSON());
        } catch (e) {
          data = store.exportDataJSON();
        }
      } else {
        data = {
          cv: JSON.parse(localStorage.getItem('portfolio_cv') || '{}'),
          achievements: JSON.parse(localStorage.getItem('portfolio_achievements') || '[]'),
          blogs: JSON.parse(localStorage.getItem('portfolio_blogs') || '[]'),
        };
      }
      rawJsonTextarea.value = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
    }

    exportBtn?.addEventListener('click', async () => {
      const store = await getStore();
      let jsonString = '';
      if (store && typeof store.exportDataJSON === 'function') {
        jsonString = store.exportDataJSON();
      } else {
        jsonString = rawJsonTextarea?.value || '{}';
      }

      const blob = new Blob([jsonString], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `space-portfolio-backup-${new Date().toISOString().split('T')[0]}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Portfolio backup downloaded.' } }));
    });

    importFileInput?.addEventListener('change', (e) => {
      const file = importFileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (evt) => {
        try {
          const content = evt.target?.result as string;
          const store = await getStore();
          if (store && typeof store.importDataJSON === 'function') {
            const res = store.importDataJSON(content);
            if (!res.success) throw new Error(res.error || 'Import error');
          } else {
            const parsed = JSON.parse(content);
            localStorage.setItem('portfolio_custom_data', JSON.stringify(parsed));
            if (parsed.achievements) localStorage.setItem('portfolio_achievements', JSON.stringify(parsed.achievements));
            if (parsed.blogs) localStorage.setItem('portfolio_blogs', JSON.stringify(parsed.blogs));
            if (parsed.profile || parsed.education || parsed.experience) {
              localStorage.setItem('portfolio_cv', JSON.stringify(parsed));
            }
          }

          window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
          window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Data imported successfully!' } }));
          refreshAllData();
        } catch (err: any) {
          alert('Failed to parse uploaded JSON file: ' + (err?.message || 'Invalid format'));
        }
      };
      reader.readAsText(file);
    });

    applyRawJsonBtn?.addEventListener('click', async () => {
      try {
        const val = rawJsonTextarea.value;
        const store = await getStore();
        if (store && typeof store.importDataJSON === 'function') {
          const res = store.importDataJSON(val);
          if (!res.success) throw new Error(res.error || 'Import error');
        } else {
          const parsed = JSON.parse(val);
          localStorage.setItem('portfolio_custom_data', JSON.stringify(parsed));
          if (parsed.achievements) localStorage.setItem('portfolio_achievements', JSON.stringify(parsed.achievements));
          if (parsed.blogs) localStorage.setItem('portfolio_blogs', JSON.stringify(parsed.blogs));
          if (parsed.profile || parsed.education || parsed.experience) {
            localStorage.setItem('portfolio_cv', JSON.stringify(parsed));
          }
        }
        window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
        window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Applied raw JSON changes.' } }));
        refreshAllData();
      } catch (err: any) {
        alert('Invalid JSON in raw editor: ' + (err?.message || 'Syntax error'));
      }
    });

    resetBtn?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to reset all portfolio data back to factory defaults? All unsaved modifications will be restored.')) return;
      const store = await getStore();
      if (store && typeof store.resetToDefaults === 'function') {
        store.resetToDefaults();
      } else {
        localStorage.removeItem('portfolio_achievements');
        localStorage.removeItem('portfolio_blogs');
        localStorage.removeItem('portfolio_cv');
        localStorage.removeItem('portfolio_custom_data');
        window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
      }
      window.dispatchEvent(new CustomEvent('portfolio-admin-toast', { detail: { message: 'Reset to factory defaults.' } }));
      refreshAllData();
    });

    function refreshAllData() {
      loadAchievements();
      loadBlogs();
      loadCVData();
      loadRawJson();
    }

    // Refresh when external update occurs
    window.addEventListener('portfolio-data-updated', () => {
      if (modal.classList.contains('is-active')) {
        refreshAllData();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminEditorModal);
  } else {
    setupAdminEditorModal();
  }
  document.addEventListener('astro:page-load', setupAdminEditorModal);
</script>
