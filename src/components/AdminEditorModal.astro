---
// AdminEditorModal.astro - Comprehensive Apple-style Content Management Modal
// Handles: Achievements & Timeline, Blog Composer, Harvard CV Content, Backup/Restore
---

<div id="admin-editor-modal" class="editor-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="editor-modal-title">
  <div class="editor-modal-window">
    <!-- Header with Segmented Tab Control -->
    <div class="editor-header">
      <div class="editor-title-row">
        <div class="editor-title-wrapper">
          <span class="editor-sys-pill">MISSION CONTROL CMS</span>
          <h2 id="editor-modal-title" class="editor-title">Content & Telemetry Studio</h2>
        </div>
        <button type="button" class="editor-close-btn" id="editor-modal-close" aria-label="Close editor modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Apple Segmented Navigation Bar -->
      <div class="segmented-control" role="tablist">
        <button type="button" class="segment-tab is-active" data-tab="tab-achievement" role="tab" aria-selected="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="7"></circle>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
          </svg>
          <span>Achievements</span>
        </button>
        <button type="button" class="segment-tab" data-tab="tab-blog" role="tab" aria-selected="false">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Blog Composer</span>
        </button>
        <button type="button" class="segment-tab" data-tab="tab-cv" role="tab" aria-selected="false">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>My CV</span>
        </button>
        <button type="button" class="segment-tab" data-tab="tab-backup" role="tab" aria-selected="false">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Data & Backup</span>
        </button>
      </div>
    </div>

    <!-- Body Scroll Area -->
    <div class="editor-body">
      <!-- ============================================== -->
      <!-- TAB 1: ACHIEVEMENTS & TIMELINE                 -->
      <!-- ============================================== -->
      <div id="tab-achievement" class="editor-tab-panel is-active" role="tabpanel">
        <div class="panel-intro">
          <div>
            <h3 class="panel-heading">Achievements & Mission Timeline</h3>
            <p class="panel-subtext">Upload honors, NASA/AIAA awards, flight heritage missions, and technical distinctions with exact chronology.</p>
          </div>
          <button type="button" id="achievement-new-btn" class="btn-secondary-action">
            + Reset Form
          </button>
        </div>

        <form id="achievement-form" class="editor-grid-form">
          <input type="hidden" id="achievement-id-input" value="" />

          <div class="form-row form-row-2">
            <div class="form-field">
              <label for="achievement-title-input" class="field-label">Achievement / Award Title *</label>
              <input type="text" id="achievement-title-input" class="editor-input" placeholder="e.g. NASA Space Flight Honor Award" required />
            </div>

            <div class="form-field">
              <label for="achievement-date-input" class="field-label">Timeline / Date *</label>
              <input type="text" id="achievement-date-input" class="editor-input" placeholder="e.g. 2024 — Present or October 2024" required />
            </div>
          </div>

          <div class="form-row form-row-3">
            <div class="form-field">
              <label for="achievement-category-select" class="field-label">Category</label>
              <select id="achievement-category-select" class="editor-select">
                <option value="Flight Heritage">Flight Heritage</option>
                <option value="Technical Award">Technical Award</option>
                <option value="Mission Milestone">Mission Milestone</option>
                <option value="Research & Papers">Research & Papers</option>
                <option value="Fellowship / Honor">Fellowship / Honor</option>
                <option value="Patent">Patent / Intellectual Property</option>
              </select>
            </div>

            <div class="form-field">
              <label for="achievement-org-input" class="field-label">Organization / Sponsor</label>
              <input type="text" id="achievement-org-input" class="editor-input" placeholder="e.g. NASA Jet Propulsion Laboratory / Caltech" />
            </div>

            <div class="form-field">
              <label for="achievement-metrics-input" class="field-label">Key Metrics / Impact</label>
              <input type="text" id="achievement-metrics-input" class="editor-input" placeholder="e.g. 0 Anomaly Trips / Top 1% Distinction" />
            </div>
          </div>

          <div class="form-field">
            <label for="achievement-desc-input" class="field-label">Description & Harvard Accomplishment Details</label>
            <textarea id="achievement-desc-input" rows="3" class="editor-textarea" placeholder="Detail the technical achievement, role leadership, and operational outcomes..."></textarea>
          </div>

          <div class="form-field">
            <label for="achievement-tags-input" class="field-label">Tags (comma-separated)</label>
            <input type="text" id="achievement-tags-input" class="editor-input" placeholder="e.g. Rust, CCSDS, ARM Cortex-M7, FDIR" />
          </div>

          <div class="form-submit-row">
            <button type="submit" id="achievement-save-btn" class="btn-save-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span>Save Achievement</span>
            </button>
          </div>
        </form>

        <!-- Existing Achievements List -->
        <div class="inventory-section">
          <div class="inventory-header">
            <h4>Existing Achievements & Timeline Entries</h4>
            <span id="achievement-count-badge" class="count-pill">0 entries</span>
          </div>
          <div id="achievement-list-container" class="inventory-list">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- TAB 2: BLOG COMPOSER                           -->
      <!-- ============================================== -->
      <div id="tab-blog" class="editor-tab-panel" role="tabpanel">
        <div class="panel-intro">
          <div>
            <h3 class="panel-heading">Technical Article Composer</h3>
            <p class="panel-subtext">Author, edit, and publish space engineering articles and flight software mission logs.</p>
          </div>
          <button type="button" id="blog-new-btn" class="btn-secondary-action">
            + New Article
          </button>
        </div>

        <form id="blog-form" class="editor-grid-form">
          <input type="hidden" id="blog-id-input" value="" />

          <div class="form-row form-row-2">
            <div class="form-field">
              <label for="blog-title-input" class="field-label">Article Title *</label>
              <input type="text" id="blog-title-input" class="editor-input" placeholder="e.g. Deterministic Real-Time Flight Software with Rust & FreeRTOS" required />
            </div>

            <div class="form-field">
              <label for="blog-slug-input" class="field-label">URL Slug *</label>
              <input type="text" id="blog-slug-input" class="editor-input" placeholder="e.g. deterministic-rtos-flight-software" required />
            </div>
          </div>

          <div class="form-row form-row-3">
            <div class="form-field">
              <label for="blog-date-input" class="field-label">Publish Date</label>
              <input type="date" id="blog-date-input" class="editor-input" />
            </div>

            <div class="form-field">
              <label for="blog-readtime-input" class="field-label">Reading Time</label>
              <input type="text" id="blog-readtime-input" class="editor-input" placeholder="e.g. 6 min read" />
            </div>

            <div class="form-field">
              <label for="blog-tags-input" class="field-label">Category Tags (comma-separated)</label>
              <input type="text" id="blog-tags-input" class="editor-input" placeholder="e.g. Flight Software, Rust, RTOS" />
            </div>
          </div>

          <div class="form-field">
            <label for="blog-excerpt-input" class="field-label">Abstract / Excerpt *</label>
            <textarea id="blog-excerpt-input" rows="2" class="editor-textarea" placeholder="Brief summary displayed on cards and search index..." required></textarea>
          </div>

          <div class="form-field">
            <div class="field-header-row">
              <label for="blog-content-input" class="field-label">Article Body (Markdown Supported) *</label>
              <div class="editor-quick-tools">
                <button type="button" class="tool-btn" data-tool="h2" title="Heading 2">H2</button>
                <button type="button" class="tool-btn" data-tool="bold" title="Bold">B</button>
                <button type="button" class="tool-btn" data-tool="italic" title="Italic">I</button>
                <button type="button" class="tool-btn" data-tool="code" title="Code snippet">&lt;/&gt;</button>
                <button type="button" class="tool-btn" data-tool="bullet" title="Bullet list">• List</button>
              </div>
            </div>
            <textarea id="blog-content-input" rows="8" class="editor-textarea font-mono" placeholder="Write full article here using Markdown..." required></textarea>
          </div>

          <div class="form-submit-row">
            <button type="submit" id="blog-save-btn" class="btn-save-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span>Publish / Update Article</span>
            </button>
          </div>
        </form>

        <!-- Published Articles List -->
        <div class="inventory-section">
          <div class="inventory-header">
            <h4>Published Mission Articles</h4>
            <span id="blog-count-badge" class="count-pill">0 articles</span>
          </div>
          <div id="blog-list-container" class="inventory-list">
            <!-- Dynamically populated -->
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- TAB 3: HARVARD CV CONTENT STUDIO               -->
      <!-- ============================================== -->
      <div id="tab-cv" class="editor-tab-panel" role="tabpanel">
        <div class="panel-intro">
          <div>
            <h3 class="panel-heading">My CV Content & Sections Studio</h3>
            <p class="panel-subtext">Directly modify My CV sections: Profile Header, Avatar, Professional Appointments, Academic Credentials, and Word Document Canvas.</p>
          </div>
          <div style="display:flex; gap:0.5rem; align-items:center;">
            <a href="/cv" target="_blank" class="btn-secondary-action">
              View Live CV ↗
            </a>
          </div>
        </div>

        <!-- Mode Switcher: Form View vs Word Document Editor View -->
        <div class="cv-mode-selector">
          <button type="button" class="cv-mode-btn is-active" id="cv-mode-form-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <span>Structured Form Mode</span>
          </button>
          <button type="button" class="cv-mode-btn" id="cv-mode-doc-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            <span>Word Document Editor (Rich Format)</span>
          </button>
        </div>

        <!-- Profile Avatar Studio (Shared) -->
        <div class="cv-section-card avatar-studio-card" id="cv-avatar-studio">
          <h4 class="cv-card-title">Profile Photo & Callsign Avatar</h4>
          <div class="avatar-studio-layout">
            <div class="avatar-preview-wrap">
              <img id="cv-avatar-preview-img" class="avatar-preview-img" src="" alt="Profile Preview" style="display:none;" />
              <div id="cv-avatar-fallback" class="avatar-preview-fallback">NN</div>
              <label for="cv-avatar-file-input" class="avatar-camera-overlay" title="Upload local image">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
              </label>
            </div>
            <div class="avatar-controls-col">
              <div class="avatar-btn-row">
                <label class="btn-secondary-action avatar-upload-btn">
                  <span>📁 Upload Image File</span>
                  <input type="file" id="cv-avatar-file-input" accept="image/*" style="display:none;" />
                </label>
                <button type="button" id="cv-avatar-reset-btn" class="btn-micro-action" style="color:#F87171;">Reset Default</button>
              </div>
              <div class="avatar-url-row">
                <input type="url" id="cv-avatar-url-input" class="editor-input" placeholder="Or enter image URL (https://...)" />
                <button type="button" id="cv-avatar-load-url-btn" class="btn-secondary-action">Apply URL</button>
              </div>
              <div class="avatar-presets-row">
                <span class="preset-label">Quick Presets:</span>
                <button type="button" class="preset-pill" data-preset="astronaut">Astronaut Helmet</button>
                <button type="button" class="preset-pill" data-preset="spacecraft">Flight Commander</button>
                <button type="button" class="preset-pill" data-preset="satellite">Space Specialist</button>
              </div>
            </div>
          </div>
        </div>

        <!-- VIEW 1: STRUCTURED FORM -->
        <form id="cv-editor-form" class="editor-grid-form">
          <!-- Profile Section -->
          <div class="cv-section-card">
            <h4 class="cv-card-title">1. Professional Header & Identity</h4>
            
            <div class="form-row form-row-3">
              <div class="form-field">
                <label for="cv-name-input" class="field-label">Full Name</label>
                <input type="text" id="cv-name-input" class="editor-input" />
              </div>
              <div class="form-field">
                <label for="cv-callsign-input" class="field-label">Callsign / Code</label>
                <input type="text" id="cv-callsign-input" class="editor-input" />
              </div>
              <div class="form-field">
                <label for="cv-location-input" class="field-label">Location</label>
                <input type="text" id="cv-location-input" class="editor-input" />
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-field">
                <label for="cv-title-input" class="field-label">Professional Title</label>
                <input type="text" id="cv-title-input" class="editor-input" />
              </div>
              <div class="form-field">
                <label for="cv-clearance-input" class="field-label">Clearance / Status</label>
                <input type="text" id="cv-clearance-input" class="editor-input" />
              </div>
            </div>

            <div class="form-field">
              <label for="cv-tagline-input" class="field-label">Mission Tagline</label>
              <input type="text" id="cv-tagline-input" class="editor-input" />
            </div>

            <div class="form-field">
              <label for="cv-bio-input" class="field-label">Executive Bio / Harvard Summary</label>
              <textarea id="cv-bio-input" rows="3" class="editor-textarea"></textarea>
            </div>
          </div>

          <!-- Professional Experience Section -->
          <div class="cv-section-card">
            <div class="field-header-row">
              <h4 class="cv-card-title">2. Professional Appointments & Experience</h4>
              <button type="button" id="cv-add-experience-btn" class="btn-micro-action">+ Add Role</button>
            </div>
            <div id="cv-experience-list" class="repeater-list">
              <!-- Dynamically populated repeater items -->
            </div>
          </div>

          <!-- Education Section -->
          <div class="cv-section-card">
            <div class="field-header-row">
              <h4 class="cv-card-title">3. Academic Background & Degrees</h4>
              <button type="button" id="cv-add-education-btn" class="btn-micro-action">+ Add Degree</button>
            </div>
            <div id="cv-education-list" class="repeater-list">
              <!-- Dynamically populated repeater items -->
            </div>
          </div>

          <div class="form-submit-row">
            <button type="submit" id="cv-save-btn" class="btn-save-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                <polyline points="7 3 7 8 15 8"></polyline>
              </svg>
              <span>Save Full CV Data</span>
            </button>
          </div>
        </form>

        <!-- VIEW 2: WORD DOCUMENT CANVAS (RICH FORMATTING) -->
        <div id="cv-word-editor-panel" class="word-editor-container" style="display: none;">
          <!-- Word Ribbon / Toolbar -->
          <div class="word-ribbon" role="toolbar" aria-label="Word Formatting Ribbon">
            <div class="ribbon-group">
              <button type="button" class="word-tool-btn" data-doc-cmd="undo" title="Undo">↩</button>
              <button type="button" class="word-tool-btn" data-doc-cmd="redo" title="Redo">↪</button>
            </div>
            <div class="ribbon-sep"></div>
            <div class="ribbon-group">
              <select id="word-block-select" class="word-heading-select" title="Paragraph Format">
                <option value="p">Paragraph</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
                <option value="blockquote">Callout / Quote</option>
              </select>
            </div>
            <div class="ribbon-sep"></div>
            <div class="ribbon-group">
              <button type="button" class="word-tool-btn font-bold" data-doc-cmd="bold" title="Bold"><b>B</b></button>
              <button type="button" class="word-tool-btn italic" data-doc-cmd="italic" title="Italic"><i>I</i></button>
              <button type="button" class="word-tool-btn underline" data-doc-cmd="underline" title="Underline"><u>U</u></button>
              <button type="button" class="word-tool-btn line-through" data-doc-cmd="strikeThrough" title="Strikethrough"><s>S</s></button>
            </div>
            <div class="ribbon-sep"></div>
            <div class="ribbon-group">
              <button type="button" class="word-tool-btn" data-doc-cmd="insertUnorderedList" title="Bullet List">• List</button>
              <button type="button" class="word-tool-btn" data-doc-cmd="insertOrderedList" title="Numbered List">1. List</button>
            </div>
            <div class="ribbon-sep"></div>
            <div class="ribbon-group">
              <button type="button" class="word-tool-btn text-amber" data-doc-cmd="foreColor" data-val="#E5A96A" title="Gold Amber Text">Gold</button>
              <button type="button" class="word-tool-btn" data-doc-cmd="hiliteColor" data-val="rgba(229,169,106,0.25)" title="Amber Highlight">Highlight</button>
              <button type="button" class="word-tool-btn" data-doc-cmd="insertHorizontalRule" title="Divider Line">― HR</button>
              <button type="button" class="word-tool-btn" data-doc-cmd="removeFormat" title="Clear Formatting">Tx Clear</button>
            </div>
          </div>

          <!-- Document Header Info -->
          <div class="doc-sheet-header">
            <span class="doc-icon">📄</span>
            <span class="doc-filename">Harvard_Academic_CV_Nhat_Nguyen_Vo.docx</span>
            <span class="doc-status-badge">Document Canvas • Monospace Rich Text</span>
          </div>

          <!-- Document Paper Sheet -->
          <div class="word-doc-canvas-wrapper">
            <div id="cv-word-document-canvas" class="word-doc-canvas font-mono" contenteditable="true" spellcheck="false">
              <!-- Loaded dynamically with rich HTML -->
            </div>
          </div>

          <!-- Document Status Footer -->
          <div class="doc-status-bar">
            <div class="doc-status-left font-mono">
              <span>Page 1 of 1</span>
              <span>•</span>
              <span id="cv-doc-word-count">0 words</span>
              <span>•</span>
              <span>Harvard Academic Standard</span>
            </div>
            <button type="button" id="cv-word-save-btn" class="btn-save-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline></svg>
              <span>Save Word Document to CV</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- TAB 4: DATA BACKUP & RESTORE                   -->
      <!-- ============================================== -->
      <div id="tab-backup" class="editor-tab-panel" role="tabpanel">
        <div class="panel-intro">
          <div>
            <h3 class="panel-heading">System Data Management & Backups</h3>
            <p class="panel-subtext">Export your entire space engineer portfolio dataset to JSON, import backups, or restore factory defaults.</p>
          </div>
        </div>

        <div class="backup-cards-grid">
          <!-- Card 1: Export -->
          <div class="backup-action-card">
            <div class="backup-card-icon icon-amber">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            <h4>Export Data (JSON)</h4>
            <p>Download a complete snapshot of all achievements, blog posts, CV records, and projects.</p>
            <button type="button" id="backup-export-btn" class="btn-card-action">
              Download JSON Backup
            </button>
          </div>

          <!-- Card 2: Import -->
          <div class="backup-action-card">
            <div class="backup-card-icon icon-blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
            </div>
            <h4>Import Data (JSON)</h4>
            <p>Restore or update portfolio data from a previously exported JSON backup file.</p>
            <label class="btn-card-action file-upload-label">
              <span>Select JSON File</span>
              <input type="file" id="backup-import-file" accept=".json,application/json" style="display:none;" />
            </label>
          </div>

          <!-- Card 3: Reset -->
          <div class="backup-action-card">
            <div class="backup-card-icon icon-red">
