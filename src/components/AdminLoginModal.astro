---
// AdminLoginModal.astro - Apple-style frosted security authentication modal
---

<div id="admin-login-modal" class="admin-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
  <div class="admin-modal-card">
    <!-- Close Button -->
    <button type="button" class="admin-modal-close" id="admin-login-close" aria-label="Close authentication modal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Header with Satellite / Key Badge -->
    <div class="modal-header">
      <div class="modal-badge-wrapper">
        <div class="modal-badge-glow"></div>
        <div class="modal-badge-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
      </div>
      <h2 id="admin-modal-title" class="modal-title">Flight Deck Authorization</h2>
      <p class="modal-subtitle">
        Enter authorization passkey to access CV content management, add achievements, and publish mission logs.
      </p>
    </div>

    <!-- Login Form -->
    <form id="admin-login-form" class="modal-form" autocomplete="off">
      <div class="form-group">
        <label for="admin-passkey-input" class="form-label">
          <span>Security Passkey</span>
          <button type="button" id="admin-quick-fill-btn" class="quick-fill-link" title="Fill default test credentials">
            Use default (apollo11)
          </button>
        </label>
        <div class="input-container">
          <svg class="input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 2l-2 2m-1.5 1.5L16 7l-1.5-1.5-2 2L12 6l-2 2 1.5 1.5L10 11l-1.5-1.5-2 2L8 13l-1.5-1.5-2 2L6 15l-1.5-1.5L3 15v6h6l1.5-1.5L9 18l1.5-1.5 2-2L14 16l1.5-1.5 2 2 1.5-1.5 2-2 2-2z"></path>
          </svg>
          <input
            type="password"
            id="admin-passkey-input"
            name="passkey"
            class="form-input"
            placeholder="Enter flight passkey..."
            required
            autocomplete="current-password"
          />
          <button type="button" id="admin-toggle-visibility" class="toggle-visibility-btn" aria-label="Toggle passkey visibility">
            <svg id="pass-eye-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <!-- Feedback / Error Banner -->
      <div id="admin-login-feedback" class="feedback-banner" role="alert" style="display: none;">
        <span class="feedback-dot"></span>
        <span id="admin-login-feedback-text">Invalid passkey.</span>
      </div>

      <!-- Form Actions -->
      <div class="modal-actions">
        <button type="button" id="admin-login-cancel" class="btn-cancel">
          Cancel
        </button>
        <button type="submit" id="admin-login-submit" class="btn-submit">
          <span class="btn-label">Authenticate</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </form>

    <!-- Footer metadata badge -->
    <div class="modal-footer-info">
      <span class="telemetry-dot"></span>
      <span>ORBITAL FSW COMMAND INTERFACE // 256-BIT LOCAL SESSION</span>
    </div>
  </div>
</div>

<style>
  .admin-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background-color: rgba(6, 8, 14, 0.78);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .admin-modal-backdrop.is-active,
  .admin-modal-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .admin-modal-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: linear-gradient(180deg, rgba(20, 24, 35, 0.95) 0%, rgba(11, 14, 21, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    font-family: 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace !important;
    box-shadow: 
      0 20px 45px -10px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(229, 169, 106, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    padding: 2rem;
    color: #F3F4F6;
    transform: scale(0.94) translateY(8px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .admin-modal-backdrop.is-active .admin-modal-card,
  .admin-modal-backdrop.is-open .admin-modal-card {
    transform: scale(1) translateY(0);
  }

  .admin-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: #8E95A5;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .admin-modal-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .modal-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .modal-badge-wrapper {
    position: relative;
    width: 58px;
    height: 58px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-badge-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(229, 169, 106, 0.35) 0%, transparent 70%);
    filter: blur(8px);
  }

  .modal-badge-icon {
    position: relative;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(35, 40, 55, 0.9), rgba(15, 18, 26, 0.95));
    border: 1px solid rgba(229, 169, 106, 0.35);
    color: #E5A96A;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-title {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 0.5rem;
  }

  .modal-subtitle {
    font-size: 0.86rem;
    line-height: 1.5;
    color: #8E95A5;
    margin: 0;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    font-weight: 500;
    color: #D1D5DB;
  }

  .quick-fill-link {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.76rem;
    color: #E5A96A;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .quick-fill-link:hover {
    opacity: 1;
    color: #F3C48D;
  }

  .input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    color: #6B7280;
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 2.6rem 0.75rem 2.6rem;
    background: rgba(10, 13, 20, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    font-size: 0.92rem;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus {
    border-color: rgba(229, 169, 106, 0.6);
    box-shadow: 0 0 0 3px rgba(229, 169, 106, 0.15);
  }

  .toggle-visibility-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    color: #6B7280;
    padding: 0.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: color 0.2s;
  }

  .toggle-visibility-btn:hover {
    color: #D1D5DB;
  }

  .feedback-banner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: 10px;
    font-size: 0.82rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.28);
    color: #FCA5A5;
    animation: feedbackShake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  .feedback-banner.is-success {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.3);
    color: #6EE7B7;
    animation: none;
  }

  .feedback-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
    flex-shrink: 0;
  }

  @keyframes feedbackShake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-3px, 0, 0); }
    40%, 60% { transform: translate3d(3px, 0, 0); }
  }

  .modal-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-cancel {
    flex: 1;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #9CA3AF;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .btn-cancel:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
  }

  .btn-submit {
    flex: 1.4;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    background: linear-gradient(135deg, #E5A96A 0%, #D4AF37 100%);
    border: none;
    color: #0A0C12;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(229, 169, 106, 0.25);
    transition: transform 0.15s ease, filter 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-submit:hover {
    filter: brightness(1.08);
    box-shadow: 0 6px 20px rgba(229, 169, 106, 0.35);
  }

  .btn-submit:active {
    transform: scale(0.97);
  }

  .modal-footer-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #64748B;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px #10B981;
  }
</style>

<script>
  function setupAdminLoginModal() {
    const modal = document.getElementById('admin-login-modal');
    if (!modal) return;

    const closeBtn = document.getElementById('admin-login-close');
    const cancelBtn = document.getElementById('admin-login-cancel');
    const form = document.getElementById('admin-login-form');
    const input = document.getElementById('admin-passkey-input');
    const toggleBtn = document.getElementById('admin-toggle-visibility');
    const quickFillBtn = document.getElementById('admin-quick-fill-btn');
    const feedback = document.getElementById('admin-login-feedback');
    const feedbackText = document.getElementById('admin-login-feedback-text');

    function openModal() {
      modal.classList.add('is-active', 'is-open');
      modal.setAttribute('aria-hidden', 'false');
      if (input) {
        input.value = '';
        setTimeout(() => input.focus(), 150);
      }
      hideFeedback();
    }

    function closeModal() {
      modal.classList.remove('is-active', 'is-open');
      modal.setAttribute('aria-hidden', 'true');
      hideFeedback();
    }

    function showFeedback(text, isSuccess = false) {
      if (!feedback || !feedbackText) return;
      feedbackText.textContent = text;
      feedback.style.display = 'flex';
      if (isSuccess) {
        feedback.classList.add('is-success');
      } else {
        feedback.classList.remove('is-success');
      }
    }

    function hideFeedback() {
      if (feedback) {
        feedback.style.display = 'none';
        feedback.classList.remove('is-success');
      }
    }

    // Toggle password eye
    toggleBtn?.addEventListener('click', () => {
      if (!input) return;
      const isPass = input.type === 'password';
      input.type = isPass ? 'text' : 'password';
      toggleBtn.style.color = isPass ? '#E5A96A' : '#6B7280';
    });

    // Quick fill helper
    quickFillBtn?.addEventListener('click', () => {
      if (input) {
        input.value = 'apollo11';
        input.focus();
      }
    });

    // Handle Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const enteredKey = input?.value?.trim() || '';

      try {
        let authOk = false;
        // Dynamically check store.js if available
        let storeModule = null;
        try {
          storeModule = await import('../scripts/store.js');
        } catch (err) {
          // fallback if store not yet exported or browser local evaluation
        }

        if (storeModule && typeof storeModule.loginAdmin === 'function') {
          const res = storeModule.loginAdmin(enteredKey);
          authOk = typeof res === 'object' && res !== null ? res.success : Boolean(res);
        } else {
          // Fallback direct check against default or stored key
          const storedKey = localStorage.getItem('astro_admin_passkey') || 'apollo11';
          authOk = (enteredKey === storedKey);
        }

        if (authOk) {
          localStorage.setItem('space_portfolio_admin_auth', 'true');
          localStorage.setItem('astro_admin_auth', 'true');
          localStorage.setItem('portfolio_admin_authenticated', 'true');
          window.dispatchEvent(new CustomEvent('portfolio-admin-auth-changed', { detail: { authenticated: true } }));
          window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
          showFeedback('Access Granted. Telemetry Uplink Established.', true);
          setTimeout(() => {
            closeModal();
            // Dispatch notification
            window.dispatchEvent(new CustomEvent('portfolio-admin-toast', {
              detail: { message: 'Admin Mode Active. Full Mission Permissions Granted.', type: 'success' }
            }));
            // If on /admin, reload or refresh view
            if (window.location.pathname.includes('/admin')) {
              window.location.reload();
            }
          }, 600);
        } else {
          showFeedback('Invalid authorization passkey. Default is: apollo11', false);
          if (input) {
            input.select();
            input.focus();
          }
        }
      } catch (err) {
        console.error('Authentication error:', err);
        showFeedback('Authentication system error. Check console.', false);
      }
    });

    // Close handlers
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Backdrop click outside card
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal();
      }
    });

    // Global event to open modal
    window.addEventListener('open-admin-login', () => {
      openModal();
    });

    // Bind all elements with data-admin-login-trigger
    document.querySelectorAll('[data-admin-login-trigger], [data-admin-login], a[href="#admin-login"]').forEach(el => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });
  }

  // Initialize on load and on Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminLoginModal);
  } else {
    setupAdminLoginModal();
  }
  document.addEventListener('astro:page-load', setupAdminLoginModal);
</script>
