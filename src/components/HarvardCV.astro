---
/**
 * HarvardCV.astro - Authentic Harvard Academic & Technical Curriculum Vitae
 *
 * Implements:
 * 1. Monospace Typography throughout (SF Mono / JetBrains Mono / Fira Code / monospace).
 * 2. Profile Avatar displayed beside header information with live customizer (upload file / URL) trigger.
 * 3. Word-Style Rich Document Editor support: renders rich HTML content, formatted text, and document canvas.
 * 4. Classic Harvard Academic & Technical CV structure:
 *    - Professional Header (Name, Callsign, Affiliations, Clearance, Contact)
 *    - Education (Caltech Ph.D., MIT M.S., Berkeley B.S., Thesis, Advisors, Honors, GPA, Coursework)
 *    - Professional Appointments & Flight Software Experience (Action verbs, metrics, orbital systems)
 *    - Flight Heritage & Space Missions (CubeSats, Orbits, Subsystems, Flight stats)
 *    - Publications & Conference Proceedings (AIAA, IEEE format with DOIs)
 *    - Honors, Grants & Distinctions (Chronological with exact dates)
 *    - Technical Skills & Flight Standards (CCSDS, MISRA C, DO-178C, RTOS, Astrodynamics)
 * 5. 1-Click 'Print / Save as PDF' with tailored @media print CSS for authentic letter printout.
 * 6. Dual preview themes: 'Academic Paper Mode' vs 'Cosmic Dark Mode'.
 * 7. Reactive store integration with store.js for instant updates without page reload.
 */
import defaultData from '../data/portfolio.json';

export interface Props {
  initialTheme?: 'paper' | 'dark';
  hideControls?: boolean;
}

const {
  initialTheme = 'paper',
  hideControls = false
} = Astro.props;

const profile = defaultData.profile || {};
const education = defaultData.education || [];
const experience = defaultData.experience || [];
const missions = defaultData.missions || [];
const publications = defaultData.publications || [];
const achievements = defaultData.achievements || [];
const skills = defaultData.skills || [];
const avatarSrc = profile.avatar || "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80";
---

<div class="harvard-cv-wrapper" id="harvard-cv-root" data-theme={initialTheme}>
  {/* Action Controls Bar (Hidden during print) */}
  {!hideControls && (
    <div class="cv-action-bar no-print" aria-label="My CV Document Actions">
      <div class="action-bar-left">
        <div class="document-badge">
          <span class="doc-icon">🏛️</span>
          <span class="doc-label">MY CV</span>
          <span class="doc-sublabel">// MONOSPACE FLIGHT DOSSIER</span>
        </div>
        <div class="live-sync-indicator" id="cv-sync-pill" title="Synchronized with local mission data store">
          <span class="pulse-dot"></span>
          <span class="sync-text">STORE: ACTIVE</span>
        </div>
      </div>

      <div class="action-bar-right">
        {/* Word Document Editor Trigger Button */}
        <button
          type="button"
          class="btn-word-editor-trigger"
          id="btn-open-word-editor"
          title="Open Word-style Document Editor (Rich formatting studio)"
          aria-label="Open Word-style CV Editor"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Word Editor</span>
        </button>

        {/* Apple-style segmented theme preview selector */}
        <div class="segmented-theme-toggle" role="group" aria-label="CV Display Mode">
          <button
            type="button"
            class="theme-toggle-btn active"
            id="theme-paper-btn"
            title="Preview authentic Harvard ivory paper styling in monospace"
            aria-pressed="true"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>Paper</span>
          </button>
          <button
            type="button"
            class="theme-toggle-btn"
            id="theme-dark-btn"
            title="Preview cosmic aerospace onyx dark styling"
            aria-pressed="false"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span>Cosmic</span>
          </button>
        </div>

        {/* 1-Click Print / Save PDF Button */}
        <button
          type="button"
          class="btn-cv-print"
          id="cv-print-btn"
          title="Print or Save as authentic PDF (Cmd+P / Ctrl+P)"
          aria-label="Print My CV as PDF"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span class="print-label">Print PDF</span>
          <kbd class="kbd-badge">⌘P</kbd>
        </button>
      </div>
    </div>
  )}

  {/* Authentic Harvard Document Canvas (Pure Monospace Architecture) */}
  <article class="harvard-sheet monospace-dossier" id="harvard-document-sheet" itemscope itemtype="https://schema.org/Person">
    
    {/* SECTION 1: PROFESSIONAL HEADER WITH PROFILE AVATAR BESIDE INFO */}
    <header class="cv-header" id="cv-header-container">
      <div class="cv-header-grid">
        {/* Profile Avatar Column beside personal info */}
        <div class="cv-avatar-column" id="cv-avatar-wrapper">
          <div class="cv-avatar-frame">
            <img
              src={avatarSrc}
              alt={profile.avatarAlt || profile.name}
              class="cv-avatar-photo"
              id="cv-avatar-img"
              loading="eager"
            />
            {/* Fallback Monogram */}
            <div class="cv-avatar-monogram" id="cv-avatar-monogram" aria-hidden="true">
              {profile.monogram || "NN"}
            </div>
            {/* Quick edit overlay for admin photo customizer */}
            <button
              type="button"
              class="cv-avatar-edit-overlay no-print"
              id="cv-avatar-edit-trigger"
              title="Customize profile photo (Upload file or enter URL via Admin)"
              aria-label="Customize profile photo"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span class="avatar-edit-badge">EDIT</span>
            </button>
          </div>
          <span class="cv-crew-badge telemetry-mono no-print">CREW: {profile.monogram || "NN"} // {profile.callsign || "NHAT-NGUYEN"}</span>
        </div>

        {/* Header Text & Identity Info */}
        <div class="cv-header-info">
          <div class="cv-header-primary">
            <h1 class="cv-full-name" id="cv-name" itemprop="name">
              {profile.name} <span class="cv-alt-name">({profile.englishName || "Nhat Nguyen Vo"})</span>
            </h1>
            <div class="cv-callsign-tag no-print">
              <span>CALLSIGN: {profile.callsign || "NHAT-NGUYEN"}</span>
            </div>
          </div>

          <div class="cv-title-line" id="cv-title" itemprop="jobTitle">
            {profile.title}
          </div>

          <div class="cv-affiliations" id="cv-affiliations">
            <span class="affil-item">{profile.academicAffiliation || "Caltech Space Radiation Lab • AIAA Associate Fellow"}</span>
            <span class="affil-sep">•</span>
            <span class="affil-clearance">{profile.clearance || "Public Trust / NASA Heritage Clearance"}</span>
          </div>

          <div class="cv-contact-bar" id="cv-contact-bar">
            <span class="contact-item" id="cv-location" itemprop="address">
              {profile.location}
            </span>
            <span class="contact-sep">•</span>
            <a href={`mailto:${profile.social?.email || "nhatnguyen@orbital-flight.dev"}`} class="contact-item contact-link" id="cv-email" itemprop="email">
              {profile.social?.email || "nhatnguyen@orbital-flight.dev"}
            </a>
            <span class="contact-sep">•</span>
            <a href={profile.social?.github || "https://github.com/nhatnguyen"} target="_blank" rel="noopener noreferrer" class="contact-item contact-link" id="cv-github">
              {profile.social?.github ? profile.social.github.replace(/^https?:\/\//, '') : 'github.com/nhatnguyen'}
            </a>
            <span class="contact-sep">•</span>
            <a href={profile.social?.linkedin || "https://linkedin.com/in/nhatnguyen-vo"} target="_blank" rel="noopener noreferrer" class="contact-item contact-link" id="cv-linkedin">
              {profile.social?.linkedin ? profile.social.linkedin.replace(/^https?:\/\//, '') : 'linkedin.com/in/nhatnguyen-vo'}
            </a>
            <span class="contact-sep">•</span>
            <span class="contact-item" id="cv-citizenship">
              {profile.citizenship || "United States"}
            </span>
          </div>
        </div>
      </div>

      <div class="cv-divider"></div>
    </header>

    {/* WORD-STYLE RICH DOCUMENT SECTION (Renders formatted HTML from Word Editor if provided) */}
    <div
      class="cv-rich-word-section"
      id="cv-rich-word-section"
      style={profile.cvDocumentHtml && profile.cvDocumentHtml.trim() ? 'display: block;' : 'display: none;'}
    >
      <div class="word-section-header no-print">
        <div class="word-doc-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
          <span>WORD DOCUMENT EXECUTIVE DOSSIER</span>
        </div>
      </div>
      <div class="word-rich-canvas" id="cv-word-rich-canvas" set:html={profile.cvDocumentHtml || ''}></div>
      <div class="cv-section-divider"></div>
    </div>

    {/* SECTION 2: EDUCATION */}
    <section class="cv-section" id="cv-section-education" aria-labelledby="heading-education">
      <h2 class="cv-section-title" id="heading-education">EDUCATION</h2>
      <div class="cv-entries-list" id="cv-education-list">
        {education.map((edu) => (
          <div class="cv-entry edu-entry" data-id={edu.id}>
            <div class="cv-entry-row">
              <span class="cv-entry-org">{edu.institution}</span>
              <span class="cv-entry-right cv-entry-location">{edu.location}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">{edu.degree}</span>
              <span class="cv-entry-right cv-entry-date">{edu.period}</span>
            </div>
            
            {edu.thesis && (
              <div class="cv-entry-detail">
                <span class="detail-label">Dissertation/Thesis:</span> <em set:html={`"${edu.thesis}"`}></em>
                {edu.advisor && <span class="detail-advisor" set:html={` (Advisor: ${edu.advisor})`}></span>}
              </div>
            )}
            
            {edu.honors && (
              <div class="cv-entry-detail">
                <span class="detail-label">Honors:</span> <span set:html={edu.honors}></span>
                {edu.gpa && <span class="detail-gpa"> • Cumulative G.P.A.: {edu.gpa}</span>}
              </div>
            )}

            {edu.relevantCourses && edu.relevantCourses.length > 0 && (
              <div class="cv-entry-detail courses-detail">
                <span class="detail-label">Selected Coursework:</span> {edu.relevantCourses.join(" • ")}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* SECTION 3: PROFESSIONAL APPOINTMENTS & FLIGHT SOFTWARE EXPERIENCE */}
    <section class="cv-section" id="cv-section-experience" aria-labelledby="heading-experience">
      <h2 class="cv-section-title" id="heading-experience">PROFESSIONAL APPOINTMENTS & FLIGHT SOFTWARE EXPERIENCE</h2>
      <div class="cv-entries-list" id="cv-experience-list">
        {experience.map((exp) => (
          <div class="cv-entry exp-entry" data-id={exp.id}>
            <div class="cv-entry-row">
              <span class="cv-entry-org">{exp.organization}</span>
              <span class="cv-entry-right cv-entry-location">{exp.location}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">
                {exp.role} {exp.department ? `(${exp.department})` : ''}
              </span>
              <span class="cv-entry-right cv-entry-date">{exp.period}</span>
            </div>

            {exp.summary && (
              <p class="cv-entry-summary" set:html={exp.summary}></p>
            )}

            {exp.highlights && exp.highlights.length > 0 && (
              <ul class="cv-bullet-list">
                {exp.highlights.map((highlight) => (
                  <li class="cv-bullet-item" set:html={highlight}></li>
                ))}
              </ul>
            )}

            {exp.tags && exp.tags.length > 0 && (
              <div class="cv-entry-tags no-print">
                <span class="tags-label">Systems:</span>
                {exp.tags.map((t) => (
                  <span class="cv-mini-pill">{t}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* SECTION 4: FLIGHT HERITAGE & SPACE MISSIONS */}
    <section class="cv-section" id="cv-section-missions" aria-labelledby="heading-missions">
      <h2 class="cv-section-title" id="heading-missions">FLIGHT HERITAGE & SPACE MISSIONS</h2>
      <div class="cv-entries-list" id="cv-missions-list">
        {missions.map((m) => (
          <div class="cv-entry mission-entry" data-id={m.id}>
            <div class="cv-entry-row">
              <span class="cv-entry-org">
                {m.name} <span class="mission-code">[{m.codeName}]</span>
              </span>
              <span class="cv-entry-right cv-entry-date">{m.launchDate}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">
                Role: {m.role} • Vehicle: {m.launchVehicle} • Orbit: {m.orbit}
              </span>
              <span class="cv-entry-right status-badge-inline">{m.status}</span>
            </div>

            <p class="cv-entry-summary" set:html={m.missionHighlights}></p>

            {m.subsystems && m.subsystems.length > 0 && (
              <div class="cv-entry-detail">
                <span class="detail-label">Flight Subsystems Owned:</span> {m.subsystems.join(" • ")}
              </div>
            )}

            {m.metrics && m.metrics.length > 0 && (
              <div class="cv-entry-metrics">
                {m.metrics.map((met) => (
                  <span class="cv-metric-chip">
                    <strong>{met.label}:</strong> {met.value}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* SECTION 5: PUBLICATIONS & CONFERENCE PROCEEDINGS */}
    <section class="cv-section" id="cv-section-publications" aria-labelledby="heading-publications">
      <h2 class="cv-section-title" id="heading-publications">PUBLICATIONS & PEER-REVIEWED PROCEEDINGS</h2>
      <div class="cv-entries-list" id="cv-publications-list">
        {publications.map((pub, idx) => (
          <div class="cv-entry pub-entry" data-id={pub.id}>
            <div class="pub-citation">
              <span class="pub-index">[{idx + 1}]</span>
              <span class="pub-authors">{pub.authors}</span>
              <span class="pub-year">({pub.year}).</span>
              <span class="pub-title">"{pub.title}."</span>
              <span class="pub-venue"><em>{pub.venue}</em>.</span>
              {pub.doi && (
                <a href={pub.url || `https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="pub-doi contact-link">
                  DOI: {pub.doi}
                </a>
              )}
            </div>
            {pub.abstract && (
              <p class="pub-abstract no-print-optional" set:html={pub.abstract}></p>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* SECTION 6: HONORS, GRANTS & DISTINCTIONS */}
    <section class="cv-section" id="cv-section-achievements" aria-labelledby="heading-achievements">
      <h2 class="cv-section-title" id="heading-achievements">HONORS, GRANTS & DISTINCTIONS</h2>
      <div class="cv-entries-list" id="cv-achievements-list">
        {achievements.map((ach) => (
          <div class="cv-entry ach-entry" data-id={ach.id}>
            <div class="cv-entry-row">
              <span class="cv-entry-org">{ach.title}</span>
              <span class="cv-entry-right cv-entry-date">{ach.date || ach.timeline}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">
                {ach.organization} {ach.metrics ? `• [${ach.metrics}]` : ''}
              </span>
              <span class="cv-entry-right ach-category-tag">{ach.category}</span>
            </div>
            {ach.description && (
              <p class="cv-entry-summary" set:html={ach.description}></p>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* SECTION 7: TECHNICAL SKILLS & FLIGHT STANDARDS */}
    <section class="cv-section" id="cv-section-skills" aria-labelledby="heading-skills">
      <h2 class="cv-section-title" id="heading-skills">TECHNICAL SKILLS & FLIGHT STANDARDS</h2>
      <div class="cv-skills-grid" id="cv-skills-list">
        {skills.map((cat) => (
          <div class="cv-skill-group">
            <span class="skill-category-name">{cat.category}:</span>
            <span class="skill-tags-string">
              {cat.items ? cat.items.map((i: any) => i.name).join(", ") : (cat.tags ? cat.tags.join(", ") : "")}
            </span>
            {cat.summary && <div class="skill-group-summary" set:html={cat.summary}></div>}
          </div>
        ))}
      </div>
    </section>

    {/* Authentic Harvard CV Sign-off Footer */}
    <footer class="cv-sheet-footer">
      <div class="footer-signoff">
        <span>Curriculum Vitae • {profile.name} • Space Systems & Flight Software Engineering</span>
        <span class="footer-date">Verified Academic Record • Monospace Flight Dossier • {new Date().getFullYear()}</span>
      </div>
    </footer>
  </article>
</div>

<script>
  import { getCVData, subscribe } from '../scripts/store.js';

  function setupHarvardCV() {
    const root = document.getElementById('harvard-cv-root');
    const sheet = document.getElementById('harvard-document-sheet');
    const printBtn = document.getElementById('cv-print-btn');
    const paperBtn = document.getElementById('theme-paper-btn');
    const darkBtn = document.getElementById('theme-dark-btn');
    const syncPill = document.getElementById('cv-sync-pill');
    const avatarEditBtn = document.getElementById('cv-avatar-edit-trigger');
    const wordEditBtn = document.getElementById('btn-open-word-editor');

    if (!root || !sheet) return;

    // 1. Theme toggle handlers
    function setTheme(mode: 'paper' | 'dark') {
      root?.setAttribute('data-theme', mode);
      if (mode === 'paper') {
        paperBtn?.classList.add('active');
        paperBtn?.setAttribute('aria-pressed', 'true');
        darkBtn?.classList.remove('active');
        darkBtn?.setAttribute('aria-pressed', 'false');
      } else {
        darkBtn?.classList.add('active');
        darkBtn?.setAttribute('aria-pressed', 'true');
        paperBtn?.classList.remove('active');
        paperBtn?.setAttribute('aria-pressed', 'false');
      }
    }

    paperBtn?.addEventListener('click', () => setTheme('paper'));
    darkBtn?.addEventListener('click', () => setTheme('dark'));

    // 2. 1-Click Print / Save PDF Handler
    printBtn?.addEventListener('click', () => {
      window.print();
    });

    // 3. Avatar customization & Word editor click handlers
    avatarEditBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'profile' } }));
      window.dispatchEvent(new CustomEvent('open-admin-login'));
    });

    wordEditBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'cv' } }));
      window.dispatchEvent(new CustomEvent('open-admin-login'));
    });

    // 4. Reactive Store Synchronization
    function updateDOMFromStore(cvData: any) {
      if (!cvData) return;

      // Update Profile Header & Avatar
      const profile = cvData.profile || {};
      const nameEl = document.getElementById('cv-name');
      if (nameEl && profile.name) {
        nameEl.innerHTML = `${profile.name} <span class="cv-alt-name">(${profile.englishName || 'Nhat Nguyen Vo'})</span>`;
      }

      const crewBadge = document.querySelector('.cv-crew-badge');
      if (crewBadge) {
        crewBadge.textContent = `CREW: ${profile.monogram || 'NN'} // ${profile.callsign || 'NHAT-NGUYEN'}`;
      }

      const monogramEl = document.getElementById('cv-avatar-monogram');
      if (monogramEl && profile.monogram) {
        monogramEl.textContent = profile.monogram;
      }

      const callsignEl = document.querySelector('.cv-callsign-tag span');
      if (callsignEl && profile.callsign) {
        callsignEl.textContent = `CALLSIGN: ${profile.callsign}`;
      }

      const titleEl = document.getElementById('cv-title');
      if (titleEl && profile.title) titleEl.textContent = profile.title;

      // Update Profile Avatar
      const avatarImg = document.getElementById('cv-avatar-img') as HTMLImageElement;
      if (avatarImg && profile.avatar) {
        avatarImg.src = profile.avatar;
      }

      // Update Word-style Rich Document Canvas
      const wordCanvas = document.getElementById('cv-word-rich-canvas');
      const wordSection = document.getElementById('cv-rich-word-section');
      if (wordCanvas && wordSection) {
        if (profile.cvDocumentHtml && profile.cvDocumentHtml.trim()) {
          wordCanvas.innerHTML = profile.cvDocumentHtml;
          wordSection.style.display = 'block';
        } else {
          wordSection.style.display = 'none';
        }
      }

      const affilEl = document.getElementById('cv-affiliations');
      if (affilEl) {
        affilEl.innerHTML = `
          <span class="affil-item">${profile.academicAffiliation || "Caltech Space Radiation Lab • AIAA Associate Fellow"}</span>
          <span class="affil-sep">•</span>
          <span class="affil-clearance">${profile.clearance || "Public Trust / NASA Heritage Clearance"}</span>
        `;
      }

      const emailEl = document.getElementById('cv-email');
      if (emailEl && profile.social?.email) {
        emailEl.textContent = profile.social.email;
        emailEl.setAttribute('href', `mailto:${profile.social.email}`);
      }

      const githubEl = document.getElementById('cv-github');
      if (githubEl && profile.social?.github) {
        githubEl.textContent = profile.social.github.replace(/^https?:\/\//, '');
        githubEl.setAttribute('href', profile.social.github);
      }

      const linkedinEl = document.getElementById('cv-linkedin');
      if (linkedinEl && profile.social?.linkedin) {
        linkedinEl.textContent = profile.social.linkedin.replace(/^https?:\/\//, '');
        linkedinEl.setAttribute('href', profile.social.linkedin);
      }

      const citizenshipEl = document.getElementById('cv-citizenship');
      if (citizenshipEl && profile.citizenship) {
        citizenshipEl.textContent = profile.citizenship;
      }

      const signoffEl = document.querySelector('.footer-signoff span:first-child');
      if (signoffEl && profile.name) {
        signoffEl.textContent = `Curriculum Vitae • ${profile.name} (${profile.englishName || 'Nhat Nguyen Vo'}) • Space Systems & Flight Software Engineering`;
      }

      const locationEl = document.getElementById('cv-location');
      if (locationEl && profile.location) locationEl.textContent = profile.location;

      // Update Education Section
      const eduListEl = document.getElementById('cv-education-list');
      if (eduListEl && Array.isArray(cvData.education)) {
        eduListEl.innerHTML = cvData.education.map((edu: any) => `
          <div class="cv-entry edu-entry" data-id="${edu.id || ''}">
            <div class="cv-entry-row">
              <span class="cv-entry-org">${edu.institution || ''}</span>
              <span class="cv-entry-right cv-entry-location">${edu.location || ''}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">${edu.degree || ''}</span>
              <span class="cv-entry-right cv-entry-date">${edu.period || ''}</span>
            </div>
            ${edu.thesis ? `
              <div class="cv-entry-detail">
                <span class="detail-label">Dissertation/Thesis:</span> <em>"${edu.thesis}"</em>
                ${edu.advisor ? `<span class="detail-advisor"> (Advisor: ${edu.advisor})</span>` : ''}
              </div>
            ` : ''}
            ${edu.honors ? `
              <div class="cv-entry-detail">
                <span class="detail-label">Honors:</span> ${edu.honors}
                ${edu.gpa ? `<span class="detail-gpa"> • Cumulative G.P.A.: ${edu.gpa}</span>` : ''}
              </div>
            ` : ''}
            ${edu.relevantCourses && edu.relevantCourses.length > 0 ? `
              <div class="cv-entry-detail courses-detail">
                <span class="detail-label">Selected Coursework:</span> ${edu.relevantCourses.join(' • ')}
              </div>
            ` : ''}
          </div>
        `).join('');
      }

      // Update Experience Section (Preserves rich formatting from Word editor)
      const expListEl = document.getElementById('cv-experience-list');
      if (expListEl && Array.isArray(cvData.experience)) {
        expListEl.innerHTML = cvData.experience.map((exp: any) => `
          <div class="cv-entry exp-entry" data-id="${exp.id || ''}">
            <div class="cv-entry-row">
              <span class="cv-entry-org">${exp.organization || ''}</span>
              <span class="cv-entry-right cv-entry-location">${exp.location || ''}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">
                ${exp.role || ''} ${exp.department ? `(${exp.department})` : ''}
              </span>
              <span class="cv-entry-right cv-entry-date">${exp.period || ''}</span>
            </div>
            ${exp.summary ? `<p class="cv-entry-summary">${exp.summary}</p>` : ''}
            ${exp.highlights && exp.highlights.length > 0 ? `
              <ul class="cv-bullet-list">
                ${exp.highlights.map((h: string) => `<li class="cv-bullet-item">${h}</li>`).join('')}
              </ul>
            ` : ''}
          </div>
        `).join('');
      }

      // Update Missions Section
      const misListEl = document.getElementById('cv-missions-list');
      if (misListEl && Array.isArray(cvData.missions)) {
        misListEl.innerHTML = cvData.missions.map((m: any) => `
          <div class="cv-entry mission-entry" data-id="${m.id || ''}">
            <div class="cv-entry-row">
              <span class="cv-entry-org">
                ${m.name || ''} <span class="mission-code">[${m.codeName || ''}]</span>
              </span>
              <span class="cv-entry-right cv-entry-date">${m.launchDate || ''}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">
                Role: ${m.role || ''} • Vehicle: ${m.launchVehicle || ''} • Orbit: ${m.orbit || ''}
              </span>
              <span class="cv-entry-right status-badge-inline">${m.status || ''}</span>
            </div>
            <p class="cv-entry-summary">${m.missionHighlights || ''}</p>
            ${m.subsystems && m.subsystems.length > 0 ? `
              <div class="cv-entry-detail">
                <span class="detail-label">Flight Subsystems Owned:</span> ${m.subsystems.join(' • ')}
              </div>
            ` : ''}
          </div>
        `).join('');
      }

      // Update Achievements Section
      const achListEl = document.getElementById('cv-achievements-list');
      if (achListEl && Array.isArray(cvData.achievements)) {
        achListEl.innerHTML = cvData.achievements.map((ach: any) => `
          <div class="cv-entry ach-entry" data-id="${ach.id || ''}">
            <div class="cv-entry-row">
              <span class="cv-entry-org">${ach.title || ''}</span>
              <span class="cv-entry-right cv-entry-date">${ach.date || ach.timeline || ''}</span>
            </div>
            <div class="cv-entry-row sub-row">
              <span class="cv-entry-role italic">
                ${ach.organization || ''} ${ach.metrics ? `• [${ach.metrics}]` : ''}
              </span>
              <span class="cv-entry-right ach-category-tag">${ach.category || ''}</span>
            </div>
            ${ach.description ? `<p class="cv-entry-summary">${ach.description}</p>` : ''}
          </div>
        `).join('');
      }

      // Visual flash indicator on pill
      if (syncPill) {
        syncPill.classList.add('flash-sync');
        setTimeout(() => syncPill.classList.remove('flash-sync'), 1200);
      }
    }

    // Initialize from client store if localStorage contains custom edits
    try {
      const initialStoreData = getCVData();
      if (initialStoreData) {
        updateDOMFromStore(initialStoreData);
      }
    } catch (e) {
      console.warn('Initial store sync skipped:', e);
    }

    // Subscribe to reactive store changes (dispatched by admin operations)
    subscribe((latestData: any) => {
      updateDOMFromStore(latestData);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHarvardCV);
  } else {
    setupHarvardCV();
  }
</script>

