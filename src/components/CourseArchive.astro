---
// Apple-Grade Academic & Teaching Dossier / Course Archive Component
import portfolioData from '../data/portfolio.json';

export interface Course {
  id?: string;
  code: string;
  title: string;
  semester: string;
  institution: string;
  description: string;
  instructorEmail?: string;
  githubUrl: string;
  tags: string[];
  updatedAt?: string;
}

export interface Props {
  courses?: Course[];
}

const defaultCourses: Course[] = (portfolioData as any).courses || [
  {
    id: "course-aer-402",
    code: "AER 402",
    title: "Orbital Mechanics & Astrodynamics",
    semester: "Fall 2025",
    institution: "Caltech / Aero Department",
    description: "Keplerian orbits, Lambert's problem, perturbation analysis, continuous-thrust trajectory optimization, and orbital rendezvous maneuvers.",
    instructorEmail: "nhatnguyen@orbital-flight.dev",
    githubUrl: "https://github.com/grezil/orbital-mechanics-lectures",
    tags: ["Astrodynamics", "Trajectory Design", "MATLAB", "SPICE"],
    updatedAt: "2025-11-20"
  },
  {
    id: "course-cs-520",
    code: "CS 520",
    title: "Deterministic Flight Software & RTOS",
    semester: "Spring 2025",
    institution: "MIT Space Systems Laboratory",
    description: "Real-time task scheduling, cyclic executives, fault detection, isolation and recovery (FDIR), CCSDS telemetry decommutation, and bare-metal Rust/C systems.",
    instructorEmail: "nhatnguyen@orbital-flight.dev",
    githubUrl: "https://github.com/grezil/flight-software-curriculum",
    tags: ["Embedded Systems", "FreeRTOS", "Rust", "DO-178C"],
    updatedAt: "2025-10-15"
  },
  {
    id: "course-cubesat-101",
    code: "ENG 310",
    title: "CubeSat Avionics & Flight Qualification",
    semester: "Fall 2024",
    institution: "Space Systems Academy",
    description: "CubeSat bus architectures, power budget analysis, thermal-vacuum testing protocols, solar array deployment, and ground station operations.",
    instructorEmail: "nhatnguyen@orbital-flight.dev",
    githubUrl: "https://github.com/grezil/cubesat-avionics-lab",
    tags: ["Avionics", "CubeSats", "Telemetry", "Hardware-in-the-Loop"],
    updatedAt: "2024-12-05"
  }
];

const { courses = defaultCourses } = Astro.props;

// Collect unique tags for filter chips
const allTags = Array.from(new Set(courses.flatMap(c => c.tags || []))).slice(0, 8);
---

<section id="courses" class="course-archive-section section" aria-label="Academic and Teaching Dossier">
  <div class="container">
    <!-- Header -->
    <header class="section-header">
      <div class="section-tag-apple">ACADEMIC & TEACHING DOSSIER</div>
      <h2 class="section-title">
        Curriculum, Syllabi & <span class="glow-text">Course Materials</span>
      </h2>
      <p class="section-subtitle">
        Curated syllabus, lecture modules, lab repositories, and course materials. Files and source materials are directly mirrored on GitHub to conserve server telemetry bandwidth.
      </p>
    </header>

    <!-- Search & Filter Controls -->
    <div class="course-controls-wrapper">
      <div class="course-search-bar">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="search" 
          id="course-search-input" 
          class="course-search-input" 
          placeholder="Filter courses by code, title, topic or institution (e.g. AER 402, Rust, Caltech)..." 
          aria-label="Filter course archives"
        />
        <button type="button" id="course-search-clear" class="btn-search-clear" aria-label="Clear search query" style="display: none;">
          ✕
        </button>
      </div>

      <!-- Filter Chips -->
      <div class="course-filter-chips" role="toolbar" aria-label="Course Category Filters" id="course-filter-chips">
        <button type="button" class="chip-filter active" data-filter="all">
          <span>All Dossiers</span>
          <span class="chip-count" id="count-all">{courses.length}</span>
        </button>
        {allTags.map(tag => (
          <button type="button" class="chip-filter" data-filter={tag}>
            <span>{tag}</span>
          </button>
        ))}
      </div>

      <div class="filter-results-status">
        <span id="course-filter-stats" class="status-meta">Showing {courses.length} of {courses.length} courses</span>
      </div>
    </div>

    <!-- Course Cards Grid -->
    <div class="courses-grid" id="courses-grid" data-initial-courses={JSON.stringify(courses)}>
      {courses.map(course => (
        <article class="course-card glass-card" data-course-id={course.id || ''} data-course-code={course.code} data-tags={(course.tags || []).join(',')}>
          <!-- Card Header -->
          <div class="course-header">
            <div class="course-code-group">
              <span class="course-code-badge">{course.code}</span>
              <span class="course-semester-pill">{course.semester}</span>
            </div>
            <div class="course-inst-tag" title={course.institution}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2L2 7h20L12 2z"></path>
              </svg>
              <span>{course.institution}</span>
            </div>
          </div>

          <!-- Course Title -->
          <h3 class="course-title">{course.title}</h3>

          <!-- Course Description -->
          <p class="course-desc">{course.description}</p>

          <!-- Topic Tags -->
          {course.tags && course.tags.length > 0 && (
            <div class="course-tags">
              {course.tags.map(tag => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>
          )}

          <!-- Card Footer & Action Row -->
          <div class="course-footer">
            <!-- Teaching / Contact Email -->
            <div class="course-contact-box">
              <div class="contact-header">
                <span class="instructor-badge">
                  <span class="instructor-dot"></span>
                  Teaching Contact
                </span>
              </div>
              <div class="contact-action-row">
                <a 
                  href={`mailto:${course.instructorEmail || 'nhatnguyen@orbital-flight.dev'}`} 
                  class="contact-email-link"
                  title="Direct instructor email"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                  <span>{course.instructorEmail || 'nhatnguyen@orbital-flight.dev'}</span>
                </a>
                <button 
                  type="button" 
                  class="btn-copy-email" 
                  data-email={course.instructorEmail || 'nhatnguyen@orbital-flight.dev'} 
                  title="Copy instructor email address"
                  aria-label="Copy instructor email"
                >
                  <svg class="icon-copy" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span class="copy-text">Copy</span>
                </button>
              </div>
            </div>

            <!-- Direct GitHub Action -->
            <div class="course-repo-action">
              <a 
                href={course.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-course-github"
                title={`Open ${course.code} files & syllabus on GitHub`}
              >
                <!-- GitHub Octocat Icon -->
                <svg class="octocat-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                <span>View Course Files on GitHub</span>
                <span class="external-arrow">↗</span>
              </a>

              <!-- Zero-Server Storage Pill -->
              <div class="telemetry-pill">
                <span class="telemetry-dot"></span>
                <span>Zero-Server Storage • GitHub Folder Link</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="courses-empty-state" class="courses-empty-state glass-card" style="display: none;">
      <div class="empty-icon">🔍</div>
      <h3 class="empty-title">No Matching Course Dossiers</h3>
      <p class="empty-desc">No curriculum archives match your search criteria. Try a different keyword or reset filters.</p>
      <button type="button" id="btn-reset-course-filters" class="btn-reset-filters">
        Reset All Filters
      </button>
    </div>
  </div>
</section>

<!-- Client Script for Search, Filter, Copy, and Store Reactivity -->
<script>
  // Self-contained client controller for CourseArchive
  function initCourseArchive() {
    const grid = document.getElementById('courses-grid');
    if (!grid) return;

    let coursesData: any[] = [];
    try {
      coursesData = JSON.parse(grid.dataset.initialCourses || '[]');
    } catch (e) {
      coursesData = [];
    }

    const searchInput = document.getElementById('course-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('course-search-clear');
    const emptyState = document.getElementById('courses-empty-state');
    const statusMeta = document.getElementById('course-filter-stats');
    const countAll = document.getElementById('count-all');
    const btnReset = document.getElementById('btn-reset-course-filters');

    let activeFilter = 'all';
    let searchQuery = '';

    // Load reactive courses from window.PortfolioStore or localStorage
    function getStoredCourses(): any[] {
      try {
        if ((window as any).PortfolioStore?.getCourses) {
          const list = (window as any).PortfolioStore.getCourses();
          if (Array.isArray(list)) return list;
        }
        const rawFull = localStorage.getItem('space_portfolio_data_v1');
        if (rawFull) {
          const parsed = JSON.parse(rawFull);
          if (Array.isArray(parsed?.courses)) return parsed.courses;
        }
      } catch (err) {
        console.warn('Error reading courses from store:', err);
      }
      return coursesData;
    }

    // Dynamic Filter Chips updating
    function updateFilterChips() {
      const chipsContainer = document.getElementById('course-filter-chips');
      if (!chipsContainer) return;

      const tagsSet = new Set<string>();
      coursesData.forEach((c: any) => {
        if (Array.isArray(c.tags)) {
          c.tags.forEach((t: string) => {
            if (t && typeof t === 'string' && t.trim()) tagsSet.add(t.trim());
          });
        }
      });
      const uniqueTags = Array.from(tagsSet).slice(0, 10);

      if (activeFilter !== 'all' && !tagsSet.has(activeFilter)) {
        activeFilter = 'all';
      }

      chipsContainer.innerHTML = `
        <button type="button" class="chip-filter ${activeFilter === 'all' ? 'active' : ''}" data-filter="all">
          <span>All Dossiers</span>
          <span class="chip-count" id="count-all">${coursesData.length}</span>
        </button>
        ${uniqueTags.map(tag => `
          <button type="button" class="chip-filter ${activeFilter === tag ? 'active' : ''}" data-filter="${escapeHtml(tag)}">
            <span>${escapeHtml(tag)}</span>
          </button>
        `).join('')}
      `;

      // Re-bind click event to newly created chips
      chipsContainer.querySelectorAll('.chip-filter').forEach(chip => {
        chip.addEventListener('click', () => {
          chipsContainer.querySelectorAll('.chip-filter').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          activeFilter = chip.getAttribute('data-filter') || 'all';
          renderCourseCards(coursesData);
        });
      });
    }

    function renderCourseCards(list: any[]) {
      if (!grid) return;

      const currentCountBadge = document.getElementById('count-all');
      if (currentCountBadge) {
        currentCountBadge.textContent = String(coursesData.length);
      }

      const filtered = list.filter(course => {
        const matchesTag = activeFilter === 'all' || 
          (course.tags || []).some((t: string) => t.toLowerCase() === activeFilter.toLowerCase());

        if (!matchesTag) return false;

        if (!searchQuery) return true;

        const q = searchQuery.toLowerCase();
        const codeMatch = (course.code || '').toLowerCase().includes(q);
        const titleMatch = (course.title || '').toLowerCase().includes(q);
        const instMatch = (course.institution || '').toLowerCase().includes(q);
        const descMatch = (course.description || '').toLowerCase().includes(q);
        const tagMatch = (course.tags || []).some((t: string) => t.toLowerCase().includes(q));

        return codeMatch || titleMatch || instMatch || descMatch || tagMatch;
      });

      if (statusMeta) {
        statusMeta.textContent = `Showing ${filtered.length} of ${coursesData.length} courses`;
      }

      if (filtered.length === 0) {
        grid.style.display = 'none';
        if (emptyState) {
          emptyState.style.display = 'block';
          const emptyTitle = emptyState.querySelector('.empty-title');
          const emptyDesc = emptyState.querySelector('.empty-desc');
          const resetBtnEl = document.getElementById('btn-reset-course-filters');

          if (coursesData.length === 0) {
            if (emptyTitle) emptyTitle.textContent = 'Chưa Có Giáo Án Nào Được Lưu Trữ';
            if (emptyDesc) emptyDesc.textContent = 'Hiện tại chưa có giáo án, bài giảng hoặc tệp tin nào. Bạn có thể thêm giáo án mới trong bảng điều khiển Admin!';
            if (resetBtnEl) (resetBtnEl as HTMLElement).style.display = 'none';
          } else {
            if (emptyTitle) emptyTitle.textContent = 'No Matching Course Dossiers';
            if (emptyDesc) emptyDesc.textContent = 'No curriculum archives match your search criteria. Try a different keyword or reset filters.';
            if (resetBtnEl) (resetBtnEl as HTMLElement).style.display = 'inline-block';
          }
        }
        return;
      }

      grid.style.display = 'grid';
      if (emptyState) emptyState.style.display = 'none';

      grid.innerHTML = filtered.map(course => {
        const email = course.instructorEmail || 'nhatnguyen@orbital-flight.dev';
        const tags = Array.isArray(course.tags) ? course.tags : [];
        return `
          <article class="course-card glass-card" data-course-id="${escapeHtml(course.id || '')}" data-course-code="${escapeHtml(course.code || '')}" data-tags="${escapeHtml(tags.join(','))}">
            <div class="course-header">
              <div class="course-code-group">
                <span class="course-code-badge">${escapeHtml(course.code || '')}</span>
                <span class="course-semester-pill">${escapeHtml(course.semester || '')}</span>
              </div>
              <div class="course-inst-tag" title="${escapeHtml(course.institution || '')}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 2L2 7h20L12 2z"></path>
                </svg>
                <span>${escapeHtml(course.institution || '')}</span>
              </div>
            </div>

            <h3 class="course-title">${escapeHtml(course.title || '')}</h3>
            <p class="course-desc">${escapeHtml(course.description || '')}</p>

            ${tags.length > 0 ? `
              <div class="course-tags">
                ${tags.map((t: string) => `<span class="tag-pill">#${escapeHtml(t)}</span>`).join('')}
              </div>
            ` : ''}

            <div class="course-footer">
              <div class="course-contact-box">
                <div class="contact-header">
                  <span class="instructor-badge">
                    <span class="instructor-dot"></span>
                    Teaching Contact
                  </span>
                </div>
                <div class="contact-action-row">
                  <a href="mailto:${escapeHtml(email)}" class="contact-email-link" title="Direct instructor email">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                    <span>${escapeHtml(email)}</span>
                  </a>
                  <button type="button" class="btn-copy-email" data-email="${escapeHtml(email)}" title="Copy instructor email address" aria-label="Copy instructor email">
                    <svg class="icon-copy" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span class="copy-text">Copy</span>
                  </button>
                </div>
              </div>

              <div class="course-repo-action">
                <a href="${escapeHtml(course.githubUrl || '#')}" target="_blank" rel="noopener noreferrer" class="btn-course-github" title="Open ${escapeHtml(course.code)} files & syllabus on GitHub">
                  <svg class="octocat-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>View Course Files on GitHub</span>
                  <span class="external-arrow">↗</span>
                </a>

                <div class="telemetry-pill">
                  <span class="telemetry-dot"></span>
                  <span>Zero-Server Storage • GitHub Folder Link</span>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join('');

      attachCopyHandlers();
    }

    function escapeHtml(str: string): string {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function attachCopyHandlers() {
      const copyBtns = grid?.querySelectorAll('.btn-copy-email') || [];
      copyBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const email = btn.getAttribute('data-email');
          if (!email) return;

          navigator.clipboard.writeText(email).then(() => {
            const textSpan = btn.querySelector('.copy-text');
            const originalText = textSpan ? textSpan.textContent : 'Copy';
            btn.classList.add('copied');
            if (textSpan) textSpan.textContent = 'Copied!';

            setTimeout(() => {
              btn.classList.remove('copied');
              if (textSpan) textSpan.textContent = originalText;
            }, 2000);
          }).catch(err => {
            console.error('Clipboard copy failed:', err);
          });
        });
      });
    }

    // Refresh courses data and sync UI
    function syncCourses() {
      coursesData = getStoredCourses();
      updateFilterChips();
      renderCourseCards(coursesData);
    }

    // Event listeners for search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim();
        if (clearBtn) {
          clearBtn.style.display = searchQuery ? 'inline-flex' : 'none';
        }
        renderCourseCards(coursesData);
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchQuery = '';
          searchInput.focus();
        }
        clearBtn.style.display = 'none';
        renderCourseCards(coursesData);
      });
    }

    if (btnReset) {
      btnReset.addEventListener('click', () => {
        searchQuery = '';
        activeFilter = 'all';
        if (searchInput) {
          searchInput.value = '';
        }
        if (clearBtn) {
          clearBtn.style.display = 'none';
        }
        const chipsContainer = document.getElementById('course-filter-chips');
        chipsContainer?.querySelectorAll('.chip-filter').forEach(c => {
          if (c.getAttribute('data-filter') === 'all') c.classList.add('active');
          else c.classList.remove('active');
        });
        renderCourseCards(coursesData);
      });
    }

    // Live reactive sync across components and events
    syncCourses();
    window.addEventListener('portfolio-data-updated', syncCourses);
    window.addEventListener('storage', (e) => {
      if (e.key === 'space_portfolio_data_v1') {
        syncCourses();
      }
    });

    // Initial attach
    attachCopyHandlers();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCourseArchive);
  } else {
    initCourseArchive();
  }
  document.addEventListener('astro:page-load', initCourseArchive);
</script>

<style>
  .course-archive-section {
    padding: 3.5rem 0 4.5rem;
    position: relative;
  }

  /* Header Tags & Subtitle are inherited from space-apple.css */

  /* Controls: Search Bar & Chips */
  .course-controls-wrapper {
    margin-top: 2rem;
    margin-bottom: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .course-search-bar {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 680px;
    width: 100%;
    margin: 0 auto;
    background: rgba(18, 22, 32, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0.5rem 1rem 0.5rem 1.25rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .course-search-bar:focus-within {
    border-color: rgba(229, 169, 106, 0.45);
    background: rgba(22, 27, 40, 0.9);
    box-shadow: 0 0 20px rgba(229, 169, 106, 0.15);
  }

  .search-icon {
    color: #8E95A5;
    flex-shrink: 0;
