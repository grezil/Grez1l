---
// AdminDock.astro - Apple-style floating Control Center Dock when logged in as admin
---

<div id="admin-floating-dock" class="admin-dock-container admin-left-dock no-print" aria-label="Admin Control Dock" style="display: none;">
  <div class="dock-pill">
    <!-- Active Status Beacon -->
    <div class="dock-item status-indicator" title="Admin Mode Active (Read/Write Telemetry)">
      <span class="beacon-pulse">
        <span class="beacon-dot"></span>
        <span class="beacon-wave"></span>
      </span>
      <span class="status-text">ADMIN</span>
    </div>

    <div class="dock-divider"></div>

    <!-- Quick Action 1: Edit CV -->
    <button type="button" class="dock-btn" id="dock-action-cv" data-tooltip="Edit My CV Sections">
      <div class="dock-icon-wrapper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          <line x1="9" y1="7" x2="15" y2="7"></line>
          <line x1="9" y1="11" x2="13" y2="11"></line>
        </svg>
      </div>
      <span class="dock-label">Edit CV</span>
    </button>

    <!-- Quick Action 2: Add Achievement -->
    <button type="button" class="dock-btn" id="dock-action-achievement" data-tooltip="Add Achievement & Timeline">
      <div class="dock-icon-wrapper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="7"></circle>
          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
          <line x1="12" y1="6" x2="12" y2="10"></line>
          <line x1="10" y1="8" x2="14" y2="8"></line>
        </svg>
      </div>
      <span class="dock-label">+ Award</span>
    </button>

    <!-- Quick Action 3: Compose Blog Post -->
    <button type="button" class="dock-btn" id="dock-action-blog" data-tooltip="Compose Technical Article">
      <div class="dock-icon-wrapper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
      </div>
      <span class="dock-label">Write Blog</span>
    </button>

    <!-- Quick Action 4: Export / Backup Data -->
    <button type="button" class="dock-btn" id="dock-action-backup" data-tooltip="Backup & Restore Data">
      <div class="dock-icon-wrapper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </div>
      <span class="dock-label">Backup</span>
    </button>

    <!-- Quick Action 5: Dedicated Admin Console -->
    <a href="/admin" class="dock-btn" id="dock-action-admin-page" data-tooltip="Full Mission Control Console">
      <div class="dock-icon-wrapper">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
          <line x1="8" y1="21" x2="16" y2="21"></line>
          <line x1="12" y1="17" x2="12" y2="21"></line>
        </svg>
      </div>
      <span class="dock-label">Console</span>
    </a>

    <div class="dock-divider"></div>

    <!-- Logout Action -->
    <button type="button" class="dock-btn dock-btn-danger" id="dock-action-logout" data-tooltip="Lock & End Admin Session">
      <div class="dock-icon-wrapper icon-danger">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </div>
      <span class="dock-label">Lock</span>
    </button>
  </div>
</div>

<!-- Admin Toast Notification System -->
<div id="admin-toast-container" class="admin-toast-container" aria-live="polite"></div>

<style>
  .admin-dock-container {
    position: fixed;
    top: 50%;
    left: 1.25rem;
    transform: translateY(-50%);
    z-index: 9000;
    pointer-events: auto;
    font-family: 'SF Mono', 'JetBrains Mono', 'Fira Code', Menlo, Monaco, Consolas, monospace !important;
    animation: dockFloatInLeft 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes dockFloatInLeft {
    from {
      opacity: 0;
      transform: translateY(-50%) translateX(-24px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }

  .dock-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.65rem 0.45rem;
    background: rgba(14, 18, 27, 0.92);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    box-shadow: 
      0 12px 36px -4px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(229, 169, 106, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .status-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.45rem 0.35rem;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    user-select: none;
  }

  .beacon-pulse {
    position: relative;
    width: 8px;
    height: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .beacon-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 8px #10B981;
  }

  .beacon-wave {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid #10B981;
    opacity: 0.75;
    animation: beaconPulse 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beaconPulse {
    0% {
      transform: scale(0.8);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .status-text {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #6EE7B7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .dock-divider {
    width: 22px;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin: 0.15rem 0;
  }

  .dock-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.18rem;
    padding: 0.4rem 0.45rem;
    width: 48px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    color: #C8CFDB;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dock-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .dock-btn:active {
    transform: translateX(0) scale(0.95);
  }

  .dock-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: #E5A96A;
    transition: transform 0.2s ease;
  }

  .dock-btn:hover .dock-icon-wrapper {
    transform: scale(1.12);
  }

  .dock-btn-danger .icon-danger {
    color: #F87171;
  }

  .dock-label {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #9CA3AF;
    transition: color 0.2s;
    text-align: center;
    line-height: 1.1;
  }

  .dock-btn:hover .dock-label {
    color: #E5E7EB;
  }

  /* Tooltip on the RIGHT side for left-dock */
  .dock-btn[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    left: calc(100% + 12px);
    top: 50%;
    bottom: auto;
    transform: translateY(-50%) translateX(-4px);
    background: rgba(15, 18, 26, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #F3F4F6;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.72rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
    z-index: 9999;
  }

  .dock-btn[data-tooltip]:hover::after {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  /* Toast notification styles */
  .admin-toast-container {
    position: fixed;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10000;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  :global(.admin-toast) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background: rgba(14, 18, 27, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(229, 169, 106, 0.3);
    border-radius: 9999px;
    color: #F3F4F6;
    font-size: 0.82rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: auto;
  }

  :global(.admin-toast.toast-success) {
    border-color: rgba(16, 185, 129, 0.4);
    color: #E6FFFA;
  }

  :global(.admin-toast.toast-info) {
    border-color: rgba(56, 189, 248, 0.4);
    color: #F0F9FF;
  }

  @keyframes toastIn {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 640px) {
    .admin-dock-container {
      left: 0.4rem;
    }
    .dock-pill {
      padding: 0.45rem 0.25rem;
      gap: 0.2rem;
    }
    .dock-btn {
      width: 40px;
      padding: 0.35rem 0.2rem;
    }
    .dock-label {
      display: none;
    }
    .status-text {
      display: none;
    }
    .status-indicator {
      padding: 0.35rem;
    }
  }
</style>

<script>
  function setupAdminDock() {
    const dock = document.getElementById('admin-floating-dock');
    if (!dock) return;

    // Check admin authentication state
    async function isAuth() {
      try {
        let storeModule = null;
        try {
          storeModule = await import('../scripts/store.js');
        } catch (e) {}

        if (storeModule && typeof storeModule.checkAdminAuth === 'function') {
          return storeModule.checkAdminAuth();
        }
      } catch (err) {}

      // ponytail: fallback direct session verification
      try {
        const raw = localStorage.getItem('space_portfolio_admin_session_v2');
        if (!raw) return false;
        const s = JSON.parse(raw);
        return Boolean(s && s.user === 'admin' && s.authenticated === true);
      } catch (e) {
        return false;
      }
    }

    async function syncDockVisibility() {
      const authenticated = await isAuth();
      if (authenticated) {
        dock.style.display = 'block';
      } else {
        dock.style.display = 'none';
      }
    }

    // Initial check
    syncDockVisibility();

    // Listen for auth changes
    window.addEventListener('portfolio-admin-auth-changed', () => {
      syncDockVisibility();
    });

    // Toast notification handler
    window.addEventListener('portfolio-admin-toast', (e: any) => {
      const detail = e.detail || {};
      showToast(detail.message || 'Action completed', detail.type || 'success');
    });

    function showToast(message: string, type = 'success') {
      const container = document.getElementById('admin-toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `admin-toast toast-${type}`;
      toast.innerHTML = `
        <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background-color:${type === 'success' ? '#10B981' : '#38BDF8'};"></span>
        <span>${message}</span>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.transition = 'opacity 0.25s, transform 0.25s';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        setTimeout(() => toast.remove(), 250);
      }, 3200);
    }

    // Action: Edit CV
    document.getElementById('dock-action-cv')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'cv' } }));
    });

    // Action: Add Achievement
    document.getElementById('dock-action-achievement')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'achievement' } }));
    });

    // Action: Compose Blog Post
    document.getElementById('dock-action-blog')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'blog' } }));
    });

    // Action: Backup Data
    document.getElementById('dock-action-backup')?.addEventListener('click', async () => {
      window.dispatchEvent(new CustomEvent('open-admin-editor', { detail: { tab: 'backup' } }));
    });

    // Action: Logout
    document.getElementById('dock-action-logout')?.addEventListener('click', async () => {
      try {
        let storeModule = null;
        try {
          storeModule = await import('../scripts/store.js');
        } catch (e) {}

        if (storeModule && typeof storeModule.logoutAdmin === 'function') {
          storeModule.logoutAdmin();
        }
      } catch (err) {}

      localStorage.removeItem('space_portfolio_admin_session_v2');
      localStorage.removeItem('space_portfolio_admin_auth');
      localStorage.removeItem('astro_admin_auth');
      localStorage.removeItem('portfolio_admin_authenticated');
      localStorage.removeItem('astro_portfolio_auth');
      window.dispatchEvent(new CustomEvent('portfolio-admin-auth-changed', { detail: { authenticated: false } }));
      window.dispatchEvent(new CustomEvent('portfolio-data-updated'));
      showToast('Admin session terminated. Mission Deck locked.', 'info');

      if (window.location.pathname.includes('/admin')) {
        window.location.reload();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAdminDock);
  } else {
    setupAdminDock();
  }
  document.addEventListener('astro:page-load', setupAdminDock);
</script>
